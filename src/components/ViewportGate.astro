---
/**
 * Blocks the site below the design's usable-width floor. The layout isn't
 * responsive yet, so rather than ship a broken composition under 900px this
 * covers it entirely and points the visitor at the one thing worth having
 * on a small screen: the resume.
 *
 * Zero JS, on purpose — see the CSS in components.css. A fixed, high-z-index
 * panel shown by a bare media query tracks the viewport for free on resize
 * and needs no re-init across a `<ClientRouter/>` soft nav or a hard load,
 * unlike anything that has to requery the DOM per navigation (WaterField
 * itself, nav-tint, etc.).
 */
import WaterField from './ui/WaterField.astro';
import Icon from './ui/Icon.astro';
import { links } from '../data/links';
---

<div class="viewport-gate">
	<WaterField grid={72} />
	<div class="viewport-gate__content">
		<p class="type-heading viewport-gate__message">This website is best viewed on desktop.</p>
		<a
			class="btn btn--primary viewport-gate__cta"
			href={links.resume}
			data-analytics="resume"
			target="_blank"
			rel="noopener noreferrer"
		>
			<span>Download my resume</span>
			<Icon name="external-link" />
		</a>
	</div>
</div>
