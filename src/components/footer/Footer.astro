---
import mascotMark from '../../assets/footer/Tousif&clawd.svg?raw';
import mascotHoverMark from '../../assets/footer/Tousif&clawd-hover.svg?raw';

interface Props {
	/* Which cap to use. The footer is chrome shared by hosts that do not
	   agree on one: index and about run the nav's own --measure-chrome
	   (1000px, same as the nav row), case studies run --measure-page — wide
	   enough to line up with a case study's own content grid, which is why
	   that host still gets its own variant rather than sharing the chrome
	   measure too. On about.astro specifically, --measure-chrome is now
	   narrower than the page's own --measure-content (1240px) body frame —
	   a deliberate, accepted trade-off (see the token's own comment in
	   tokens.css), not a mismatch to fix by widening this back out. */
	measure?: 'chrome' | 'page';
}

const { measure = 'chrome' } = Astro.props;
---

<footer class="site-footer" data-measure={measure}>
	<div class="site-footer__inner">
		<span class="site-footer__brand" role="img" aria-label="Tousif & Clawd">
			<span class="site-footer__brand-mark site-footer__brand-mark--rest" set:html={mascotMark} />
			<span class="site-footer__brand-mark site-footer__brand-mark--hover" set:html={mascotHoverMark} />
		</span>

		<hr class="site-footer__rule" />

		<div class="site-footer__meta">
			{/* The © is text, not a glyph from the icon registry: it is part of
			    the notice, set in the same mono label rung as the nav's links,
			    and read aloud as "copyright". */}
			<p class="type-nav-link site-footer__name">© Tousif Rahaman</p>

			<p class="type-meta site-footer__tagline">Designed <em>solo</em> · Developed <em>together</em></p>
		</div>
	</div>
</footer>

<style>
	/* 75px is a literal, not a token — the spacing scale's nearest rungs
	   (--spacing-7xl 64px, --spacing-8xl 80px) don't land on the requested
	   value, so this is deliberate, same as --secondary being a literal in
	   tokens.css. */
	.site-footer {
		/* `position: relative` (not the default static) promotes this into
		   the same paint step as `.home` on the homepage — the
		   homepage and about page both have a `position: fixed` water-field
		   background with z-index:auto, which paints *after* (on top of)
		   static in-flow content per the CSS stacking spec, regardless of
		   DOM order. Without this the footer lays out correctly but is
		   invisible, hidden under that fixed layer. */
		position: relative;
		/* 75px is a literal, not a token — the spacing scale's nearest rungs
		   (--spacing-7xl 64px, --spacing-8xl 80px) don't land on the
		   requested value, so this is deliberate, same as --secondary being
		   a literal in tokens.css.

		   It is a top-up on the trailing space each host reserves, not the
		   whole gap, so it only reads the same on every page while those
		   agree: about's --spacing-9xl and a case study's reflection padding
		   are both 96px, and so is index's — see the note on `.home`'s
		   padding-block-end in index.astro. */
		margin-block-start: 75px;
	}

	/* Both the cap and the box-sizing are stated outright, because neither
	   can be left to the host: index ships no box-sizing reset while about
	   and CaseStudyLayout do, so an unpinned `max-width` + `padding-inline`
	   pair resolved differently on the homepage than elsewhere. And the
	   hosts disagree about the gutter too — index and about put it *outside*
	   the cap (about's frame carries no padding of its own; the gutter is on
	   its parent), while a case study's Section puts it *inside*
	   --measure-page. Adding the gutter to the cap here is what reproduces
	   the first case under a pinned border-box; --measure-page is used bare
	   for the `page` variant because that convention already counts it in.

	   This default variant no longer tracks a page's own content measure —
	   see --measure-chrome's comment in tokens.css and this file's `measure`
	   prop comment for why index and about intentionally diverge here now. */
	.site-footer__inner {
		box-sizing: border-box;
		max-width: calc(var(--measure-chrome) + 2 * var(--gutter));
		margin-inline: auto;
		padding-inline: var(--gutter);
		padding-block-end: var(--spacing-xl);
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.site-footer[data-measure='page'] .site-footer__inner {
		max-width: var(--measure-page);
	}

	.site-footer__brand {
		position: relative;
		display: block;
		height: 4rem;
		/* Both poses share the same 123×96 viewBox, so one aspect-ratio box
		   sizes them identically and the rest/hover marks can overlap
		   exactly inside it. */
		aspect-ratio: 123 / 96;
		/* Y: the torso rectangle (the sunglasses block), not the leg stubs
		   below it, is what should read as standing on the rule — the legs
		   dangle past it into the space below. In the source viewBox
		   (0 0 123 96) the torso's own bottom edge is at y=78, 18 units above
		   the viewBox's bottom edge; at this render height that's 12px, so
		   the whole mark is nudged down by that much rather than trimming
		   the source file (which would clip the swoosh tail — it dips close
		   to the same bottom edge).
		   X: the mark stands over the tagline, which is set at the row's right
		   end, so the box is aligned to that end and then nudged so its
		   centre sits on the centre of "together" — the last word, and the
		   one the mascot is doing. Measured, not derived: re-measure if the
		   tagline's type or the row's inset changes. */
		align-self: flex-end;
		transform: translate(-6px, 12px);
	}

	/* The pose swap is a crossfade between two drawings of the same figure,
	   and a plain one shows both sets of arms at once halfway through. A
	   touch of blur on whichever pose is on its way out (and not yet in)
	   blends the two into one movement instead. 2px — enough to soften the
	   double exposure, small enough to stay cheap. */
	.site-footer__brand-mark {
		position: absolute;
		inset: 0;
		transition:
			opacity 200ms ease,
			filter 200ms ease;
	}

	.site-footer__brand-mark :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.site-footer__brand-mark--hover {
		opacity: 0;
		filter: blur(var(--spacing-xxs));
	}

	/* Gated to a pointer that can really hover: a tap on touch fakes a hover
	   and would leave the mascot with its arms up until the next tap. */
	@media (hover: hover) and (pointer: fine) {
		.site-footer__brand:hover .site-footer__brand-mark--rest {
			opacity: 0;
			filter: blur(var(--spacing-xxs));
		}

		.site-footer__brand:hover .site-footer__brand-mark--hover {
			opacity: 1;
			filter: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer__brand-mark {
			transition-duration: 0.01ms;
		}
	}

	.site-footer__rule {
		width: 100%;
		height: 0;
		/* No top margin: the mascot's own artwork already runs close to its
		   viewBox's bottom edge, so butting the rule straight up against it
		   reads as the mascot standing on the line, not floating above it. */
		margin: 0 0 var(--spacing-xl);
		border: none;
		border-block-start: 1px solid var(--border);
	}

	/* The row sits --spacing-xl under the rule and --spacing-xl above the
	   footer's bottom edge, and is inset --spacing-xl from the rule's ends,
	   so the text reads as sitting inside the line rather than hanging off
	   its tips. Border-box pinned: the hosts disagree about the reset, and
	   `width: 100%` plus padding would otherwise overhang on the homepage. */
	.site-footer__meta {
		box-sizing: border-box;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3xl);
		padding-inline: var(--spacing-xl);
	}

	/* The copyright line, in the nav links' type (`.type-nav-link` — the
	   12px uppercase mono label), set back behind the tagline: --text at
	   half strength. An opacity rather than a step down the ramp, because it
	   is the line's own colour receding, not a different one.

	   Half is still legible, and measured: over the homepage's ground it
	   leaves the line at 5.2:1, over a case study's --bg at 4.9:1 — both
	   clear of AA for 12px text. Don't take it lower. The about page's water
	   field can brighten the ground behind it past that; the page is parked
	   and unlinked, so this is a note for whoever re-links it. */
	.site-footer__name {
		--footer-name-opacity: 0.5;
		flex-shrink: 0;
		color: var(--text);
		opacity: var(--footer-name-opacity);
		white-space: nowrap;
	}

	.site-footer__tagline {
		color: var(--primary-text);
		text-align: end;
	}

	.site-footer__tagline em {
		font-style: italic;
	}

	/* Narrow: the tagline is dropped and the copyright line stands alone,
	   centred, with the mascot centred over it. The X nudge exists to park
	   the mark over the tagline's last word; with no tagline there is
	   nothing to park it over. The Y nudge stays: the mark still stands on
	   the rule. */
	@media (max-width: 40rem) {
		.site-footer__meta {
			justify-content: center;
		}

		.site-footer__tagline {
			display: none;
		}

		.site-footer__brand {
			align-self: center;
			transform: translate(0, 12px);
		}
	}
</style>
