---
interface Props {
	/** Mono eyebrow above the heading. */
	eyebrow?: string;
	heading: string;
	/** Ties this section to a chapter id in the rail, for scroll-spy. */
	chapter?: string;
	/**
	 * Italic heading. In the reference, the Problem chapter reports facts
	 * upright and every later chapter states a position in italic — the
	 * heading is an argument rather than a report.
	 */
	claim?: boolean;
	/** `split` puts the visual under the heading with copy beside it (desktop);
	 *  `prose` is copy only, full measure. */
	layout?: 'split' | 'prose';
	id?: string;
}

const { eyebrow, heading, chapter, claim = false, layout = 'split', id } = Astro.props;
---

<section class:list={['section', `section--${layout}`]} data-section={id ?? chapter} data-chapter={chapter} id={id}>
	<div class="section__head">
		{eyebrow && <p class="type-overline">{eyebrow}</p>}
		<h2 class:list={['type-heading', claim && 'type-heading--claim']}>{heading}</h2>
		<slot name="visual" />
	</div>
	<div class="section__body">
		<slot />
	</div>
</section>

<style>
	.section {
		max-width: var(--measure-page);
		margin: 0 auto;
		padding: var(--spacing-8xl) var(--gutter);
		display: grid;
		gap: var(--spacing-3xl);
	}

	/* Two columns on desktop: the heading and its visual on the left, the copy
	   on the right. On mobile the same order stacks — heading, visual, copy —
	   which is why the visual is a slot inside the head rather than a sibling. */
	@media (min-width: 60rem) {
		.section--split {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: var(--spacing-7xl);
			align-items: start;
		}
	}

	.section--prose {
		max-width: calc(var(--measure-page) * 0.62);
	}

	.section__head {
		display: grid;
		gap: var(--spacing-xl);
		min-width: 0;
	}

	h2 {
		color: var(--text);
	}

	.section__body {
		min-width: 0;
		display: grid;
		gap: var(--spacing-2xl);
		align-content: start;
	}

	/* Copy inside a section is authored as MDX, so the elements arrive without
	   classes — style them here rather than asking the author to annotate
	   every paragraph. */
	.section__body :global(p) {
		font-family: var(--font-sans);
		font-weight: var(--weight-regular);
		font-size: var(--size-body);
		line-height: var(--lh-body);
		color: var(--text-body);
		margin: 0;
		max-width: 62ch;
	}

	.section__body :global(ol),
	.section__body :global(ul) {
		font-family: var(--font-sans);
		font-size: var(--size-body);
		line-height: var(--lh-body);
		color: var(--text-body);
		margin: 0;
		padding-inline-start: var(--spacing-3xl);
		max-width: 62ch;
		display: grid;
		gap: var(--spacing-sm);
	}

	.section__body :global(li::marker) {
		color: var(--text-muted);
	}

	.section__body :global(strong) {
		color: var(--text);
		font-weight: var(--weight-semibold);
	}
</style>
