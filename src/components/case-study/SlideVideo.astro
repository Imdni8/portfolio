---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The screen recording inside a Solution slide's media card, anchored to one
 * corner and bleeding off the two opposite edges so the vid-bg.jpg backdrop
 * reads as an L-shaped strip along the other two.
 *
 * `pin` names the corner the video **hugs and runs past**; the opposite corner
 * is the visible, rounded one. Which corner a slide takes is a framing
 * decision made against the recording itself — pin away from where the action
 * sits, so the clipped edges are the empty ones. (The banner clip lives at the
 * top of frame, so it pins bottom-*; the floating update tab lives at the
 * bottom, so that slide is the one `top-left`.) `center` is the one non-corner
 * option, for a recording whose subject is itself centred (a modal over a
 * dimmed backdrop, not an off-center panel) — there is no empty corner to
 * bleed toward, so the video insets evenly on all four sides instead and
 * rounds on all four corners, framed by the vid-bg strip evenly rather than
 * an L-shaped sliver.
 *
 * The trigger button is the component root: .solution-slide__media already
 * supplies `position: relative` and `overflow: hidden`, which is the entire
 * clip mechanism the button's absolute positioning relies on.
 *
 * Note there is deliberately **no `autoplay`**. solution-carousel.ts starts and
 * stops playback off the same `data-active` signal that drives the slide's
 * opacity, so only the slide in view ever decodes — and the reduced-motion
 * case falls out for free, because nothing calls play() and the poster stands.
 * `preload="none"` is the other half of that: five clips on one page should not
 * all be fetched before the reader has paged to them.
 *
 * The video sits inside a `<button>` trigger, not as the root — same
 * click-to-enlarge pattern Figure.astro uses for images (a button so it's
 * keyboard-reachable), wired to the same global Lightbox overlay via
 * `data-zoom-video`/`data-zoom-poster`/`data-zoom-alt` instead of Figure's
 * `data-zoom`. The pin positioning that used to sit on the video itself now
 * sits on the button — the video just fills it — because the video needs to
 * stay hidden from assistive tech (its content is spoken through the
 * button's own `aria-label`) and unfocusable, which is what a plain `<video>`
 * with no `controls` already is by default.
 */
interface Props {
	/** A `/media/…` path. Video is served from public/ and never bundled — see
	 *  CLAUDE.md; astro:assets does not process video anyway. */
	src: string;
	/** The still under the video until it plays, and the whole picture for a
	 *  reader on prefers-reduced-motion. An src/assets import, like every other
	 *  poster in the case-study kit. */
	poster: ImageMetadata;
	alt: string;
	pin: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'center';
}
const { src, poster, alt, pin } = Astro.props;

/* Through Astro's pipeline rather than `poster.src`, which would ship the raw
   1920-wide PNG for a frame that is mostly never seen. */
const posterUrl = (await getImage({ src: poster, width: 1200, format: 'webp' })).src;
---

<button
	type="button"
	class="slide-video__trigger"
	data-pin={pin}
	data-zoom-video={src}
	data-zoom-poster={posterUrl}
	data-zoom-alt={alt}
	aria-label={`Expand: ${alt}`}
>
	<video
		class="slide-video"
		src={src}
		poster={posterUrl}
		aria-hidden="true"
		muted
		loop
		playsinline
		preload="none"></video>
</button>

<style>
	/* The positioned, pinned, bordered box — everything the plain <video> used
	   to carry before it moved behind a click-to-enlarge trigger (see file
	   header). The video inside is just an unstyled fill; every framing
	   decision below lives on the button. */
	.slide-video__trigger {
		/* The two values the framing is tuned with. Equal, they make the video
		   box exactly the card's own size translated diagonally toward the
		   pinned corner — so the visible window is ~89% × ~91% of the frame,
		   the same gentle crop on every slide. Raise --pin-inset for a wider
		   backdrop strip, --pin-bleed for a harder crop. */
		--pin-inset: var(--spacing-6xl);
		--pin-bleed: var(--spacing-6xl);

		appearance: none;
		padding: 0;
		position: absolute;
		z-index: 1;
		display: block;
		cursor: zoom-in;

		/* Load-bearing since the radius moved here off the <video>. A replaced
		   element clips its own painted frame to its own border-radius, so the
		   video used to round itself; a <button> does not clip its children,
		   so without this the video's square corner paints straight over the
		   one rounded corner each variant sets below. The focus ring is
		   unaffected — an outline is not clipped by its own element's
		   overflow. Same reason Figure.astro's zoom button carries it. */
		overflow: hidden;

		/* All four insets are set per variant, so the box is sized by its
		   offsets and needs no width/height of its own. */

		/* Inherited from the placeholder this replaces: the border's two bled
		   sides fall outside the card's clip, so only the two visible edges
		   draw a line — which is the result we want, not a compromise. */
		border: 1px solid var(--border);
		background: var(--bg-media);
	}

	.slide-video__trigger:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}

	.slide-video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* 48px is 6% of the card's width and 9.6% of its height at the design's
	   reference desktop size, but the card is fluid — on a phone the same
	   literal would eat a quarter of the frame's height and read as a margin
	   rather than a peek. One step down at the same 40rem breakpoint the
	   footer's row uses puts it back to ~10%. */
	@media (max-width: 40rem) {
		.slide-video__trigger {
			--pin-inset: var(--spacing-3xl);
			--pin-bleed: var(--spacing-3xl);
		}
	}

	/* One variant per corner. The site is LTR-only, so the logical properties
	   below map straight onto the physical names in `pin`:
	   block-start = top, inline-start = left.

	   Each sets the two visible edges to +inset, the two pinned edges to
	   -bleed, a radius on the single corner that is actually on screen, and an
	   object-position at that same corner — so if a delivered file is not 16:10
	   the cover trim eats from the same edges the card is already clipping,
	   rather than fighting them.

	   All four properties hang off the one `data-pin`, on the button: the
	   object-position reaches the video as a descendant rather than the video
	   carrying a second copy of the attribute to be kept in sync. Written flat
	   rather than as a nested `& .slide-video` — Astro does not add its scope
	   hash inside a nested selector, and the nesting itself would need browser
	   support the rest of this file does not. */

	/* Hugs bottom + right; top-left corner visible. */
	.slide-video__trigger[data-pin='bottom-right'] {
		inset-block-start: var(--pin-inset);
		inset-inline-start: var(--pin-inset);
		inset-block-end: calc(-1 * var(--pin-bleed));
		inset-inline-end: calc(-1 * var(--pin-bleed));
		border-start-start-radius: var(--radius-lg);
	}
	.slide-video__trigger[data-pin='bottom-right'] .slide-video {
		object-position: left top;
	}

	/* Hugs bottom + left; top-right corner visible. */
	.slide-video__trigger[data-pin='bottom-left'] {
		inset-block-start: var(--pin-inset);
		inset-inline-end: var(--pin-inset);
		inset-block-end: calc(-1 * var(--pin-bleed));
		inset-inline-start: calc(-1 * var(--pin-bleed));
		border-start-end-radius: var(--radius-lg);
	}
	.slide-video__trigger[data-pin='bottom-left'] .slide-video {
		object-position: right top;
	}

	/* Hugs top + right; bottom-left corner visible. */
	.slide-video__trigger[data-pin='top-right'] {
		inset-block-end: var(--pin-inset);
		inset-inline-start: var(--pin-inset);
		inset-block-start: calc(-1 * var(--pin-bleed));
		inset-inline-end: calc(-1 * var(--pin-bleed));
		border-end-start-radius: var(--radius-lg);
	}
	.slide-video__trigger[data-pin='top-right'] .slide-video {
		object-position: left bottom;
	}

	/* Hugs top + left; bottom-right corner visible. */
	.slide-video__trigger[data-pin='top-left'] {
		inset-block-end: var(--pin-inset);
		inset-inline-end: var(--pin-inset);
		inset-block-start: calc(-1 * var(--pin-bleed));
		inset-inline-start: calc(-1 * var(--pin-bleed));
		border-end-end-radius: var(--radius-lg);
	}
	.slide-video__trigger[data-pin='top-left'] .slide-video {
		object-position: right bottom;
	}

	/* No corner to hug — all four edges inset equally, all four corners
	   rounded, so the backdrop reads as an even frame rather than an
	   L-shaped strip. The corner variants above get their sizing for free
	   from opposing inset/bleed cancelling out to exactly 100% of the card
	   (their whole point — see the file header); here there is no negative
	   bleed to cancel against, so a plain `inset` on all four sides is enough
	   — unlike the bare <video> this trigger replaced, a <button> is not a
	   replaced element, so it has no unloaded-intrinsic-size sizing quirk to
	   work around. */
	.slide-video__trigger[data-pin='center'] {
		inset: var(--pin-inset);
		border-radius: var(--radius-lg);
	}
	.slide-video__trigger[data-pin='center'] .slide-video {
		object-position: center;
	}
</style>
