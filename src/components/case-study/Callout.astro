---
/** Aside that qualifies the work — method notes, caveats, constraints. */
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<aside class="callout">
	<p class="callout__label">{label}</p>
	<div class="callout__body"><slot /></div>
</aside>

<style>
	.callout {
		border: 1px solid var(--c-support);
		border-radius: var(--radius-lg);
		padding: var(--s-5) var(--s-5) var(--s-5);
		background:
			radial-gradient(120% 140% at 88% 118%, color-mix(in srgb, var(--c-support) 45%, transparent), transparent 62%),
			var(--c-support-surface);
	}

	.callout__label {
		font-family: var(--f-mono);
		font-size: var(--t-small);
		font-weight: var(--fw-bold);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--c-support-bright);
		margin-block-end: var(--s-2);
	}

	.callout__body {
		font-size: var(--t-meta);
		line-height: var(--lh-body);
		color: var(--c-text);
	}
</style>
