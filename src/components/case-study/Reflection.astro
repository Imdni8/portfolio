---
interface Props {
	heading?: string;
}
const { heading = 'Reflections' } = Astro.props;
---

<section class="reflection">
	<h2 class="type-reflection">{heading}</h2>
	<div class="reflection__body">
		<slot />
	</div>
</section>

<style>
	.reflection {
		max-width: var(--measure-page);
		margin: 0 auto;
		padding: var(--spacing-7xl) var(--gutter) var(--spacing-9xl);
		border-block-start: 1px solid var(--border);
		display: grid;
		gap: var(--spacing-2xl);
	}

	h2 {
		color: var(--primary-text);
	}

	.reflection__body {
		display: grid;
		gap: var(--spacing-2xl);
	}

	.reflection__body :global(p) {
		font-family: var(--font-sans);
		font-size: var(--size-body);
		line-height: var(--lh-body);
		color: var(--text-body);
		margin: 0;
		max-width: 78ch;
	}

	.reflection__body :global(ul) {
		font-family: var(--font-sans);
		font-size: var(--size-body);
		line-height: var(--lh-body);
		color: var(--text-body);
		margin: 0;
		padding-inline-start: var(--spacing-3xl);
		max-width: 78ch;
		display: grid;
		gap: var(--spacing-sm);
	}

	.reflection__body :global(li::marker) {
		color: var(--text-muted);
	}
</style>
