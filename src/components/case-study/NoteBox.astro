---
import Icon from '../ui/Icon.astro';

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<details class="note">
	<summary class="note__title type-overline">
		{title}
		<Icon name="chevron-down" class="note__chevron" />
	</summary>
	<div class="note__body type-annotation"><slot /></div>
</details>

<style>
	/* Takes the glossary popover's surface rather than the design-system Note's
	   amber fill, so the two notes a reader meets in a case study — this one in
	   the flow, the one a term pops up — read as the same object. Same tokens as
	   `.glossary`, so they move together.
	   Both pairings clear AA on the raised ground in both themes: the mono title
	   is 6.89:1 dark / 6.83:1 light, the body 11.87:1 / 14.24:1.

	   <details>/<summary> instead of the design-system Note's <aside>: unlike
	   that one (always open, never reused), this note collapses behind its
	   title — the native element gets open/close plus keyboard and screen-reader
	   support for free, no script needed. Starts closed: it's a caveat on the
	   main flow, not something every reader needs to see unprompted.

	   Full width of its column, too — the design-system default caps at 34rem,
	   which is right for a tooltip but leaves an odd gap inside a section.

	   display: block, not the design-system .note's grid: <details> renders
	   its non-summary child through an internal shadow slot, and that slot
	   still occupies a grid track — so the shared `gap` was adding a phantom
	   row-gap under the title even while the body itself was invisible.
	   Normal flow has no such gap to leak; .note__body's own margin-top below
	   replaces it, and disappears along with the body when collapsed. */
	.note {
		display: block;
		background: var(--bg-raised);
		border: none;
		padding-block: var(--spacing-md);
		padding-inline: var(--spacing-xl);
		max-width: none;
	}

	.note__body {
		margin-top: var(--spacing-xs);
	}

	/* The design-system .note__title only ever sits beside an absolutely
	   positioned close button, hence its padding-right — this title carries the
	   chevron inline instead, so that reserved space is cleared for a flex row. */
	.note__title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding-right: 0;
		cursor: pointer;
		list-style: none;
	}

	.note__title::-webkit-details-marker {
		display: none;
	}

	.note__title:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-xxs);
	}

	/* :global() because the chevron is Icon.astro's own <span>, not markup
	   this component wrote — Astro only stamps its scoping attribute onto a
	   component's own template, so an unqualified .note__chevron selector
	   here would silently match nothing.

	   Closed reads as a collapsed row (pointing at the title, right), open as
	   "reveals the content below" (chevron-down's own resting orientation,
	   so the open state needs no rotation at all). */
	.note :global(.note__chevron) {
		width: var(--spacing-xl);
		height: var(--spacing-xl);
		flex-shrink: 0;
		transform: rotate(-90deg);
		transition: transform 150ms ease;
	}

	.note[open] :global(.note__chevron) {
		transform: rotate(0deg);
	}
</style>
