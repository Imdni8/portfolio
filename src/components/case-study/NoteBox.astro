---
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<aside class="note">
	<p class="note__title">{title}</p>
	<p class="note__body"><slot /></p>
</aside>

<style>
	/* Full width of its column here — the design-system default caps at 34rem,
	   which is right for a tooltip but leaves an odd gap inside a section. */
	.note {
		max-width: none;
	}
</style>
