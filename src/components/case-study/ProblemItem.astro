---
import type { ImageMetadata } from 'astro';
import AnnotatedFigure from './AnnotatedFigure.astro';
import type { Note } from './BeforeAfter';
import { storyHeading } from './story-type';

/**
 * One numbered row of the Problem chapter: a "#N" eyebrow, a short
 * statement, then a full-width annotated screenshot underneath — all three
 * stacked in one column. Deliberately not StoryBlock (shot-left/copy-right):
 * the design stacks number, statement and image vertically, not side by
 * side.
 */
interface Props {
	number: number;
	statement: string;
	image: ImageMetadata;
	alt: string;
	notes?: Note[];
}

const { number, statement, image, alt, notes = [] } = Astro.props;
---

<div class="grid gap-4">
	<p class="type-overline">#{number}</p>
	<p class:list={['text-lg leading-6', storyHeading]}>{statement}</p>
	<AnnotatedFigure src={image} alt={alt} notes={notes} />
</div>
