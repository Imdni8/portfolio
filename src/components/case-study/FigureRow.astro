---
interface Props {
	/** Labels sit above each figure — "Iteration 1", "Iteration 2". */
	labels?: string[];
}
const { labels = [] } = Astro.props;
---

<div class="row" data-labels={labels.join('|')}>
	<slot />
</div>

<style>
	/* Two or more figures that read as one comparison. Equal columns so the
	   images can be compared at the same scale — the whole point of a row. */
	.row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
		gap: var(--spacing-xl);
		align-items: start;
	}
</style>
