---
import { Image, getImage } from 'astro:assets';
import BeforeAfter, { dedupeNotes } from './BeforeAfter';
import Icon from '../ui/Icon.astro';
import { buttonVariants } from '../ui/button';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	/** Optional — a case study whose hero speaks for itself (e.g. one led by
	 *  the chapter nav rather than a lede) can omit it; the line is skipped
	 *  rather than rendering empty. */
	subtitle?: string;
	/** Whether CaseStudyLayout is rendering a ChapterNav for this study. Its
	 *  back arrow takes over as the way home, so the breadcrumb below steps
	 *  aside rather than duplicating it — a study with no chapter nav still
	 *  needs the breadcrumb, since nothing else here gets you back to `/`. */
	hasChapterNav?: boolean;
	facts?: { label: string; value: string }[];
	actions?: {
		primary?: { label: string; href: string };
		secondary?: { label: string; href: string };
	};
	/** A single opener shot, for a case study with nothing to compare. The
	 *  schema keeps this and `hero` mutually exclusive. */
	heroShot?: { src: ImageMetadata; alt: string };
	hero?: {
		before: ImageMetadata;
		after: ImageMetadata;
		beforeAlt: string;
		afterAlt: string;
		beforeLabel?: string;
		afterLabel?: string;
		beforeNotes?: { x: number; y: number; text: string; label?: string }[];
		afterNotes?: { x: number; y: number; text: string; label?: string }[];
	};
}

const { title, subtitle, hasChapterNav = false, facts = [], actions = {}, hero, heroShot } = Astro.props;
const beforeLabel = hero?.beforeLabel ?? 'Before';
const afterLabel = hero?.afterLabel ?? 'After';
const beforeNotes = hero?.beforeNotes ?? [];
const afterNotes = hero?.afterNotes ?? [];

// The island takes plain src/srcSet strings, so the responsive set has to be
// resolved here — <Image> cannot do it inside a React component.
const shotWidths = [720, 1080, 1440, 1920];
const [before, after] = hero
	? await Promise.all([
			getImage({ src: hero.before, widths: shotWidths, format: 'webp', quality: 82 }),
			getImage({ src: hero.after, widths: shotWidths, format: 'webp', quality: 82 }),
		])
	: [];

// Mirrors .hero__frame's own max-width formula below — measure-prose plus
// two gutters, capped by the viewport, minus those same two gutters handed
// back — in resolved units, since `sizes` cannot read custom properties. Errs
// slightly wide rather than narrow, so a mismatch costs a few kB, not blur.
//
// Because the formula adds a gutter back before subtracting it, the frame is
// flat at --measure-prose (62.5rem) once the viewport is wide enough to hold
// measure-prose + 2×gutter — the same net width StoryChapter's `narrow` mode
// gives its own images (see that file's own comment on the same trick), which
// is why the hero shot now lines up with the rest of the page's screenshots
// instead of running ~120px narrower than them. That crossover works out to
// ~67.9rem (62.5rem / 0.92, since --gutter is 4vw below its 4rem cap); 68rem
// is a safe round threshold above it. Below the threshold the frame tracks
// ~92vw (the viewport less two ~4vw gutters). If the measure moves, move this
// string too.
const compareSizes = '(min-width: 68rem) 62.5rem, 92vw';
---

<header class="hero">
	<div class="hero__inner">
		<div class="hero__lede">
			{/* CaseStudyLayout renders no SiteNav — this breadcrumb is the only
			    way back to the homepage on a case-study page, UNLESS the study
			    has a ChapterNav, whose own back arrow takes over that job (see
			    ChapterNav.astro) — rendering both would duplicate the
			    affordance, so this one steps aside rather than stacking. It
			    steps aside only where the rail is actually on screen, though:
			    the rail hides below 1400px, so `data-rail` keeps the crumb
			    there. The crumb carries the same word the nav uses for `/`
			    ("Work", not "Home") rather than leaving the whole trail resting
			    on an unlabelled glyph. "Project" is a static crumb naming the
			    page kind, not this case study's title; the title right below
			    it already carries that. */}
			<nav class="hero__breadcrumb" aria-label="Breadcrumb" data-rail={hasChapterNav || undefined}>
				<a class="type-body breadcrumb__home" href="/">
					<Icon name="home" />
					Work
				</a>
				<Icon name="slash-divider" class="breadcrumb__divider" />
				<span class="type-body breadcrumb__current" aria-current="page">
					Project
				</span>
			</nav>

			<h1 class="type-title">{title}</h1>
			{subtitle && <p class="type-subtitle hero__subtitle">{subtitle}</p>}

			{
				(actions.primary || actions.secondary) && (
					<div class="hero__actions">
						{actions.primary && (
							<a class={buttonVariants()} href={actions.primary.href}>
								<span>{actions.primary.label}</span>
								<Icon name="play" />
							</a>
						)}
						{actions.secondary && (
							<a class={buttonVariants({ variant: 'secondary' })} href={actions.secondary.href}>
								<span>{actions.secondary.label}</span>
								<Icon name="arrow-down" />
							</a>
						)}
					</div>
				)
			}
		</div>

		{
			facts.length > 0 && (
				<dl class="facts">
					{facts.map((f) => (
						<div class="facts__item">
							<dt class="type-overline">{f.label}</dt>
							<dd class="type-body facts__value">{f.value}</dd>
						</div>
					))}
				</dl>
			)
		}
	</div>

	{
		heroShot && (
			/* The still counterpart to the compare below: same frame, same
			   width, no drag affordance. `sizes` is compareSizes for the same
			   reason — the two openers occupy the identical box, so they want
			   the identical responsive set. */
			<div class="hero__frame hero__shot">
				{/* The opener, so it is the page's LCP candidate on every case
				    study that has one. Astro's image service defaults to
				    `loading="lazy"`, which would put it behind an intersection
				    check instead of starting it during HTML parse. */}
				<Image
					src={heroShot.src}
					alt={heroShot.alt}
					widths={shotWidths}
					sizes={compareSizes}
					quality={82}
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		)
	}

	{
		hero && before && after && (
			<div class="hero__frame hero__compare">
				<BeforeAfter
					client:load
					before={{
						src: before.src,
						srcSet: before.srcSet.attribute,
						sizes: compareSizes,
						width: hero.before.width,
						height: hero.before.height,
						alt: hero.beforeAlt,
					}}
					after={{
						src: after.src,
						srcSet: after.srcSet.attribute,
						sizes: compareSizes,
						width: hero.after.width,
						height: hero.after.height,
						alt: hero.afterAlt,
					}}
					beforeLabel={beforeLabel}
					afterLabel={afterLabel}
					beforeNotes={beforeNotes}
					afterNotes={afterNotes}
					ratio={hero.after.width / hero.after.height}
				/>

				{/* The pins and the panel they open are aria-hidden inside the
				    island — they are a drag affordance, and at rest both sides'
				    text is in the DOM at once, which would read as duplicated
				    nonsense. This is the same content, once, in reading order.
				    Same labels as the island above, not restated literally, so
				    the two representations cannot drift apart. */}
				<div class="ba-notes sr-only">
					{beforeNotes.length > 0 && (
						<div class="ba-notes__group">
							<h2 class="type-overline">{beforeLabel}</h2>
							<ol>{dedupeNotes(beforeNotes).map(({ text }) => <li>{text}</li>)}</ol>
						</div>
					)}
					{afterNotes.length > 0 && (
						<div class="ba-notes__group">
							<h2 class="type-overline">{afterLabel}</h2>
							<ol>{dedupeNotes(afterNotes).map(({ text }) => <li>{text}</li>)}</ol>
						</div>
					)}
				</div>
			</div>
		)
	}
</header>

<style>
	/* Title, subtitle and facts read as one centred column at every width —
	   `justify-items: center` keeps each grid row sized to its own content
	   (the title's line width, mainly) rather than stretched full-bleed, so
	   centring the shorter rows under it actually reads as centred instead
	   of centred-in-a-wide-empty-track. Facts stay a sibling grid row rather
	   than living inside .hero__lede since it's metadata, not lede copy. */
	.hero__inner {
		max-width: var(--measure-prose);
		margin: 0 auto;
		padding: var(--spacing-9xl) var(--gutter) var(--spacing-7xl);
		display: grid;
		justify-items: center;
		gap: var(--spacing-6xl);
		text-align: center;
	}

	/* ---- breadcrumb ----
	   .hero__lede's own first child, not a separate grid row — the 4px gap to
	   the title below is that grid's own --spacing-2xl (20px) row gap, clawed
	   back by the margin below rather than a second, untracked gap value.
	   Colours are lifted straight off the Paper node: the divider's gray-200
	   is --text-body's own dark value, and the home icon's amber-500 is
	   --primary-text (not --primary, a filled-control token) since it sits
	   directly on the page ground. */
	.hero__breadcrumb {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		margin-block-end: calc(var(--spacing-xs) - var(--spacing-2xl));
	}

	/* Mirrors ChapterNav's own breakpoint: hide the crumb only where the
	   rail's back arrow is on screen to replace it. */
	@media (width >= 87.5rem) {
		.hero__breadcrumb[data-rail] {
			display: none;
		}
	}

	/* A plain link, not an icon button: the crumb has a visible label now, so
	   there is no icon-only control left to be that component — and with
	   it goes the negative margin that used to claw back the button's own
	   padding so the glyph sat flush in the row. Underline on hover rather
	   than a colour change, since amber at rest is the crumb's identity. */
	.breadcrumb__home {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-sm);
		color: var(--primary-text);
		text-decoration: none;
	}

	/* :global() for the same reason as the divider below — the span is
	   Icon.astro's, not this template's. 1.125em, not a fixed size, is the
	   ratio a text button's icon already uses (ui/button.tsx): the glyph
	   tracks the label. */
	.breadcrumb__home :global(.icon) {
		width: 1.125em;
		height: 1.125em;
	}

	.breadcrumb__home:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.breadcrumb__home:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-xs);
	}

	/* :global() because the divider span is rendered by Icon.astro, not this
	   component — Astro scopes a style block to the elements its own template
	   renders, so an unqualified `.breadcrumb__divider` never matches, even
	   with the class passed down as a prop. Same workaround SiteNav.astro
	   makes for `.nav-dropdown__chevron`. Without it these three declarations
	   are silently dropped and the divider only looks right by coincidence:
	   `.icon`'s 1em happens to equal 1rem, and the inherited body colour
	   happens to be --text-body. */
	:global(.breadcrumb__divider) {
		width: 1rem;
		height: 1rem;
		color: var(--text-body);
	}

	/* --text-disabled rather than --text: the token itself signals "inert"
	   the way a disabled control would, which is right for a crumb that
	   isn't clickable. */
	.breadcrumb__current {
		color: var(--text-disabled);
	}

	/* Capped narrower than .hero__inner (--measure-copy vs. --measure-prose) —
	   the lede reads as a copy column, while the hero shot/compare beside it
	   is free to run the full --measure-prose width and break out past it on
	   both sides. */
	.hero__lede {
		max-width: var(--measure-copy);
		margin-inline: auto;
		display: grid;
		justify-items: center;
		gap: var(--spacing-2xl);
	}

	h1 {
		color: var(--text);
	}

	.hero__subtitle {
		color: var(--text-body);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--spacing-lg);
		margin-top: var(--spacing-xl);
	}

	/* ---- facts ----
	   One centred row at every width — a horizontal strip of dividers, sized
	   to its own content (not stretched to the column) so `.hero__inner`'s
	   `justify-items: center` centres the group as a whole under the title.
	   The same --measure-copy cap as .hero__lede, so the facts row stays in
	   the copy column rather than the wider frame beside it — a safety net
	   more than a visible change today, since the row is short enough to sit
	   well under 752px on its own content already.

	   `grid-auto-columns: 1fr` rather than `display: flex`, so every item is
	   the same width regardless of label/value length — flex's `flex: 1` would
	   need a definite container width to divide evenly, which this row
	   deliberately doesn't have (it hugs its content, see above); a `1fr`
	   auto-column grid still hugs its content under intrinsic sizing, but
	   every column resolves to the widest item's own width instead of its own. */
	.facts {
		max-width: var(--measure-copy);
		margin: 0 auto;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 1fr;
	}

	.facts__item {
		padding-inline: var(--spacing-3xl);
		text-align: center;
		border-inline-start: 1px solid var(--border);
	}
	.facts__item:first-child {
		padding-inline-start: 0;
		border-inline-start: 0;
	}
	.facts__item:last-child {
		padding-inline-end: 0;
	}

	.facts__value {
		margin: var(--spacing-xs) 0 0;
		color: var(--text-body);
	}

	/* ---- before / after ----
	   Capped to --measure-prose, not .hero__lede's narrower --measure-copy —
	   the frame is deliberately wider than the title/facts above it, breaking
	   out past their edges on both sides, the same copy-vs-media split
	   StoryChapter's `narrow` mode uses for a chapter's own heading and
	   images — and it's --measure-prose rather than the wider --measure-story
	   precisely because that's the measure narrow-mode chapters render their
	   own screenshots at. The hero shot is the reader's first look at the
	   product, so it needs to read as the same width as those, not as wide as
	   a plain `Section`'s own --measure-story column. The island sets its own
	   aspect ratio, so this only has to give it the width.

	   The `+ 2 * var(--gutter)` inside the min() is the same compensation
	   StoryChapter's `narrow` mode applies to its own container (see that
	   file's comment on the identical trick): the gutter is meant to sit
	   *outside* the --measure-prose cap, not be carved out of it, so a bare
	   `min(var(--measure-prose), 100%) - 2 * var(--gutter)` would leave the
	   frame ~120px narrower than --measure-prose (and than every narrow-mode
	   screenshot below it) instead of flush with it. Adding the gutter back
	   before subtracting it nets out to exactly --measure-prose once the
	   viewport is wide enough, and still falls back to "100% minus two
	   gutters" below that, same as before.

	   No background here: the island carries its own, and a sunken band exactly
	   the width of the frame would do nothing but show square corners behind
	   the frame's rounded ones. */
	/* The opener's box, shared by both variants — a compare and a single shot
	   are the same frame in the same slot, so the width lives here once rather
	   than in two rules that could drift. */
	.hero__frame {
		max-width: calc(min(var(--measure-prose) + 2 * var(--gutter), 100%) - 2 * var(--gutter));
		margin-inline: auto;
		/* The chapter rail follows immediately and is sticky, so it needs
		   clearing rather than butting against the frame. */
		margin-block-end: var(--spacing-4xl);
	}

	/* Radius and ground are lifted from `.ba` in components.css, so a still
	   opener is cut to the same corner as a compare one. The compare owns its
	   own copy there because it also clips two absolutely-positioned halves to
	   it; this only has to clip one <img>. */
	.hero__shot {
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--bg-sunken);
	}

	.hero__shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
