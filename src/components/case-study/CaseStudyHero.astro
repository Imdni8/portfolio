---
import { getImage } from 'astro:assets';
import BeforeAfter, { dedupeNotes } from './BeforeAfter';
import Icon from '../ui/Icon.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	subtitle: string;
	facts?: { label: string; value: string }[];
	actions?: {
		primary?: { label: string; href: string };
		secondary?: { label: string; href: string };
	};
	hero?: {
		before: ImageMetadata;
		after: ImageMetadata;
		beforeAlt: string;
		afterAlt: string;
		beforeLabel?: string;
		afterLabel?: string;
		beforeNotes?: { x: number; y: number; text: string; label?: string }[];
		afterNotes?: { x: number; y: number; text: string; label?: string }[];
	};
}

const { title, subtitle, facts = [], actions = {}, hero } = Astro.props;
const beforeLabel = hero?.beforeLabel ?? 'Before';
const afterLabel = hero?.afterLabel ?? 'After';
const beforeNotes = hero?.beforeNotes ?? [];
const afterNotes = hero?.afterNotes ?? [];

// The island takes plain src/srcSet strings, so the responsive set has to be
// resolved here — <Image> cannot do it inside a React component.
const shotWidths = [720, 1080, 1440, 1920];
const [before, after] = hero
	? await Promise.all([
			getImage({ src: hero.before, widths: shotWidths, format: 'webp', quality: 82 }),
			getImage({ src: hero.after, widths: shotWidths, format: 'webp', quality: 82 }),
		])
	: [];

// Mirrors .hero__compare's own max-width formula below (min(measure, 100%) −
// 2×gutter) in resolved units, since `sizes` cannot read custom properties —
// it is evaluated before the stylesheet that defines them is available. Errs
// slightly wide rather than narrow, so a mismatch costs a few kB, not blur.
const compareSizes = '(min-width: 100rem) 83.875rem, calc(100vw - 8vw)';
---

<header class="hero">
	<div class="hero__inner">
		<div class="hero__lede">
			{/* CaseStudyLayout renders no SiteNav — this is the only way back to
			    the homepage on a case-study page, so the crumb carries the
			    same word the nav uses for `/` ("Work", not "Home") rather
			    than leaving the whole trail resting on an unlabelled glyph.
			    "Project" is a static crumb naming the page kind, not this
			    case study's title; the title right below it already carries
			    that. */}
			<nav class="hero__breadcrumb" aria-label="Breadcrumb">
				<a class="type-body breadcrumb__home" href="/">
					<Icon name="home" />
					Work
				</a>
				<Icon name="slash-divider" class="breadcrumb__divider" />
				<span class="type-body breadcrumb__current" aria-current="page">Project</span>
			</nav>

			<h1 class="type-title">{title}</h1>
			<p class="type-subtitle hero__subtitle">{subtitle}</p>

			{
				(actions.primary || actions.secondary) && (
					<div class="hero__actions">
						{actions.primary && (
							<a class="btn btn--primary" href={actions.primary.href}>
								<span>{actions.primary.label}</span>
								<Icon name="play" />
							</a>
						)}
						{actions.secondary && (
							<a class="btn btn--secondary" href={actions.secondary.href}>
								<span>{actions.secondary.label}</span>
								<Icon name="arrow-down" />
							</a>
						)}
					</div>
				)
			}
		</div>

		{
			facts.length > 0 && (
				<dl class="facts">
					{facts.map((f) => (
						<div class="facts__item">
							<dt class="type-overline">{f.label}</dt>
							<dd class="type-body facts__value">{f.value}</dd>
						</div>
					))}
				</dl>
			)
		}
	</div>

	{
		hero && before && after && (
			<div class="hero__compare">
				<BeforeAfter
					client:load
					before={{
						src: before.src,
						srcSet: before.srcSet.attribute,
						sizes: compareSizes,
						width: hero.before.width,
						height: hero.before.height,
						alt: hero.beforeAlt,
					}}
					after={{
						src: after.src,
						srcSet: after.srcSet.attribute,
						sizes: compareSizes,
						width: hero.after.width,
						height: hero.after.height,
						alt: hero.afterAlt,
					}}
					beforeLabel={beforeLabel}
					afterLabel={afterLabel}
					beforeNotes={beforeNotes}
					afterNotes={afterNotes}
					ratio={hero.after.width / hero.after.height}
				/>

				{/* The pins and the panel they open are aria-hidden inside the
				    island — they are a drag affordance, and at rest both sides'
				    text is in the DOM at once, which would read as duplicated
				    nonsense. This is the same content, once, in reading order.
				    Same labels as the island above, not restated literally, so
				    the two representations cannot drift apart. */}
				<div class="ba-notes sr-only">
					{beforeNotes.length > 0 && (
						<div class="ba-notes__group">
							<h2 class="type-overline">{beforeLabel}</h2>
							<ol>{dedupeNotes(beforeNotes).map(({ text }) => <li>{text}</li>)}</ol>
						</div>
					)}
					{afterNotes.length > 0 && (
						<div class="ba-notes__group">
							<h2 class="type-overline">{afterLabel}</h2>
							<ol>{dedupeNotes(afterNotes).map(({ text }) => <li>{text}</li>)}</ol>
						</div>
					)}
				</div>
			</div>
		)
	}
</header>

<style>
	.hero__inner {
		max-width: var(--measure-page);
		margin: 0 auto;
		padding: var(--spacing-9xl) var(--gutter) var(--spacing-7xl);
		display: grid;
		gap: var(--spacing-6xl);
	}

	/* Desktop puts the facts in a right rail; mobile drops them under the
	   subtitle as a divided strip, which is why they are a separate grid
	   child rather than living inside .hero__lede. */
	@media (min-width: 60rem) {
		.hero__inner {
			grid-template-columns: minmax(0, 1fr) 20rem;
			gap: var(--spacing-8xl);
			/* Deliberately not `align-items: start`. The rail has to stretch to
			   the row height, or its entries cannot sit flush with the top and
			   bottom of the column beside them. */
		}
	}

	/* ---- breadcrumb ----
	   .hero__lede's own first child, not a separate grid row — the 4px gap to
	   the title below is that grid's own --spacing-2xl (20px) row gap, clawed
	   back by the margin below rather than a second, untracked gap value.
	   Colours are lifted straight off the Paper node: the divider's gray-200
	   is --text-body's own dark value, and the home icon's amber-500 is
	   --primary-text (not --primary, a filled-control token) since it sits
	   directly on the page ground. */
	.hero__breadcrumb {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		margin-block-end: calc(var(--spacing-xs) - var(--spacing-2xl));
	}

	/* A plain link, not an icon-btn: the crumb has a visible label now, so
	   there is no icon-only control left to wear that component — and with
	   it goes the negative margin that used to claw back the button's own
	   padding so the glyph sat flush in the row. Underline on hover rather
	   than a colour change, since amber at rest is the crumb's identity. */
	.breadcrumb__home {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-sm);
		color: var(--primary-text);
		text-decoration: none;
	}

	/* :global() for the same reason as the divider below — the span is
	   Icon.astro's, not this template's. 1.125em, not a fixed size, is the
	   ratio `.btn .icon` already uses: the glyph tracks the label. */
	.breadcrumb__home :global(.icon) {
		width: 1.125em;
		height: 1.125em;
	}

	.breadcrumb__home:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.breadcrumb__home:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-xs);
	}

	/* :global() because the divider span is rendered by Icon.astro, not this
	   component — Astro scopes a style block to the elements its own template
	   renders, so an unqualified `.breadcrumb__divider` never matches, even
	   with the class passed down as a prop. Same workaround SiteNav.astro
	   makes for `.nav-dropdown__chevron`. Without it these three declarations
	   are silently dropped and the divider only looks right by coincidence:
	   `.icon`'s 1em happens to equal 1rem, and the inherited body colour
	   happens to be --text-body. */
	:global(.breadcrumb__divider) {
		width: 1rem;
		height: 1rem;
		color: var(--text-body);
	}

	/* --text-disabled rather than --text: the token itself signals "inert"
	   the way a disabled control would, which is right for a crumb that
	   isn't clickable. */
	.breadcrumb__current {
		color: var(--text-disabled);
	}

	.hero__lede {
		display: grid;
		gap: var(--spacing-2xl);
	}

	/* No measure cap: the column is already bounded by --measure-page and the
	   facts rail beside it, and the reference sets both to the full width of
	   that column. Capping them again left a ragged void on the right. */
	h1 {
		color: var(--text);
	}

	.hero__subtitle {
		color: var(--text-body);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-lg);
		margin-top: var(--spacing-xl);
	}

	/* ---- facts ---- */
	.facts {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-block: 1px solid var(--border);
	}

	.facts__item {
		padding: var(--spacing-xl) var(--spacing-lg);
		text-align: center;
		border-inline-start: 1px solid var(--border);
	}
	.facts__item:first-child {
		border-inline-start: 0;
	}

	.facts__value {
		margin: var(--spacing-xs) 0 0;
		color: var(--text-body);
	}

	@media (min-width: 60rem) {
		/* Equal thirds down the full height, so the dividers land on exact
		   thirds and the block reads as one measured column rather than a
		   stack that happens to start at the top. */
		.facts {
			display: flex;
			flex-direction: column;
			border-block: 0;
			text-align: right;
		}

		/* No padding on the item. With border-box, a flex-basis:0 item is still
		   floored at its own padding, and the middle one pads on both sides
		   where the outer two pad on one — which pulled the thirds to 91/108/92
		   and put the dividers 6px off. With the padding gone all three floor
		   at zero and grow equally; the breathing room around each entry comes
		   from the third being taller than its content. */
		.facts__item {
			flex: 1;
			min-height: 0;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding: 0;
			text-align: right;
			border-inline-start: 0;
			border-block-start: 1px solid var(--border);
		}

		/* First and last hug the edges so the rail is flush top and bottom with
		   the lede column; the middle one centres in its own third. */
		.facts__item:first-child {
			justify-content: flex-start;
			border-block-start: 0;
		}
		.facts__item:last-child {
			justify-content: flex-end;
		}
	}

	/* ---- before / after ----
	   Aligned to .hero__inner, the same container the lede and facts sit
	   inside — the frame's edges match the outer column, so the hero reads as
	   one block rather than a wide picture with a narrower page bolted on.
	   That is edge-for-edge with .hero__lede only when there is no facts
	   rail; with one, the lede occupies just the minmax(0,1fr) track beside
	   it and its own right edge sits short of the frame's. The island sets
	   its own aspect ratio, so this only has to give it the width.

	   The cap is measured off the column rather than restating a fixed number,
	   so it holds below --measure-page too, where the column is the viewport
	   less its gutters.

	   No background here: the island carries its own, and a sunken band exactly
	   the width of the frame would do nothing but show square corners behind
	   the frame's rounded ones. */
	.hero__compare {
		max-width: calc(min(var(--measure-page), 100%) - 2 * var(--gutter));
		margin-inline: auto;
		/* The chapter rail follows immediately and is sticky, so it needs
		   clearing rather than butting against the frame. */
		margin-block-end: var(--spacing-4xl);
	}
</style>
