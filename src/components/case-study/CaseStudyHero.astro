---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	dek: string;
	facts?: { label: string; value: string }[];
	actions?: {
		primary?: { label: string; href: string };
		secondary?: { label: string; href: string };
	};
	hero?: { before: ImageMetadata; after: ImageMetadata; beforeAlt: string; afterAlt: string };
}

const { title, dek, facts = [], actions = {}, hero } = Astro.props;
---

<header class="hero">
	<div class="hero__inner">
		<div class="hero__lede">
			<h1 class="type-title">{title}</h1>
			<p class="type-subtitle hero__dek">{dek}</p>

			{
				(actions.primary || actions.secondary) && (
					<div class="hero__actions">
						{actions.primary && (
							<a class="btn btn--primary" href={actions.primary.href}>
								<span>{actions.primary.label}</span>
								<svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
									<circle cx="10" cy="10" r="8" />
									<path d="M8.5 7l4 3-4 3V7z" fill="currentColor" stroke="none" />
								</svg>
							</a>
						)}
						{actions.secondary && (
							<a class="btn btn--secondary" href={actions.secondary.href}>
								<span>{actions.secondary.label}</span>
								<svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
									<path d="M10 4v12M5 11l5 5 5-5" />
								</svg>
							</a>
						)}
					</div>
				)
			}
		</div>

		{
			facts.length > 0 && (
				<dl class="facts">
					{facts.map((f) => (
						<div class="facts__item">
							<dt class="type-overline">{f.label}</dt>
							<dd class="type-body facts__value">{f.value}</dd>
						</div>
					))}
				</dl>
			)
		}
	</div>

	{
		hero && (
			<div class="hero__compare">
				<figure class="compare__panel">
					<Image src={hero.before} alt={hero.beforeAlt} widths={[640, 960, 1280]} sizes="(min-width: 900px) 50vw, 100vw" />
					<figcaption class="compare__tag">Before</figcaption>
				</figure>
				<figure class="compare__panel">
					<Image src={hero.after} alt={hero.afterAlt} widths={[640, 960, 1280]} sizes="(min-width: 900px) 50vw, 100vw" />
					<figcaption class="compare__tag">After</figcaption>
				</figure>
			</div>
		)
	}
</header>

<style>
	.hero__inner {
		max-width: var(--measure-page);
		margin: 0 auto;
		padding: var(--spacing-9xl) var(--gutter) var(--spacing-7xl);
		display: grid;
		gap: var(--spacing-6xl);
	}

	/* Desktop puts the facts in a right rail; mobile drops them under the dek
	   as a divided strip, which is why they are a separate grid child rather
	   than living inside .hero__lede. */
	@media (min-width: 60rem) {
		.hero__inner {
			grid-template-columns: minmax(0, 1fr) 20rem;
			gap: var(--spacing-8xl);
			align-items: start;
		}
	}

	.hero__lede {
		display: grid;
		gap: var(--spacing-2xl);
	}

	h1 {
		color: var(--text);
		max-width: 18ch;
	}

	.hero__dek {
		color: var(--text-body);
		max-width: 46ch;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-lg);
		margin-top: var(--spacing-xl);
	}

	/* ---- facts ---- */
	.facts {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-block: 1px solid var(--border);
	}

	.facts__item {
		padding: var(--spacing-xl) var(--spacing-lg);
		text-align: center;
		border-inline-start: 1px solid var(--border);
	}
	.facts__item:first-child {
		border-inline-start: 0;
	}

	.facts__value {
		margin: var(--spacing-xs) 0 0;
		color: var(--text-body);
	}

	@media (min-width: 60rem) {
		.facts {
			grid-template-columns: 1fr;
			border-block: 0;
			text-align: right;
		}
		.facts__item {
			padding: var(--spacing-xl) 0;
			text-align: right;
			border-inline-start: 0;
			border-block-start: 1px solid var(--border);
		}
		.facts__item:first-child {
			padding-block-start: 0;
			border-block-start: 0;
		}
	}

	/* ---- before / after ---- */
	.hero__compare {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-md);
		background: var(--bg-sunken);
	}

	.compare__panel {
		position: relative;
		margin: 0;
		min-width: 0;
		overflow: hidden;
	}

	.compare__panel :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	/* The label sits over the image, so it needs its own ground rather than
	   relying on whatever pixels happen to be underneath. */
	.compare__tag {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		transform: translate(-50%, -50%);
		font-family: var(--font-display);
		font-weight: var(--weight-bold);
		font-size: var(--size-subtitle);
		line-height: var(--lh-subtitle);
		color: var(--gray-50);
		background: color-mix(in srgb, var(--gray-900) 72%, transparent);
		padding: var(--spacing-md) var(--spacing-xl);
		border-radius: var(--radius-xs);
	}
</style>
