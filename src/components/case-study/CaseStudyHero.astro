---
interface Action {
	label: string;
	href: string;
	variant?: 'primary' | 'secondary';
	icon?: 'play' | 'down';
}

interface Props {
	title: string;
	dek?: string;
	meta?: { label: string; value: string }[];
	actions?: Action[];
	/** 'showcase-first' lifts the opener above the lede and lets it lead the page */
	layout?: 'lede-first' | 'showcase-first';
}

const { title, dek, meta = [], actions = [], layout = 'lede-first' } = Astro.props;
---

<header class:list={['hero', `hero--${layout}`]}>
	<div class="page hero__grid">
		<div class="hero__lede">
			<h1 class="hero__title">{title}</h1>
			{dek && <p class="hero__dek">{dek}</p>}

			{
				actions.length > 0 && (
					<div class="hero__actions">
						{actions.map((action) => (
							<a
								href={action.href}
								class:list={['btn', `btn--${action.variant ?? 'secondary'}`]}
							>
								{action.label}
								{action.icon === 'play' && (
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
										<circle cx="12" cy="12" r="9" />
										<path d="M10.4 8.6v6.8L16 12z" fill="currentColor" stroke="none" />
									</svg>
								)}
								{action.icon === 'down' && (
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M12 5v14M6 13l6 6 6-6" />
									</svg>
								)}
							</a>
						))}
					</div>
				)
			}
		</div>

		{
			meta.length > 0 && (
				<dl class="hero__meta">
					{meta.map((item) => (
						<div class="hero__meta-item">
							<dt>{item.label}</dt>
							<dd>{item.value}</dd>
						</div>
					))}
				</dl>
			)
		}
	</div>

	<div class="hero__showcase"><slot name="showcase" /></div>
</header>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		padding-block-start: var(--s-fluid-3);
	}

	/* The opener leads the page: it sits flush against the top edge, and the lede
	   reads as a dark band under it rather than as a headline above a picture. */
	.hero--showcase-first {
		padding-block-start: 0;
	}

	.hero--showcase-first .hero__showcase {
		order: -1;
	}

	.hero--showcase-first .hero__grid {
		padding-block: var(--s-fluid-3) var(--s-fluid-3);
	}

	/* Nothing above it competes for the line length any more, so the dek runs the
	   full width of its column and lands in two lines rather than three. */
	.hero--showcase-first .hero__dek {
		max-width: none;
	}

	.hero__grid {
		display: grid;
		gap: var(--s-fluid-2);
		padding-block-end: var(--s-fluid-3);
	}

	.hero__title {
		font-family: var(--f-display);
		font-size: var(--t-display);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-tight);
		letter-spacing: -0.005em;
		color: var(--c-text);
		text-wrap: pretty;
	}

	.hero__dek {
		margin-block-start: var(--s-4);
		font-size: var(--t-dek);
		line-height: var(--lh-snug);
		color: var(--c-text-body);
		max-width: 34ch;
		text-wrap: pretty;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
		margin-block-start: var(--s-block);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: var(--s-3);
		padding: var(--s-3) var(--s-5);
		border-radius: var(--radius);
		font-size: var(--t-meta);
		font-weight: var(--fw-bold);
		text-decoration: none;
		transition:
			background-color 0.18s var(--e-out),
			transform 0.18s var(--e-out);
	}

	.btn:hover {
		transform: translateY(-1px);
	}

	.btn--primary {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		color: var(--c-on-primary);
		background-image:
			linear-gradient(
				180deg,
				#f59a28 0%,
				var(--c-primary-hover) 42%,
				#d97408 100%
			),
			linear-gradient(
				180deg,
				#e88814 0%,
				var(--c-primary) 42%,
				#c86500 100%
			);
		background-size: 100% 0%, 100% 100%;
		background-position: center bottom, center top;
		background-repeat: no-repeat;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.24),
			inset 0 9px 14px -5px rgb(0 0 0 / 0.38),
			inset 0 -9px 14px -5px rgb(0 0 0 / 0.38);
		transition:
			background-size 0.55s var(--e-out),
			transform 0.18s var(--e-out);
	}

	.btn--primary:hover {
		background-size: 100% 100%, 100% 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		.btn--primary {
			background-size: 100% 100%, 100% 100%;
			transition:
				background-size 0.01ms,
				transform 0.18s var(--e-out);
		}
	}

	.btn--secondary {
		background: var(--c-surface-invert);
		color: var(--c-on-invert);
	}

	.btn--secondary:hover {
		background: var(--c-surface-invert-hover);
	}

	.hero__meta {
		display: flex;
		flex-direction: column;
		gap: var(--s-4);
		margin: 0;
	}

	.hero__meta-item + .hero__meta-item {
		padding-block-start: var(--s-4);
		border-block-start: 1px solid var(--c-line-strong);
	}

	.hero__meta dt {
		font-family: var(--f-mono);
		font-size: var(--t-small);
		font-weight: var(--fw-bold);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--c-text-muted);
	}

	.hero__meta dd {
		margin: var(--s-1) 0 0;
		font-size: var(--t-dek);
		color: var(--c-text);
	}

	@media (min-width: 900px) {
		.hero__grid {
			grid-template-columns: minmax(0, 1fr) minmax(14rem, 22rem);
			align-items: start;
		}

		.hero__meta {
			text-align: right;
			padding-block-start: var(--s-2);
		}
	}
</style>
