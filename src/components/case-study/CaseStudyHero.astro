---
import { getImage } from 'astro:assets';
import BeforeAfter from './BeforeAfter';
import Icon from '../ui/Icon.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	dek: string;
	facts?: { label: string; value: string }[];
	actions?: {
		primary?: { label: string; href: string };
		secondary?: { label: string; href: string };
	};
	hero?: {
		before: ImageMetadata;
		after: ImageMetadata;
		beforeAlt: string;
		afterAlt: string;
		beforeLabel?: string;
		afterLabel?: string;
		beforeNotes?: { x: number; y: number; text: string }[];
		afterNotes?: { x: number; y: number; text: string }[];
	};
}

const { title, dek, facts = [], actions = {}, hero } = Astro.props;
const beforeLabel = hero?.beforeLabel ?? 'Before';
const afterLabel = hero?.afterLabel ?? 'After';
const beforeNotes = hero?.beforeNotes ?? [];
const afterNotes = hero?.afterNotes ?? [];

// The island takes plain src/srcSet strings, so the responsive set has to be
// resolved here — <Image> cannot do it inside a React component.
const shotWidths = [720, 1080, 1440, 1920];
const [before, after] = hero
	? await Promise.all([
			getImage({ src: hero.before, widths: shotWidths, format: 'webp', quality: 82 }),
			getImage({ src: hero.after, widths: shotWidths, format: 'webp', quality: 82 }),
		])
	: [];

// Mirrors .hero__compare's own max-width formula below (min(measure, 100%) −
// 2×gutter) in resolved units, since `sizes` cannot read custom properties —
// it is evaluated before the stylesheet that defines them is available. Errs
// slightly wide rather than narrow, so a mismatch costs a few kB, not blur.
const compareSizes = '(min-width: 100rem) 83.875rem, calc(100vw - 8vw)';
---

<header class="hero">
	<div class="hero__inner">
		<div class="hero__lede">
			<h1 class="type-title">{title}</h1>
			<p class="type-subtitle hero__dek">{dek}</p>

			{
				(actions.primary || actions.secondary) && (
					<div class="hero__actions">
						{actions.primary && (
							<a class="btn btn--primary" href={actions.primary.href}>
								<span>{actions.primary.label}</span>
								<Icon name="play" />
							</a>
						)}
						{actions.secondary && (
							<a class="btn btn--secondary" href={actions.secondary.href}>
								<span>{actions.secondary.label}</span>
								<Icon name="arrow-down" />
							</a>
						)}
					</div>
				)
			}
		</div>

		{
			facts.length > 0 && (
				<dl class="facts">
					{facts.map((f) => (
						<div class="facts__item">
							<dt class="type-overline">{f.label}</dt>
							<dd class="type-body facts__value">{f.value}</dd>
						</div>
					))}
				</dl>
			)
		}
	</div>

	{
		hero && before && after && (
			<div class="hero__compare">
				<BeforeAfter
					client:load
					before={{
						src: before.src,
						srcSet: before.srcSet.attribute,
						sizes: compareSizes,
						width: hero.before.width,
						height: hero.before.height,
						alt: hero.beforeAlt,
					}}
					after={{
						src: after.src,
						srcSet: after.srcSet.attribute,
						sizes: compareSizes,
						width: hero.after.width,
						height: hero.after.height,
						alt: hero.afterAlt,
					}}
					beforeLabel={beforeLabel}
					afterLabel={afterLabel}
					beforeNotes={beforeNotes}
					afterNotes={afterNotes}
					ratio={hero.after.width / hero.after.height}
				/>

				{/* The pins and the panel they open are aria-hidden inside the
				    island — they are a drag affordance, and at rest both sides'
				    text is in the DOM at once, which would read as duplicated
				    nonsense. This is the same content, once, in reading order.
				    Same labels as the island above, not restated literally, so
				    the two representations cannot drift apart. */}
				<div class="ba-notes sr-only">
					{beforeNotes.length > 0 && (
						<div class="ba-notes__group">
							<h2 class="type-overline">{beforeLabel}</h2>
							<ol>{beforeNotes.map((n) => <li>{n.text}</li>)}</ol>
						</div>
					)}
					{afterNotes.length > 0 && (
						<div class="ba-notes__group">
							<h2 class="type-overline">{afterLabel}</h2>
							<ol>{afterNotes.map((n) => <li>{n.text}</li>)}</ol>
						</div>
					)}
				</div>
			</div>
		)
	}
</header>

<style>
	.hero__inner {
		max-width: var(--measure-page);
		margin: 0 auto;
		padding: var(--spacing-9xl) var(--gutter) var(--spacing-7xl);
		display: grid;
		gap: var(--spacing-6xl);
	}

	/* Desktop puts the facts in a right rail; mobile drops them under the dek
	   as a divided strip, which is why they are a separate grid child rather
	   than living inside .hero__lede. */
	@media (min-width: 60rem) {
		.hero__inner {
			grid-template-columns: minmax(0, 1fr) 20rem;
			gap: var(--spacing-8xl);
			/* Deliberately not `align-items: start`. The rail has to stretch to
			   the row height, or its entries cannot sit flush with the top and
			   bottom of the column beside them. */
		}
	}

	.hero__lede {
		display: grid;
		gap: var(--spacing-2xl);
	}

	/* No measure cap: the column is already bounded by --measure-page and the
	   facts rail beside it, and the reference sets both to the full width of
	   that column. Capping them again left a ragged void on the right. */
	h1 {
		color: var(--text);
	}

	.hero__dek {
		color: var(--text-body);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-lg);
		margin-top: var(--spacing-xl);
	}

	/* ---- facts ---- */
	.facts {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-block: 1px solid var(--border);
	}

	.facts__item {
		padding: var(--spacing-xl) var(--spacing-lg);
		text-align: center;
		border-inline-start: 1px solid var(--border);
	}
	.facts__item:first-child {
		border-inline-start: 0;
	}

	.facts__value {
		margin: var(--spacing-xs) 0 0;
		color: var(--text-body);
	}

	@media (min-width: 60rem) {
		/* Equal thirds down the full height, so the dividers land on exact
		   thirds and the block reads as one measured column rather than a
		   stack that happens to start at the top. */
		.facts {
			display: flex;
			flex-direction: column;
			border-block: 0;
			text-align: right;
		}

		/* No padding on the item. With border-box, a flex-basis:0 item is still
		   floored at its own padding, and the middle one pads on both sides
		   where the outer two pad on one — which pulled the thirds to 91/108/92
		   and put the dividers 6px off. With the padding gone all three floor
		   at zero and grow equally; the breathing room around each entry comes
		   from the third being taller than its content. */
		.facts__item {
			flex: 1;
			min-height: 0;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding: 0;
			text-align: right;
			border-inline-start: 0;
			border-block-start: 1px solid var(--border);
		}

		/* First and last hug the edges so the rail is flush top and bottom with
		   the lede column; the middle one centres in its own third. */
		.facts__item:first-child {
			justify-content: flex-start;
			border-block-start: 0;
		}
		.facts__item:last-child {
			justify-content: flex-end;
		}
	}

	/* ---- before / after ----
	   Aligned to .hero__inner, the same container the lede and facts sit
	   inside — the frame's edges match the outer column, so the hero reads as
	   one block rather than a wide picture with a narrower page bolted on.
	   That is edge-for-edge with .hero__lede only when there is no facts
	   rail; with one, the lede occupies just the minmax(0,1fr) track beside
	   it and its own right edge sits short of the frame's. The island sets
	   its own aspect ratio, so this only has to give it the width.

	   The cap is measured off the column rather than restating a fixed number,
	   so it holds below --measure-page too, where the column is the viewport
	   less its gutters.

	   No background here: the island carries its own, and a sunken band exactly
	   the width of the frame would do nothing but show square corners behind
	   the frame's rounded ones. */
	.hero__compare {
		max-width: calc(min(var(--measure-page), 100%) - 2 * var(--gutter));
		margin-inline: auto;
		/* The chapter rail follows immediately and is sticky, so it needs
		   clearing rather than butting against the frame. */
		margin-block-end: var(--spacing-4xl);
	}
</style>
