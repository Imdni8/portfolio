---
/**
 * Problem / Code-contribution text shape for the 30-second-skimmable case
 * study cut: a heading, optional blockquote "highlight", prose, and an
 * optional image beside it. Styled with plain Tailwind utilities and
 * Tailwind's stock palette, deliberately not tokens.css — a scoped exception
 * for this one new text treatment, not a sitewide migration. See
 * StorySection in CLAUDE.md's case-studies section for the reasoning.
 */
import { storyProse } from './story-type';

interface Props {
	heading: string;
	/** Renders a top rule before the heading — used once, on Problem, to
	 *  separate the section from the hero above it. */
	divider?: boolean;
	/** Default is 5fr/7fr, copy narrower than the shot (Problem, Code
	 *  contribution). Set true for an even 50/50 split when the visual doesn't
	 *  need the extra room — e.g. a portrait-ish screenshot next to a claim
	 *  that's mostly text. */
	evenColumns?: boolean;
}
const { heading, divider = false, evenColumns = false } = Astro.props;
const hasVisual = Astro.slots.has('visual');
---

<section class="mx-auto max-w-[var(--measure-story)] px-[var(--gutter)] py-20">
	{divider && <hr class="mb-20 border-t border-neutral-800" />}
	<h2 class="mb-6 font-['Playfair_Display_Variable'] text-3xl leading-10 font-semibold text-white">
		{heading}
	</h2>
	{/* With a visual the copy takes the narrower of two columns and the shot
	    sits beside it, top-aligned with the blockquote — so the reader gets the
	    claim and the evidence for it in one glance instead of one scroll.
	    Without a visual there is nothing to sit beside and the copy runs the
	    section's full measure, uncapped: the same "don't narrow a column that
	    has nothing next to it" rule Section.astro and the hero follow. */}
	<div
		class:list={[
			'grid gap-10',
			hasVisual && (evenColumns ? 'lg:grid-cols-2 lg:items-start' : 'lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start'),
		]}
	>
		<div class={storyProse}>
			<slot />
		</div>
		{hasVisual && <slot name="visual" />}
	</div>
</section>
