---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	/** Optional high-resolution file for the lightbox. */
	zoomSrc?: ImageMetadata;
}

const { src, alt, caption, zoomSrc } = Astro.props;
const full = zoomSrc ?? src;
---

<figure class="figure">
	<button
		type="button"
		class="figure__zoom"
		data-zoom={full.src}
		data-zoom-alt={alt}
		aria-label={`Enlarge: ${alt}`}
	>
		<Image src={src} alt={alt} widths={[480, 760, 1120]} sizes="(min-width: 60rem) 46vw, 92vw" />
	</button>
	{caption && <figcaption class="type-annotation">{caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 0;
		display: grid;
		gap: var(--spacing-md);
		min-width: 0;
	}

	/* A button, not a div — click-to-enlarge has to be reachable by keyboard,
	   and a button gets that plus the right role for free. */
	.figure__zoom {
		appearance: none;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--bg-media);
		overflow: hidden;
		cursor: zoom-in;
		display: block;
		width: 100%;
	}

	.figure__zoom:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}

	.figure__zoom :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		color: var(--text-muted);
	}
</style>
