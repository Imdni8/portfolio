---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	/** Optional high-resolution file for the lightbox. */
	zoomSrc?: ImageMetadata;
}

const { src, alt, caption, zoomSrc } = Astro.props;
const full = zoomSrc ?? src;

/** A cropped-down toolbar strip or letterboxed screenshot reads as a sliver
    once squeezed into one column of a FigureRow — 3.5 sits comfortably
    above a normal app screenshot's ratio (~1.5–2.9 across this site) and
    below where these actually land (~4.5–4.8). FigureRow spans a figure
    carrying this across every column of its row when it's set, so it gets
    a full-width row of its own instead of a cramped, illegible column. */
const isWide = src.width / src.height >= 3.5;
---

<figure class="figure" data-wide={isWide || undefined}>
	<button
		type="button"
		class="figure__zoom"
		data-zoom={full.src}
		data-zoom-alt={alt}
		data-zoom-caption={caption}
		aria-label={`Enlarge: ${alt}`}
	>
		<Image src={src} alt={alt} widths={[480, 760, 1120]} sizes="(min-width: 60rem) 46vw, 92vw" />
	</button>
	{caption && <figcaption class="type-annotation">{caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 0;
		display: grid;
		gap: var(--spacing-md);
		min-width: 0;
	}

	/* A button, not a div — click-to-enlarge has to be reachable by keyboard,
	   and a button gets that plus the right role for free. */
	.figure__zoom {
		appearance: none;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--bg-media);
		overflow: hidden;
		cursor: zoom-in;
		display: block;
		width: 100%;
	}

	.figure__zoom:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}

	.figure__zoom :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		color: var(--text-muted);
	}
</style>
