---
/**
 * One row inside a <StoryChapter>: an optional Playfair title across the
 * width, then the shot on the left and the copy on the right.
 *
 * `title` is optional because a row is not always named by a heading — where
 * the shot's own caption already names it ("Direction 1: Global chat"), a
 * title above the copy would say it twice, in two places, at two rungs. The
 * row still reads as one because the grid and the step below are unchanged.
 *
 * Two things are deliberately the reverse of StorySection, which is why this
 * is a component rather than a prop on that one:
 *
 * - the visual leads (left), the copy follows — in the 30-second cut the copy
 *   leads and the shot supports it; here the shot is the finding and the copy
 *   explains it
 * - the split is even, not 5fr/7fr
 *
 * The `visual` slot takes more than one child: the dependency-card block puts
 * a <NoteBox> under its <Figure> in the same column, authored as two siblings
 * both carrying slot="visual".
 */
import { storyProse, storyHeading } from './story-type';

interface Props {
	title?: string;
}
const { title } = Astro.props;
---

<div>
	{
		title && (
			<h3 class:list={['mb-4 text-lg leading-6', storyHeading]}>
				{title}
			</h3>
		)
	}
	{/* items-start so a short copy column doesn't stretch to a tall shot's
	    height, and gap-12 to match the 48px the design puts between them. */}
	<div class="grid gap-12 lg:grid-cols-2 lg:items-start">
		{/* data-zoom-group is what makes two stacked shots open in the lightbox
		    as one steppable pair — see Lightbox.tsx. It is a behaviour hook
		    only: unlike FigureRow, which is also a *layout* (equal columns,
		    subgrid captions), this column stays a stack. */}
		<div class="grid content-start gap-6" data-zoom-group>
			<slot name="visual" />
		</div>
		<div class={storyProse}>
			<slot />
		</div>
	</div>
</div>
