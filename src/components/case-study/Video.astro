---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';

interface Props {
	/** Shown under the overlay until the video is played. */
	poster: ImageMetadata;
	src: string;
	alt: string;
}
const { poster, src, alt } = Astro.props;
---

{/* The <video> is not in the DOM until the poster is clicked (VideoPlayer.tsx
    swaps it in), so a page with a film on it costs nothing to load for a
    reader who never plays it. Shared by every video in a case study, so the
    frame, overlay and play button can't drift between them. */}
<div class="video__frame" data-video={src} data-video-label={alt}>
	<Image src={poster} alt={alt} widths={[760, 1120, 1470]} sizes="(min-width: 60rem) 92vw, 100vw" />
	<div class="video__overlay" aria-hidden="true"></div>
	<button type="button" class="icon-btn icon-btn--primary icon-btn--lg video__play" aria-label={`Play: ${alt}`}>
		<Icon name="play" />
	</button>
</div>

<style>
	.video__frame {
		position: relative;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--bg-media);
	}

	.video__frame :global(img),
	.video__frame :global(video) {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Flat wash over the whole poster so the button reads clearly wherever
	   it lands — a product screenshot is light in both themes, and the
	   button alone didn't have enough contrast against a busy one.
	   --overlay, same theme-invariant scrim WorkCard's coming-soon cover
	   uses (components.css), since this too rides on a photo rather than
	   the page ground. Between the image and the button in markup so it
	   paints over the former and under the latter without a z-index. */
	.video__overlay {
		position: absolute;
		inset: 0;
		background: var(--overlay);
	}

	/* Shape, colour and size come from .icon-btn--primary.icon-btn--lg; this
	   is only the centring over the poster. */
	.video__play {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		transform: translate(-50%, -50%);
	}
</style>
