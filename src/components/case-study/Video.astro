---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';
import { buttonVariants } from '../ui/button';

interface Props {
	/** Shown until the video is played. */
	poster: ImageMetadata;
	src: string;
	alt: string;
}
const { poster, src, alt } = Astro.props;
---

{/* The <video> is not in the DOM until the poster is clicked (VideoPlayer.tsx
    swaps it in), so a page with a film on it costs nothing to load for a
    reader who never plays it. Shared by every video in a case study, so the
    frame and play button can't drift between them. */}
<div class="video-frame" data-video={src} data-video-label={alt}>
	<Image src={poster} alt={alt} widths={[760, 1120, 1470]} sizes="(min-width: 60rem) 92vw, 100vw" />
	<button
		type="button"
		class:list={[buttonVariants({ size: 'icon-lg' }), 'video-frame__play']}
		aria-label={`Play: ${alt}`}
	>
		<Icon name="play" />
	</button>
</div>

<style>
	.video-frame {
		position: relative;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--bg-media);
	}

	.video-frame :global(img),
	.video-frame :global(video) {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Shape, colour and size come from buttonVariants({ size: 'icon-lg' });
	   this is only the centring over the poster. */
	.video-frame__play {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		transform: translate(-50%, -50%);
	}
</style>
