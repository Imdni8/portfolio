---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';

interface Props {
	poster: ImageMetadata;
	src: string;
	alt: string;
	caption?: string;
}
const { poster, src, alt, caption } = Astro.props;
---

<figure class="video">
	{/* The <video> is not in the DOM until the poster is clicked, so a page with
	    a film on it costs nothing to load for a reader who never plays it. */}
	<div class="video__frame" data-video={src} data-video-label={alt}>
		<Image src={poster} alt={alt} widths={[760, 1120, 1470]} sizes="(min-width: 60rem) 92vw, 100vw" />
		<button type="button" class="icon-btn icon-btn--primary icon-btn--lg video__play" aria-label={`Play: ${alt}`}>
			<Icon name="play" />
		</button>
	</div>
	{caption && <figcaption class="type-annotation">{caption}</figcaption>}
</figure>

<style>
	.video {
		margin: 0;
		display: grid;
		gap: var(--spacing-md);
	}

	.video__frame {
		position: relative;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--bg-media);
	}

	.video__frame :global(img),
	.video__frame :global(video) {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Shape, colour and size come from .icon-btn--primary.icon-btn--lg; this
	   is only the centring over the poster. */
	.video__play {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		transform: translate(-50%, -50%);
	}

	figcaption {
		color: var(--text-muted);
	}
</style>
