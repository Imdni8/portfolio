---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	poster: ImageMetadata;
	src: string;
	alt: string;
	caption?: string;
}
const { poster, src, alt, caption } = Astro.props;
---

<figure class="video">
	{/* The <video> is not in the DOM until the poster is clicked, so a page with
	    a film on it costs nothing to load for a reader who never plays it. */}
	<div class="video__frame" data-video={src} data-video-label={alt}>
		<Image src={poster} alt={alt} widths={[760, 1120, 1470]} sizes="(min-width: 60rem) 92vw, 100vw" />
		<button type="button" class="video__play" aria-label={`Play: ${alt}`}>
			<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
				<path d="M9 7.5v9l7.5-4.5z" />
			</svg>
		</button>
	</div>
	{caption && <figcaption class="type-annotation">{caption}</figcaption>}
</figure>

<style>
	.video {
		margin: 0;
		display: grid;
		gap: var(--spacing-md);
	}

	.video__frame {
		position: relative;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--bg-sunken);
	}

	.video__frame :global(img),
	.video__frame :global(video) {
		display: block;
		width: 100%;
		height: auto;
	}

	.video__play {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		transform: translate(-50%, -50%);
		width: var(--spacing-6xl);
		height: var(--spacing-6xl);
		display: grid;
		place-items: center;
		border: 0;
		border-radius: var(--radius-full);
		background: var(--primary);
		color: var(--text-on-primary);
		cursor: pointer;
		transition: background-color 120ms ease, transform 120ms ease;
	}

	.video__play:hover {
		background: var(--primary-hover);
	}

	.video__play:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 3px;
	}

	.video__play svg {
		width: 55%;
		height: 55%;
	}

	figcaption {
		color: var(--text-muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.video__play {
			transition: none;
		}
	}
</style>
