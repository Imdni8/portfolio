---
import type { ImageMetadata } from 'astro';
import Video from './Video.astro';

interface Props {
	poster: ImageMetadata;
	src: string;
	alt: string;
	caption?: string;
}
const { poster, src, alt, caption } = Astro.props;
---

<figure class="video-figure">
	<Video poster={poster} src={src} alt={alt} />
	{caption && <figcaption class="type-annotation">{caption}</figcaption>}
</figure>

<style>
	.video-figure {
		margin: 0;
		display: grid;
		gap: var(--spacing-md);
	}

	figcaption {
		color: var(--text-muted);
	}
</style>
