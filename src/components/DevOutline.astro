---
/**
 * Alignment tooling. Two independent overlays:
 *
 *   ?outline  / alt+O   outline every element, coloured by tag, each numbered
 *   ?guides   / alt+G   draw the page frame — gutters, measure, column split
 *
 * `outline` is the Storybook addon's trick: it uses `outline`, never `border`,
 * because outline is drawn outside the box and takes no space. A border would
 * add 2px to every element and shift the very edges you are trying to check.
 *
 * Numbers are stable — assigned once, in the order an element is first seen —
 * so "box 74 is off" means the same box on both screens. Badges are drawn
 * only for elements currently on screen; several hundred at once is
 * unreadable, and positioning them all every frame is wasted work.
 *
 * TWO RULES THIS FILE HAS TO OBEY, both learned the hard way:
 *
 * 1. Never write to the DOM being measured. An earlier version stamped
 *    `data-dev-n` on every element at DOMContentLoaded — before React
 *    hydrated. React found attributes its virtual DOM did not have, reported
 *    hydration mismatches, and re-rendered those subtrees, which threw away
 *    the very nodes being observed. Numbers now live in a Map. The badge
 *    layer is the one thing this tool does append, and it lives beside the
 *    page's own tree, not inside it.
 * 2. Style the overlay inline. It is injected into a page whose stylesheet it
 *    does not control, and it must not depend on its own CSS surviving the
 *    build. Inline styles cannot be scoped away, overridden, or stripped.
 *
 * Both modes persist in sessionStorage, so they survive clicking between pages.
 *
 * Ships inert in production so it also works against `npm run preview` and
 * any deployed build — but only if its call site wraps it in
 * `import.meta.env.DEV`. This component does not guard itself.
 */
---

<script is:inline>
	(() => {
		const MODES = { outline: 'dev-outline', guides: 'dev-guides' };
		const root = document.documentElement;
		const params = new URLSearchParams(location.search);

		for (const [name, key] of Object.entries(MODES)) {
			const asked = params.has(name) ? params.get(name) !== 'off' : null;
			const on = asked ?? sessionStorage.getItem(key) === '1';
			root.toggleAttribute(`data-${name}`, on);
			if (asked !== null) sessionStorage.setItem(key, on ? '1' : '0');
		}

		// Block-level things only. Numbering every <span> and <code> buries the
		// structure you are actually trying to line up — the CSS block below
		// still outlines those inline elements, it just never numbers them.
		//
		// SELECTOR and hueFor() are both derived from GROUPS, so a tag's colour
		// only has to change in one place. The CSS block further down is the one
		// copy this can't reach (outline rules have to exist whether or not the
		// script has run yet) — its per-tag colours must be kept in step with
		// GROUPS by hand for every tag the two lists share.
		const GROUPS = [
			{ tags: ['main', 'header', 'footer', 'section', 'article', 'aside', 'nav'], hue: '#3498db' },
			{ tags: ['div'], hue: '#e74c3c' },
			{ tags: ['h1', 'h2', 'h3', 'h4'], hue: '#27ae60' },
			{ tags: ['ul', 'ol', 'dl'], hue: '#16a085' },
			{ tags: ['img', 'video', 'figure', 'figcaption'], hue: '#f39c12' },
			{ tags: ['button', 'a'], hue: '#e91e63' },
		];
		const SELECTOR = GROUPS.flatMap((g) => g.tags).join(',');
		const HUE_BY_TAG = new Map(GROUPS.flatMap((g) => g.tags.map((t) => [t, g.hue])));
		const hueFor = (el) => HUE_BY_TAG.get(el.tagName.toLowerCase()) ?? '#2ecc71';

		let layer = null;
		let observer = null; // IntersectionObserver: which numbered elements are on screen
		let watcher = null; // MutationObserver: numbers elements added after the initial scan
		const numbers = new Map(); // element -> stable index, never touches the DOM
		const badges = new Map(); // element -> its persistent badge <span>, repositioned in place
		const onScreen = new Set();
		let n = 0;
		let frame = 0;

		// Shared by the initial scan and the MutationObserver below, so an
		// element gets exactly one number however it was first seen.
		const register = (el) => {
			if (numbers.has(el) || el === layer || layer.contains(el)) return;
			numbers.set(el, ++n);
			observer.observe(el);
		};

		const badgeFor = (el) => {
			let badge = badges.get(el);
			if (!badge) {
				badge = document.createElement('span');
				badge.style.cssText =
					'position:absolute;font:700 9px/1 ui-monospace,SFMono-Regular,monospace;color:#fff;' +
					'padding:1px 3px;border-radius:0 0 3px 0;';
				badge.style.background = hueFor(el);
				badge.textContent = String(numbers.get(el));
				layer.append(badge);
				badges.set(el, badge);
			}
			return badge;
		};

		const draw = () => {
			frame = 0;
			if (!layer) return;

			for (const [el, badge] of badges) {
				if (!onScreen.has(el)) badge.style.display = 'none';
			}

			// Elements scrolled above the viewport all clamp to the same top
			// edge; stack them going down instead of letting their badges pile
			// on the exact same pixel.
			let stackedAtTop = 0;
			for (const el of onScreen) {
				const r = el.getBoundingClientRect();
				if (r.width < 14 || r.height < 10) {
					// Too small to label usefully — and may have shrunk below this
					// threshold since its badge was created, so hide any stale one.
					badges.get(el)?.style.setProperty('display', 'none');
					continue;
				}
				const top = r.top >= 0 ? r.top : stackedAtTop;
				if (r.top < 0) stackedAtTop += 14;
				const badge = badgeFor(el);
				badge.style.display = '';
				badge.style.left = `${Math.max(0, r.left)}px`;
				badge.style.top = `${top}px`;
			}
		};
		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(draw);
		};

		const enable = () => {
			if (layer) return;
			layer = document.createElement('div');
			layer.setAttribute('data-dev-layer', '');
			layer.style.cssText = 'position:fixed;inset:0;z-index:10000;pointer-events:none;outline:0';
			document.body.append(layer);

			numbers.clear();
			badges.clear();
			n = 0;
			observer = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) onScreen.add(e.target);
						else onScreen.delete(e.target);
					}
					schedule();
				},
				{ threshold: 0 }
			);
			for (const el of document.querySelectorAll(SELECTOR)) register(el);

			// client:idle islands (Lightbox, Glossary, VideoPlayer) can render DOM
			// after this scan runs — watch for it so an element added later still
			// gets a number, not just the CSS outline.
			watcher = new MutationObserver((mutations) => {
				for (const m of mutations) {
					for (const node of m.addedNodes) {
						if (!(node instanceof Element) || node === layer || layer.contains(node)) continue;
						if (node.matches(SELECTOR)) register(node);
						for (const el of node.querySelectorAll(SELECTOR)) register(el);
					}
				}
			});
			watcher.observe(document.body, { childList: true, subtree: true });

			addEventListener('scroll', schedule, { passive: true });
			addEventListener('resize', schedule, { passive: true });
		};

		const disable = () => {
			observer?.disconnect();
			observer = null;
			watcher?.disconnect();
			watcher = null;
			onScreen.clear();
			numbers.clear();
			badges.clear();
			layer?.remove();
			layer = null;
			removeEventListener('scroll', schedule);
			removeEventListener('resize', schedule);
		};

		const sync = () => (root.hasAttribute('data-outline') ? enable() : disable());

		// `load`, not DOMContentLoaded: client:load islands hydrate before it, so
		// the elements scanned here are the ones React has settled on. Scanning
		// earlier would observe nodes React is about to replace.
		if (document.readyState === 'complete') sync();
		else addEventListener('load', sync, { once: true });

		addEventListener('keydown', (e) => {
			if (!e.altKey || e.metaKey || e.ctrlKey) return;
			const name = e.code === 'KeyO' ? 'outline' : e.code === 'KeyG' ? 'guides' : null;
			if (!name) return;
			e.preventDefault();
			const on = !root.hasAttribute(`data-${name}`);
			root.toggleAttribute(`data-${name}`, on);
			sessionStorage.setItem(MODES[name], on ? '1' : '0');
			if (name === 'outline') {
				// Re-scan on every enable, so numbering reflects the DOM as it is
				// now rather than as it was at load.
				if (on) {
					disable();
					enable();
				} else {
					disable();
				}
			}
		});
	})();
</script>

<style is:global>
	/* Hues are deliberately foreign to the palette — nothing here should be
	   mistakable for a design decision. Structure blue, divs red, text green,
	   headings darker green, lists teal, media orange, controls pink.

	   Colours below must match GROUPS' hues in the script above for every tag
	   the two lists share. This block additionally outlines inline elements
	   (span, li, dt, dd, code, svg, picture, input, label) that the script
	   deliberately never numbers — see the SELECTOR comment above. */
	[data-outline] body {
		outline: 1px solid #2980b9 !important;
	}
	[data-outline] main,
	[data-outline] header,
	[data-outline] footer,
	[data-outline] section,
	[data-outline] article,
	[data-outline] aside,
	[data-outline] nav {
		outline: 1px solid #3498db !important;
	}
	[data-outline] div:not([data-dev-layer]) {
		outline: 1px solid #e74c3c !important;
	}
	[data-outline] p,
	[data-outline] span,
	[data-outline] li,
	[data-outline] dt,
	[data-outline] dd,
	[data-outline] code {
		outline: 1px solid #2ecc71 !important;
	}
	[data-outline] h1,
	[data-outline] h2,
	[data-outline] h3,
	[data-outline] h4 {
		outline: 1px solid #27ae60 !important;
	}
	[data-outline] ul,
	[data-outline] ol,
	[data-outline] dl {
		outline: 1px solid #16a085 !important;
	}
	[data-outline] img,
	[data-outline] svg,
	[data-outline] video,
	[data-outline] picture,
	[data-outline] figure,
	[data-outline] figcaption {
		outline: 1px solid #f39c12 !important;
	}
	[data-outline] button,
	[data-outline] a,
	[data-outline] input,
	[data-outline] label {
		outline: 1px solid #e91e63 !important;
	}
	/* The overlay and its badges are tooling, not content. */
	[data-outline] [data-dev-layer],
	[data-outline] [data-dev-layer] span {
		outline: 0 !important;
	}

	/* Page frame. Fixed, so the guides stay put while the page scrolls under
	   them — the point is checking horizontal alignment across sections that
	   are nowhere near each other vertically. */
	[data-guides]::before {
		content: '';
		position: fixed;
		inset: 0;
		z-index: 9999;
		pointer-events: none;
		background:
			linear-gradient(to right, transparent calc(50% - var(--measure-page) / 2), #e91e63 0 1px, transparent 0),
			linear-gradient(to left, transparent calc(50% - var(--measure-page) / 2), #e91e63 0 1px, transparent 0),
			linear-gradient(
				to right,
				transparent calc(50% - var(--measure-page) / 2 + var(--gutter)),
				#00e5ff 0 1px,
				transparent 0
			),
			linear-gradient(
				to left,
				transparent calc(50% - var(--measure-page) / 2 + var(--gutter)),
				#00e5ff 0 1px,
				transparent 0
			);
	}

	/* The two-column split used by .section — drawn only where it applies, so
	   it does not imply a grid on pages that do not use one. */
	@media (min-width: 60rem) {
		[data-guides]::after {
			content: '';
			position: fixed;
			inset: 0;
			z-index: 9999;
			pointer-events: none;
			background: linear-gradient(to right, transparent calc(50% - 0.5px), #ffea00 0 1px, transparent 0);
			opacity: 0.55;
		}
	}
</style>
