---
/**
 * Alignment tooling. Two independent overlays:
 *
 *   ?outline  / alt+O   outline every element, coloured by tag, each numbered
 *   ?guides   / alt+G   draw the page frame — gutters, measure, column split
 *
 * `outline` is the Storybook addon's trick: it uses `outline`, never `border`,
 * because outline is drawn outside the box and takes no space. A border would
 * add 2px to every element and shift the very edges you are trying to check.
 *
 * Numbers are stable — assigned once in document order — so "box 74 is off"
 * means the same box on both screens. Badges are drawn only for elements
 * currently on screen; several hundred at once is unreadable, and positioning
 * them all every frame is wasted work.
 *
 * TWO RULES THIS FILE HAS TO OBEY, both learned the hard way:
 *
 * 1. Never write to the DOM. An earlier version stamped `data-dev-n` on every
 *    element at DOMContentLoaded — before React hydrated. React found
 *    attributes its virtual DOM did not have, reported hydration mismatches,
 *    and re-rendered those subtrees, which threw away the very nodes being
 *    observed. Numbers now live in a Map. A debug tool must not perturb what
 *    it is measuring.
 *
 * 2. Style the overlay inline. It is injected into a page whose stylesheet it
 *    does not control, and it must not depend on its own CSS surviving the
 *    build. Inline styles cannot be scoped away, overridden, or stripped.
 *
 * Both modes persist in sessionStorage, so they survive clicking between pages.
 *
 * Ships inert in production so it also works against `npm run preview` and any
 * deployed build. Wrap the import in `import.meta.env.DEV` to drop it.
 */
---

<script is:inline>
	(() => {
		const MODES = { outline: 'dev-outline', guides: 'dev-guides' };
		const root = document.documentElement;
		const params = new URLSearchParams(location.search);

		for (const [name, key] of Object.entries(MODES)) {
			const asked = params.has(name) ? params.get(name) !== 'off' : null;
			const on = asked ?? sessionStorage.getItem(key) === '1';
			root.toggleAttribute(`data-${name}`, on);
			if (asked !== null) sessionStorage.setItem(key, on ? '1' : '0');
		}

		// Block-level things only. Numbering every <span> and <code> buries the
		// structure you are actually trying to line up.
		const SELECTOR = [
			'main', 'header', 'footer', 'section', 'article', 'aside', 'nav',
			'div', 'figure', 'figcaption', 'h1', 'h2', 'h3', 'h4',
			'p', 'ul', 'ol', 'dl', 'img', 'video', 'button', 'a',
		].join(',');

		const hueFor = (el) => {
			const t = el.tagName.toLowerCase();
			if (['main', 'header', 'footer', 'section', 'article', 'aside', 'nav'].includes(t)) return '#3498db';
			if (t === 'div') return '#e74c3c';
			if (['h1', 'h2', 'h3', 'h4'].includes(t)) return '#27ae60';
			if (['ul', 'ol', 'dl'].includes(t)) return '#16a085';
			if (['img', 'video', 'figure', 'figcaption'].includes(t)) return '#f39c12';
			if (['button', 'a'].includes(t)) return '#e91e63';
			return '#2ecc71';
		};

		let layer = null;
		let observer = null;
		const numbers = new Map(); // element -> stable index, never touches the DOM
		const onScreen = new Set();
		let frame = 0;

		const draw = () => {
			frame = 0;
			if (!layer) return;
			const parts = [];
			for (const el of onScreen) {
				const r = el.getBoundingClientRect();
				if (r.width < 14 || r.height < 10) continue; // too small to label usefully
				parts.push(
					`<span style="position:absolute;left:${Math.max(0, r.left)}px;top:${Math.max(0, r.top)}px;` +
						`font:700 9px/1 ui-monospace,SFMono-Regular,monospace;color:#fff;padding:1px 3px;` +
						`border-radius:0 0 3px 0;background:${hueFor(el)}">${numbers.get(el)}</span>`
				);
			}
			layer.innerHTML = parts.join('');
		};
		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(draw);
		};

		const enable = () => {
			if (layer) return;
			layer = document.createElement('div');
			layer.setAttribute('data-dev-layer', '');
			layer.style.cssText = 'position:fixed;inset:0;z-index:10000;pointer-events:none;outline:0';
			document.body.append(layer);

			numbers.clear();
			let n = 0;
			observer = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) onScreen.add(e.target);
						else onScreen.delete(e.target);
					}
					schedule();
				},
				{ threshold: 0 }
			);
			for (const el of document.querySelectorAll(SELECTOR)) {
				if (el === layer || layer.contains(el)) continue;
				numbers.set(el, ++n);
				observer.observe(el);
			}

			addEventListener('scroll', schedule, { passive: true });
			addEventListener('resize', schedule, { passive: true });
		};

		const disable = () => {
			observer?.disconnect();
			observer = null;
			onScreen.clear();
			numbers.clear();
			layer?.remove();
			layer = null;
			removeEventListener('scroll', schedule);
			removeEventListener('resize', schedule);
		};

		const sync = () => (root.hasAttribute('data-outline') ? enable() : disable());

		// `load`, not DOMContentLoaded: client:load islands hydrate before it, so
		// the elements scanned here are the ones React has settled on. Scanning
		// earlier would observe nodes React is about to replace.
		if (document.readyState === 'complete') sync();
		else addEventListener('load', sync, { once: true });

		addEventListener('keydown', (e) => {
			if (!e.altKey || e.metaKey || e.ctrlKey) return;
			const name = e.code === 'KeyO' ? 'outline' : e.code === 'KeyG' ? 'guides' : null;
			if (!name) return;
			e.preventDefault();
			const on = !root.hasAttribute(`data-${name}`);
			root.toggleAttribute(`data-${name}`, on);
			sessionStorage.setItem(MODES[name], on ? '1' : '0');
			if (name === 'outline') {
				// Re-scan on every enable, so numbering reflects the DOM as it is
				// now rather than as it was at load.
				if (on) {
					disable();
					enable();
				} else {
					disable();
				}
			}
		});
	})();
</script>

<style is:global>
	/* Hues are deliberately foreign to the palette — nothing here should be
	   mistakable for a design decision. Structure blue, divs red, text green,
	   headings darker green, lists teal, media orange, controls pink. */
	[data-outline] body {
		outline: 1px solid #2980b9 !important;
	}
	[data-outline] main,
	[data-outline] header,
	[data-outline] footer,
	[data-outline] section,
	[data-outline] article,
	[data-outline] aside,
	[data-outline] nav {
		outline: 1px solid #3498db !important;
	}
	[data-outline] div:not([data-dev-layer]) {
		outline: 1px solid #e74c3c !important;
	}
	[data-outline] p,
	[data-outline] span,
	[data-outline] li,
	[data-outline] dt,
	[data-outline] dd,
	[data-outline] code {
		outline: 1px solid #2ecc71 !important;
	}
	[data-outline] h1,
	[data-outline] h2,
	[data-outline] h3,
	[data-outline] h4 {
		outline: 1px solid #27ae60 !important;
	}
	[data-outline] ul,
	[data-outline] ol,
	[data-outline] dl {
		outline: 1px solid #16a085 !important;
	}
	[data-outline] img,
	[data-outline] svg,
	[data-outline] video,
	[data-outline] picture,
	[data-outline] figure,
	[data-outline] figcaption {
		outline: 1px solid #f39c12 !important;
	}
	[data-outline] button,
	[data-outline] a,
	[data-outline] input,
	[data-outline] label {
		outline: 1px solid #e91e63 !important;
	}
	/* The overlay and its badges are tooling, not content. */
	[data-outline] [data-dev-layer],
	[data-outline] [data-dev-layer] span {
		outline: 0 !important;
	}

	/* Page frame. Fixed, so the guides stay put while the page scrolls under
	   them — the point is checking horizontal alignment across sections that
	   are nowhere near each other vertically. */
	[data-guides]::before {
		content: '';
		position: fixed;
		inset: 0;
		z-index: 9999;
		pointer-events: none;
		background:
			linear-gradient(to right, transparent calc(50% - var(--measure-page) / 2), #e91e63 0 1px, transparent 0),
			linear-gradient(to left, transparent calc(50% - var(--measure-page) / 2), #e91e63 0 1px, transparent 0),
			linear-gradient(
				to right,
				transparent calc(50% - var(--measure-page) / 2 + var(--gutter)),
				#00e5ff 0 1px,
				transparent 0
			),
			linear-gradient(
				to left,
				transparent calc(50% - var(--measure-page) / 2 + var(--gutter)),
				#00e5ff 0 1px,
				transparent 0
			);
	}

	/* The two-column split used by .section — drawn only where it applies, so
	   it does not imply a grid on pages that do not use one. */
	@media (min-width: 60rem) {
		[data-guides]::after {
			content: '';
			position: fixed;
			inset: 0;
			z-index: 9999;
			pointer-events: none;
			background: linear-gradient(to right, transparent calc(50% - 0.5px), #ffea00 0 1px, transparent 0);
			opacity: 0.55;
		}
	}
</style>
