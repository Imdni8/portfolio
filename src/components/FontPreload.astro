---
/**
 * Preload hints for the two faces that render above the fold.
 *
 * Without these, a webfont is only discovered after the browser has fetched
 * *and parsed* the stylesheet that carries its `@font-face` — one extra
 * round-trip after CSS, on the critical path, on every first visit. Fontsource
 * ships `font-display: swap`, so the cost shows up as a visible FOUT: the
 * headline paints in a fallback serif and then reflows to DM Serif Display
 * once the real face lands. The preload moves the fetch forward to HTML parse, in
 * parallel with the stylesheet rather than behind it.
 *
 * Deliberately only two files, and only the `latin` subsets:
 *
 * - Preloading is a priority claim, not a free hint. Every extra file competes
 *   with the ones that actually block first paint, so this covers the faces
 *   used by visible text at the top of the page — DM Serif Display for the
 *   headline, DM Sans for the copy — and nothing more. DM Mono is left out on
 *   purpose, even though the nav is set in it: it only ever sets 12px labels,
 *   where a late swap is a barely visible reflow, and a third claim would slow
 *   the two faces whose swap is not.
 * - The italic faces, and the latin-ext subsets, are left to
 *   normal discovery. `unicode-range` means most visitors never download them
 *   at all, and preloading a file the page turns out not to use is pure waste
 *   plus a console warning.
 *
 * `crossorigin` is required even though these are same-origin: fonts are
 * fetched in CORS mode, and a preload whose mode does not match the eventual
 * request is discarded and fetched a second time — the exact opposite of the
 * point. `as="font"` is what sets that mode.
 *
 * The homepage is the exception (`home`): the only text at its top is the
 * headline, set in Montserrat and Playfair Display (HomeHero.astro), so it
 * claims those three files instead — the 300 and 600 cuts and the one italic
 * — and nothing else. The DM faces are below the fold there.
 *
 * The URLs come through Vite (`?url`) rather than being written out, because
 * the built filenames are content-hashed — a hand-written path would go stale
 * on the next font upgrade and preload a 404.
 */
import sansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import serifLatin from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';
import headlineLight from '@fontsource/montserrat/files/montserrat-latin-300-normal.woff2?url';
import headlineName from '@fontsource/montserrat/files/montserrat-latin-600-normal.woff2?url';
import headlineAccent from '@fontsource/playfair-display/files/playfair-display-latin-700-italic.woff2?url';

interface Props {
	/** The homepage, whose first screen is set in the headline faces. */
	home?: boolean;
}

const { home = false } = Astro.props;
const files = home ? [headlineLight, headlineName, headlineAccent] : [serifLatin, sansLatin];
---

{files.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
