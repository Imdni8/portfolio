---
/* The homepage's opening block, from Paper's hero frame ("HP shader exp"):
   the name, the role under it, then a month of GitHub bars running from
   the left edge into "ships thoughtful", and "products that drive results"
   right-aligned under that.

   The bars are the last 30 days of GitHub contributions (commit-strip.ts
   fills them), green on a day with any, grey on a day with none. Rendered
   here empty, so without JS — or if the fetch fails — the row stands as 30
   grey bars and nothing is claimed. Hovering or focusing them shows the
   total in a tooltip, once there is a total to show. */
import { links } from '../../data/links';

const DAYS = 30;
---

{/* data-nav-scrim: the first thing that scrolls up under the nav, so the
    nav's band fades in as it gets there — see SiteNav.astro. */}
<header class="intro" data-nav-scrim>
	<h1 class="intro__name type-heading">Tousif Rahaman</h1>
	<p class="intro__role type-body">Lead designer / Builder</p>

	<div class="intro__row">
		<a class="commit-strip" href={links.github} target="_blank" rel="noopener noreferrer" data-commit-strip>
			<span class="commit-strip__days" style={`--days: ${DAYS}`} aria-hidden="true">
				{Array.from({ length: DAYS }, () => <span class="commit-strip__day" data-level="0" />)}
			</span>
			<span class="sr-only" data-commit-label>(my GitHub activity, opens in new tab)</span>
			{/* aria-hidden: the sr-only label above already reads the same total. */}
			<span class="commit-strip__tip type-annotation" aria-hidden="true" data-commit-tip></span>
		</a>
		<p class="intro__ships type-body">ships <em class="intro__accent">thoughtful</em></p>
	</div>

	<p class="intro__results type-body">products that drive results</p>
</header>

<style>
	/* Four rows, 4px apart: the name, the role, the bars/tagline row, and
	   the tagline's second line set against the column's right edge. */
	.intro {
		display: grid;
		gap: var(--spacing-xs);
	}

	.intro__name {
		color: var(--text);
	}

	/* The bars take whatever "ships thoughtful" leaves, so they run from the
	   column's left edge to the tagline at any width — a phone's column
	   included, so the row never wraps. */
	.intro__row {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
	}

	/* --text-body, not --text-muted: the role sits inside the bands, and
	   muted grey over their brightest point measured 3.0:1 — too low for
	   small text. */
	.intro__role {
		color: var(--text-body);
	}

	.intro__ships,
	.intro__results {
		color: var(--text);
		white-space: nowrap;
	}

	.intro__results {
		text-align: end;
	}

	/* The one word the sentence leans on, in the serif's drawn italic — the
	   same face .type-heading--claim uses, so no new family and no
	   synthesised slant. */
	.intro__accent {
		font-family: var(--font-display);
		font-style: italic;
		letter-spacing: var(--track-tight);
	}

	/* ---- Commit strip ---------------------------------------------------- */
	.commit-strip {
		position: relative;
		display: flex;
		flex: 1;
		min-inline-size: 0;
		border-radius: var(--radius-xxs);
		color: inherit;
		-webkit-tap-highlight-color: transparent;
	}

	.commit-strip:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}

	.commit-strip__days {
		display: flex;
		flex: 1;
		gap: var(--spacing-xs);
	}

	/* One thin pill per day, grey until commit-strip.ts stamps a level; any
	   level above 0 turns it green. The fill eases in, so the strip fills
	   left to right as each bar is stamped in turn.

	   Each bar is its share of the strip rounded *down to a whole pixel*.
	   An even `flex: 1` split leaves fractional widths (12.06px at 1440),
	   and the screen snaps those edges inconsistently, so the 4px gaps read
	   as uneven. The few pixels the rounding gives up sit after the last
	   bar, before "ships". The plain calc() is the fallback where round()
	   isn't supported. */
	.commit-strip__day {
		flex: none;
		inline-size: calc((100% - (var(--days) - 1) * var(--spacing-xs)) / var(--days));
		inline-size: round(down, (100% - (var(--days) - 1) * var(--spacing-xs)) / var(--days), 1px);
		block-size: var(--spacing-lg);
		border-radius: var(--radius-xxs);
		background: var(--commit-empty);
		transition: background-color 240ms var(--ease-out);
	}

	.commit-strip__day:not([data-level='0']) {
		background: var(--commit-active);
	}

	/* The total, in a small bubble above the bars, flush with their
	   trailing edge — the most recent day, which the count ends on. It
	   only exists once commit-strip.ts has a total and stamps `data-ready`
	   — a failed fetch shows nothing, the same rule as the grey bars.
	   Opens on a hovering mouse or keyboard focus: it fades in and rises
	   4px, and under reduced motion only fades. */
	.commit-strip__tip {
		position: absolute;
		inset-block-end: calc(100% + var(--spacing-md));
		inset-inline-end: 0;
		z-index: 1;
		padding: var(--spacing-xs) var(--spacing-md);
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--bg-raised);
		color: var(--text);
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		translate: 0 var(--spacing-xs);
		transition:
			opacity 150ms var(--ease-out),
			translate 150ms var(--ease-out);
	}

	.commit-strip:not([data-ready]) .commit-strip__tip {
		display: none;
	}

	.commit-strip:focus-visible .commit-strip__tip {
		opacity: 1;
		translate: 0;
	}

	@media (hover: hover) and (pointer: fine) {
		.commit-strip:hover .commit-strip__tip {
			opacity: 1;
			translate: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.commit-strip__tip {
			translate: 0;
			transition: opacity 150ms ease;
		}
	}
</style>
