---
import logoMark from '../../assets/nav/logo.svg?raw';

/* The homepage headline: "I try to design / Thoughtful software", with the
   brand mark standing in for the T. Its entrance is CSS alone — see the
   keyframes below — and its exit is home-reel.ts, which fades the words and
   flies the mark up into the nav. The two never touch the same element:
   the entrance animates `.hero__lead`, `.hero__spoken` and `.hero__aside`
   (`.hero__visual` under reduced motion, where the reel never runs), the
   exit writes
   to `[data-reel-fade]` and `[data-reel-mark]`, because a running CSS
   animation outranks an inline style and would pin whatever the script
   tried to set. */
---

<div class="hero" data-reel-hero>
	{/* The sentence is read from the `.sr-only` copy and the drawing is hidden
	    from assistive tech. The drawing cannot carry the text itself: the T is
	    an SVG, "try to" sits in a grid whose whitespace does not reach the
	    accessibility tree, and the words arrive out of order. The cost is a
	    doubled line in a copy-paste of the headline, which is the one place it
	    shows. */}
	<h1 class="hero__title">
		<span class="sr-only">I try to design thoughtful software</span>
		<span class="hero__visual" aria-hidden="true">
			<span class="hero__fade" data-reel-fade>
				<span class="hero__lead">
					<span class="hero__word hero__word--i type-display-sans">I</span>
					<span class="hero__aside type-hand">try&nbsp;&nbsp;to</span>
					<span class="hero__word type-display-sans">design</span>
				</span>
			</span>
			<span class="hero__spoken type-display">
				<span class="hero__mark" data-reel-mark set:html={logoMark} />
				<span class="hero__spoken-text" data-reel-fade>houghtful software</span>
			</span>
		</span>
	</h1>
</div>

<style>
	/* Centred in whatever box hosts it — the reel's pinned viewport, or the
	   stacked layout's first screen — and lifted by 2.5svh off true centre,
	   where the reference sits it (28px above the middle of a 1117px frame).
	   The lift is padding rather than a transform so nothing here competes
	   with the scripts that transform the pieces inside. */
	.hero {
		display: grid;
		place-items: center;
		padding-block-end: 5svh;
		padding-inline: var(--gutter);
		color: var(--text);
	}

	.hero__title {
		margin: 0;
		font: inherit;
	}

	.hero__visual {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* Row one. Three grid tracks, the middle one flexible, and the grid
	   sized to its content so there is no free space for that track to take:
	   at 0fr it contributes nothing and "I" and "design" sit a word space
	   apart, at 1fr it contributes exactly "try to"'s width. Animating the
	   track between the two is what pushes the outer words apart — both at
	   once, in opposite directions, because the row is centred and grows
	   from the middle.

	   The gap grows with it: two --spacing-xs either side of an empty track
	   plus the I's own --spacing-xs of padding make the word space the
	   sentence starts with, and --spacing-2xl either side of the aside is the
	   reference's 19px, to the nearest rung. */
	.hero__lead {
		display: grid;
		grid-template-columns: auto 1fr auto;
		column-gap: var(--spacing-2xl);
		align-items: center;
		inline-size: max-content;
	}

	.hero__word {
		color: var(--text);
	}

	.hero__word--i {
		padding-inline-end: var(--spacing-xs);
	}

	/* Centred over its track rather than stretched into it, so while the
	   track is still narrower than the words the overflow falls evenly on
	   both sides and the aside grows from the middle of the gap, not its left
	   edge. `min-inline-size: 0` is what lets the track reach 0 at all —
	   without it the item's own width would be the track's floor. Not
	   clipped: the rotation takes the letters outside their box, and they are
	   invisible for as long as they overhang anyway.

	   The two words are set a double space apart (non-breaking, so it
	   survives whitespace collapsing), as the reference sets them: the hand's
	   own word space is narrow enough that a single one reads as "tryto". */
	.hero__aside {
		justify-self: center;
		min-inline-size: 0;
		white-space: nowrap;
		color: var(--text);
		rotate: -3.91deg;
	}

	/* Row two, drawn up under row one by --spacing-xs and bottom-aligned, so
	   the mark — taller than the line, since its swoosh runs above the cap
	   height and below the baseline — hangs off the text the way the
	   reference draws it. The text's own --spacing-xs of bottom padding and
	   the matching pull-in toward the mark are the reference's offsets. */
	.hero__spoken {
		display: flex;
		align-items: flex-end;
		margin-block-start: calc(-1 * var(--spacing-xs));
		color: var(--text);
	}

	/* 1.625em is the reference's ratio (78 : 48), so the mark scales with the
	   line it replaces a letter in. Its colour is --brand-mark, the same as
	   the nav's and the footer's — it *is* the nav's mark, on its way there.
	   `transform-origin` is the corner home-reel.ts measures from.

	   On its way up it crosses the centre card, which is rising at the same
	   time, and it has to stay in front of it. The z-index does that against
	   the reel's card track (a stacking context at 0, index.astro) — which
	   only works while nothing between here and the reel's pin makes a
	   stacking context of its own. That is why the entrance below fills
	   `backwards` and not `both`: a filled opacity animation would leave
	   `.hero__spoken` a stacking context for good, and trap the mark inside
	   it, behind the cards. */
	.hero__mark {
		position: relative;
		z-index: 1;
		display: block;
		flex-shrink: 0;
		block-size: 1.625em;
		color: var(--brand-mark);
		transform-origin: 0 0;
	}

	.hero__mark :global(svg) {
		display: block;
		block-size: 100%;
		inline-size: auto;
	}

	.hero__spoken-text {
		margin-inline-start: calc(-1 * var(--spacing-xs));
		padding-block-end: var(--spacing-xs);
		white-space: nowrap;
	}

	/* The entrance — seen once per visit, so it is allowed to take its time
	   and tell the sentence in order. The two lines arrive 80ms apart (a
	   stagger, rather than both at once), the first row pauses on "I design"
	   long enough to be read, then opens, and the aside is written into the
	   gap as it does.

	   Arrivals ease out on --ease-out (they start fast, so the reader sees
	   movement the moment they look); the opening is on-screen movement, so
	   it takes --ease-in-out. The aside rises from 0.9, not from nothing.

	   `hero-open` animates grid tracks, which is layout rather than
	   transform, and that is deliberate: the transform version has to measure
	   the aside after its web font lands and hide the line until it has, so
	   it trades a one-off 650ms reflow of a three-item row for a script the
	   headline would depend on to be visible at all. The row is the only
	   thing that reflows, and nothing else on the page is sized by it.

	   Every keyframe ends on the element's own resting style, so filling
	   `backwards` (holding the first frame through the delay) is all that is
	   needed, and once each animation ends it leaves nothing behind — see
	   `.hero__mark` for why that matters. */
	@media (prefers-reduced-motion: no-preference) {
		.hero__lead {
			animation:
				hero-arrive 600ms var(--ease-out) 200ms backwards,
				hero-open 650ms var(--ease-in-out) 1050ms backwards;
		}

		.hero__spoken {
			animation: hero-arrive 600ms var(--ease-out) 280ms backwards;
		}

		.hero__aside {
			animation: hero-write 400ms var(--ease-out) 1300ms backwards;
		}
	}

	/* Reduced motion keeps the arrival and drops the movement: one short
	   fade of the finished sentence, with nothing sliding, opening or
	   scaling. */
	@media (prefers-reduced-motion: reduce) {
		.hero__visual {
			animation: hero-fade 200ms ease backwards;
		}
	}

	@keyframes hero-arrive {
		from {
			opacity: 0;
			translate: 0 var(--spacing-md);
		}

		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	@keyframes hero-open {
		from {
			grid-template-columns: auto 0fr auto;
			column-gap: var(--spacing-xs);
		}

		to {
			grid-template-columns: auto 1fr auto;
			column-gap: var(--spacing-2xl);
		}
	}

	@keyframes hero-write {
		from {
			opacity: 0;
			scale: 0.9;
		}

		to {
			opacity: 1;
			scale: 1;
		}
	}

	@keyframes hero-fade {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}
</style>
