---
import Icon from '../ui/Icon.astro';
---

<header class="nav">
	<a class="nav__brand" href="/" aria-label="Tousif Rahaman — home">
		<svg width="21" height="40" viewBox="0 0 21 40" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path
				d="M2.09494 27.9217L2.09135 27.9327C-0.987036 39.1414 4.65474 40.3816 8.28926 39.1414C14.864 36.8981 19.2941 17.3495 19.8281 10.4076C20.2806 4.52502 20.416 0.957926 17.7114 0.0678851C15.0068 -0.822156 8.21541 7.17745 5.23237 15.9775C8.464 7.42604 15.325 -0.57845 17.7114 0.763919C20.0978 2.10629 18.4859 9.58937 18.0181 13.1226C16.6477 21.6624 13.3006 28.9838 11.4104 32.0091C9.76924 34.5077 7.72161 35.8065 5.23237 34.8427C3.20454 34.0186 3.10782 31.1787 3.89244 28.5031L3.89525 28.4942C5.68927 20.6889 9.22578 17.2859 10.8007 16.574C11.0493 16.4617 11.6956 15.9075 10.2538 16.1266C8.21388 16.4367 3.28015 18.0009 0.0502259 21.5944C-0.0232912 21.6762 -0.0143885 21.8025 0.0683472 21.875C0.634719 22.371 0.927832 22.6513 1.49036 23.1443C1.57759 23.2207 1.71112 23.2068 1.78152 23.1147C3.00813 21.5085 5.92118 18.3601 8.7825 17.3495C5.49376 20.0414 3.42594 23.9795 2.09494 27.9217Z"
				fill="#EF942B"></path>
		</svg>
	</a>

	<nav class="nav__links" aria-label="Primary">
		<a class="nav__link type-ui-label" href="/" aria-current="page">Work</a>
		<a class="nav__link type-ui-label" href="/about">About</a>
	</nav>

	<details class="nav__dropdown">
		<summary class="nav__dropdown-trigger type-ui-label">
			Side projects
			<Icon name="chevron-down" class="nav__dropdown-chevron" />
		</summary>
		<div class="nav__dropdown-panel">
			<p class="type-annotation">More soon</p>
		</div>
	</details>
</header>

<style>
	/* Floats over both the water-field hero and the plain-background cards
	   section below, so it's fixed rather than scoped to either. */
	.nav {
		position: fixed;
		inset-block-start: var(--spacing-3xl);
		inset-inline: var(--gutter);
		z-index: 20;
		max-width: var(--measure-content);
		margin-inline: auto;
		padding: var(--spacing-lg) var(--spacing-2xl);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-4xl);
		border-radius: var(--radius-2xl);
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg) 80%, transparent);
		backdrop-filter: blur(8px);
	}

	.nav__brand {
		display: inline-flex;
		align-items: center;
		color: inherit;
	}

	.nav__brand svg {
		display: block;
		height: 1.75rem;
		width: auto;
	}

	.nav__links {
		display: flex;
		align-items: center;
		gap: var(--spacing-3xl);
	}

	.nav__link {
		color: var(--text-muted);
		text-decoration: none;
	}

	.nav__link:hover {
		color: var(--text);
	}

	/* Active state carries weight, colour and an underline together — never
	   colour alone. */
	.nav__link[aria-current='page'] {
		color: var(--primary-text);
		font-weight: var(--weight-bold);
		text-decoration: underline;
		text-underline-offset: var(--spacing-xs);
	}

	.nav__dropdown {
		position: relative;
	}

	.nav__dropdown-trigger {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		color: var(--text-muted);
		cursor: pointer;
		list-style: none;
	}

	.nav__dropdown-trigger::-webkit-details-marker {
		display: none;
	}

	.nav__dropdown-trigger:hover {
		color: var(--text);
	}

	.nav__dropdown-chevron {
		transition: transform 0.15s ease;
	}

	.nav__dropdown[open] .nav__dropdown-chevron {
		transform: rotate(180deg);
	}

	.nav__dropdown-panel {
		position: absolute;
		inset-block-start: calc(100% + var(--spacing-md));
		inset-inline-end: 0;
		min-width: 12rem;
		padding: var(--spacing-lg) var(--spacing-xl);
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		background: var(--bg-raised);
	}

	.nav__dropdown-panel p {
		color: var(--text-muted);
	}

	.nav__brand:focus-visible,
	.nav__link:focus-visible,
	.nav__dropdown-trigger:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-xs);
	}
</style>
