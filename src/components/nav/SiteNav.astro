---
import { NavMenu } from './NavMenu';
import Icon from '../ui/Icon.astro';
import { links } from '../../data/links';
import logoMark from '../../assets/nav/logo.svg?raw';

/* No `aria-current` anywhere in here any more: the nav holds one off-site
   link and one dropdown, and neither can ever be the current page. The brand
   mark is the only route back to `/`, which is also what it was before. */
---

<header class="nav-shell" transition:persist>
	<div class="nav-shell__inner">
		<a class="nav__brand" href="/" aria-label="Tousif Rahaman — home" set:html={logoMark} />

		<div class="nav__group">
			<nav class="nav__links" aria-label="Primary">
				{/* Off-site (Drive), so it takes the same arrow the Side-projects rows
				    use — one glyph from icons.ts, not a second copy of it. `links` is
				    the shared declaration in src/data/links.ts, so the footer and this
				    cannot drift onto different résumé URLs. */}
				<a
					class="nav__link nav__link--external type-nav-link"
					href={links.resume}
					target="_blank"
					rel="noopener noreferrer"
				>
					Resume<span class="sr-only"> (opens in new tab)</span>
					{/* The span is what moves; the link's own `overflow: hidden` is what
					    hides it at rest. Same arrangement as a Side-projects row, and the
					    same code drives both — see nav-dropdown.ts. .icon inside is
					    already 1em square (components.css), so the glyph tracks the link's
					    12px label rung and inherits its muted -> full hover colour. */}
					<span class="nav__link-arrow"><Icon name="arrow-up-right" /></span>
				</a>
			</nav>

			{/* `client:idle`, not `client:load`. The trigger renders correctly as
			    static SSR markup, and everything this island adds — Base UI's
			    open/close, keyboard and focus handling, plus GSAP's hover
			    choreography — is only reachable once the reader goes for it. At
			    `client:load` its React + Base UI + GSAP chunk parses and hydrates
			    around first paint on every page on the site, for a dropdown most
			    visits never open. */}
			<NavMenu client:idle />
		</div>
	</div>
</header>

<style>
	/* Floats over the page on every route, so it's fixed rather than scoped
	   to any one section. No pane, no glass, no card — brand mark on the
	   left, the links on the right, all sitting directly on the page.

	   Full-bleed, unlike the row it holds: the band that fades in behind it
	   (::before) has to reach both viewport edges, so the shell spans the
	   viewport and `.nav-shell__inner` carries the gutter and the cap.
	   --spacing-xl above and below a 40px row puts the brand 16px from the top
	   of the viewport, where the reference draws it, and the band's bottom
	   edge at 72px — still inside `--nav-footprint` (78px, about.astro), and
	   above the 96px a case study's hero and chapter rail start at. */
	.nav-shell {
		position: fixed;
		inset-block-start: 0;
		inset-inline: 0;
		z-index: 20;
		padding-block: var(--spacing-xl);
		padding-inline: var(--gutter);
	}

	/* Brand on one edge, Resume and Side projects on the other, across a
	   1000px row. The row is narrower than the 1240px the page frames used to
	   share, which is what keeps the pair from looking stranded at the far
	   end of it — the reference sets the nav to the prose measure rather than
	   to the content one. `gap` only matters once the viewport is too narrow
	   for `space-between` to leave any room. */
	.nav-shell__inner {
		max-width: var(--measure-prose);
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3xl);
	}

	/* The band. A pseudo-element rather than a background on `.nav-shell`
	   itself, because the ramp is an opacity and painting it on the shell
	   would take the brand and the links down with it. `z-index: -1` puts it
	   behind them without leaving the shell's own stacking context, so the
	   whole nav still sits above the page at 20.

	   `--nav-scrim` is written every scroll frame by the script below. Unset
	   — no JS, or a page with nothing marked `data-nav-scrim` — it falls back
	   to 0 and the nav stays exactly as transparent as it is today.

	   The band is the page's own ground, so it reads as the page continuing
	   behind the links rather than as a bar laid over it. That is --bg on
	   every page but one: the homepage sits on a warm ground of its own, and
	   says so through `--nav-band` on its body (index.astro). */
	.nav-shell::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--nav-band, var(--bg));
		border-bottom: 1px solid var(--border);
		opacity: var(--nav-scrim, 0);
	}

	.nav__brand {
		display: inline-flex;
		align-items: center;
		/* The mark's fill is currentColor, so the colour is named in the
		   semantic layer now rather than baked into the path. --brand-mark,
		   not --primary-text: this is the logo, and it holds the same orange
		   as the footer mascot's swoosh on both themes. */
		color: var(--brand-mark);
	}

	/* :global() on both of these: the <svg> arrives via set:html, so it has
	   no scope attribute for an unqualified `svg` to match. */
	/* 2.5rem is the reference's 40px — and the size the homepage headline's
	   mark shrinks to on its way up here (home-reel.ts measures this box). */
	.nav__brand :global(svg) {
		display: block;
		height: 2.5rem;
		width: auto;
	}

	/* Resume and the Side-projects trigger cluster together on the right as
	   one visual group, 24px apart — .nav__links and NavMenu stay two
	   separate elements underneath (Base UI's NavigationMenu owns only the
	   dropdown; Resume has nowhere to open and stays a plain anchor), but this
	   wrapper is what makes them read as one group instead of two. */
	.nav__group {
		display: flex;
		align-items: center;
		gap: var(--spacing-3xl);
	}

	.nav__links {
		display: flex;
		align-items: center;
		gap: var(--spacing-3xl);
	}

	/* Type comes from `.type-nav-link` in the markup — the same uppercase mono
	   label the chapter rail and Tabs wear; this rule is layout and colour
	   only. */
	/* The hover is a colour change, so it eases on plain `ease`, and it is
	   gated to a pointer that can really hover — a tap on touch fakes a hover
	   and leaves the link lit until the next tap elsewhere. */
	.nav__link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		padding-block: var(--spacing-md);
		padding-inline: var(--spacing-xs);
		color: var(--text-muted);
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
		transition: color 150ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.nav__link:hover {
			color: var(--text);
		}
	}

	/* The arrow flies in diagonally on hover and back out on leave, exactly as
	   a Side-projects row's does — nav-dropdown.ts drives both off one pair of
	   selectors. Two things make it work, and both mirror
	   `.nav-dropdown__item`/`.nav-dropdown__item-arrow`:

	   `overflow: hidden` is the clip. The arrow is parked well outside the
	   link's padding box at rest, and this is what stops it being drawn there.

	   The rest transform lives here in CSS rather than being set by the script,
	   for the reason nav-dropdown.ts's header gives: the element has to already
	   look right before any JS has touched it. 6rem is the same generous
	   overshoot the dropdown rows use — the script tweens from the row's own
	   measured height, so this value only has to clear the box, not match. */
	.nav__link--external {
		overflow: hidden;
	}

	.nav__link-arrow {
		display: inline-flex;
		flex-shrink: 0;
		transform: translate(-6rem, 6rem);
	}

	/* .nav-dropdown is NavMenu.tsx's <NavigationMenu> root — a React island,
	   so (unlike everything above) none of the rules from here down get
	   Astro's scope attribute on the elements they need to match; every
	   selector below is :global() for that reason.

	   Base UI's own NavigationMenu.Root ships flex-1 (Tailwind, in
	   navigation-menu.tsx) — meant for a root that spans a full menu bar,
	   wrong for a fixed-content trigger sitting beside `.nav__links`.
	   `flex: 0 0 auto` overrides it outright rather than fighting the
	   individual grow/shrink longhands piecemeal. */
	:global(.nav-dropdown) {
		position: relative;
		display: flex;
		align-items: center;
		flex: 0 0 auto;
	}

	/* Same padding/colour treatment as .nav__link, so "Side projects" reads
	   as the third item in one row rather than a visually distinct control.
	   background-color: transparent overrides shadcn's own default
	   hover/open background (Tailwind, navigation-menu.tsx: hover:bg-muted,
	   focus:bg-muted, data-popup-open:bg-muted/50) — those are layered
	   utilities, so one unlayered declaration here beats all of them
	   regardless of which :hover/[data-popup-open] state is active, the
	   same fix already used on .nav-dropdown__item below. height: auto
	   overrides Base UI's own fixed h-9 so it doesn't clip .nav__group's
	   align-items: center row differently from a plain link's line height. */
	:global(.nav-dropdown__trigger) {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		height: auto;
		padding-block: var(--spacing-md);
		padding-inline: var(--spacing-xs);
		color: var(--text-muted);
		background-color: transparent;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition: color 150ms ease;
	}

	/* data-popup-open is Base UI's own attribute on the trigger button
	   itself (see NavigationMenuTrigger in navigation-menu.tsx). Open is
	   state, so it lights the trigger on every input; hover is gated like
	   `.nav__link`'s. */
	:global(.nav-dropdown__trigger[data-popup-open]) {
		color: var(--text);
	}

	@media (hover: hover) and (pointer: fine) {
		:global(.nav-dropdown__trigger:hover) {
			color: var(--text);
		}
	}

	/* :global() because the chevron span is rendered by navigation-menu.tsx's
	   own Icon usage, not this component's template. Rotation on open is
	   handled there too, as a Tailwind group-data variant on the icon. */
	:global(.nav-dropdown) :global(.nav-dropdown__chevron) {
		color: var(--primary-text);
	}

	/* The popup surface now wears shadcn's own default look (bg-popover,
	   ring-foreground, shadow, rounded-lg — all sourced from tokens.css via
	   the tailwind.css bridge), not `.glass`. min-width/box-sizing are the
	   only overrides left. */
	:global(.nav-dropdown__popup) {
		/* Pinned explicitly: `min-width` is a content-box measurement, and
		   about.astro (unlike this component's other host, index.astro)
		   applies a page-scoped `box-sizing: border-box` reset. Without this,
		   the same min-width nets 32px less room on the about page
		   (padding-inline counted inward instead of added on) and wraps
		   "Amplitude taxonomy exporter" onto a third line. */
		box-sizing: content-box;
		/* The floor that gives .nav-dropdown__item-label's `flex-grow: 1`
		   something to grow into — see that rule below for why the slack is
		   what keeps "Amplitude taxonomy exporter" off a second line. Base UI
		   measures `--popup-width` from the content once, when the menu opens,
		   and then holds it, so the width the label is measured against is
		   whatever this yields; nothing in the hover state changes it (the
		   nudge is a transform, not a layout shift). At the old 14rem the
		   measured width left under a pixel of slack and the label wrapped. */
		min-width: 21rem;
	}

	/* padding (all four sides, not just padding-inline) overrides Base UI's
	   own p-1 on NavigationMenuContent — the panel has no block padding of
	   its own, since each .nav-dropdown__item supplies its own. */
	:global(.nav-dropdown__panel) {
		padding: 0 var(--spacing-xl);
		display: flex;
		flex-direction: column;
	}

	/* Resting state is dim; hover/focus bring text, arrow and border to full
	   opacity and nudge the label right (see .nav-dropdown__item-label) —
	   never colour alone. Both share one timing curve so they move in
	   lockstep. GSAP (nav-dropdown.ts) drives the hoverline draw-in and the
	   arrow's diagonal entrance/exit, which a CSS transition can't express. */
	:global(.nav-dropdown__item) {
		position: relative;
		overflow: hidden; /* clips the arrow while it's parked off-frame */
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-xl) var(--spacing-xl) var(--spacing-xl) 0;
		color: var(--text);
		text-decoration: none;
		opacity: 0.6;
		background-color: transparent;
		border-bottom: 1px solid var(--border);
		/* Opacity only — the one property the hover changes on the row
		   itself (the label's nudge has its own rule). A bare duration here
		   meant `all`. The 0.8s expo-out is not a UI-budget slip: it is the
		   curve nav-dropdown.ts's GSAP hover runs on, so the row brightens in
		   step with its hoverline and arrow, and expo-out does nearly all of
		   its moving in the first 150ms of that. */
		transition: opacity 0.8s cubic-bezier(0.19, 1, 0.22, 1);
	}

	:global(.nav-dropdown__item:last-child) {
		border-bottom: none;
	}

	/* background-color: transparent again here, not just on the base rule
	   above — NavigationMenuLink's own hover:bg-muted/focus:bg-muted (Tailwind,
	   navigation-menu.tsx) target the same :hover/:focus-visible state, and
	   cascade layers only settle ties at matching specificity+state; this
	   project's opacity/label-nudge hover treatment, not a background
	   swap, is what's meant to read here. */
	:global(.nav-dropdown__item:hover),
	:global(.nav-dropdown__item:focus-visible) {
		background-color: transparent;
		opacity: 1;
	}

	:global(.nav-dropdown__item:focus-visible) {
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
	}

	/* The label takes the row's leftover width instead of sitting at its own
	   max-content size. That extra width is never *used* — the text is the
	   same length either way — but a flex item sized to max-content lands a
	   fraction of a pixel short of the line it is supposed to hold (the
	   intrinsic measurement rounds down where the line box rounds up), which
	   is enough to wrap a label that visibly fits.
	   Growing into the free space the popup's min-width above provides puts
	   real slack between the label's box and its text, so the break point no
	   longer sits on a rounding boundary. Nothing moves: the arrow is already
	   pinned right by the item's justify-content, and this only changes where
	   the label's (transparent) box ends. */
	:global(.nav-dropdown__item-label) {
		flex-grow: 1;
		transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1);
	}

	/* The hover nudge, as a transform rather than the item's
	   `padding-inline-start` it started as. The two look identical — the label
	   moves right by the same var(--spacing-lg), the arrow stays pinned right
	   either way, and the border-bottom spans the full width either way, since
	   padding sits inside the border box — but a transform composites instead
	   of laying out. That matters here specifically: Base UI measures the
	   popup width from the content once, on open, and holds it, so a hover
	   that resizes the label's content box afterwards is changing the thing
	   that measurement already committed to. Nothing to reflow now, and no
	   width has to be held in reserve for the shift. */
	:global(.nav-dropdown__item:hover) :global(.nav-dropdown__item-label),
	:global(.nav-dropdown__item:focus-visible) :global(.nav-dropdown__item-label) {
		transform: translateX(var(--spacing-lg));
	}

	/* translate: a generic "safely outside any real row" default, not the
	   item's own precise offsetHeight — nav-dropdown.ts's enter/leave tweens
	   measure that exactly on every interaction, so this only has to hold
	   up for the brief window (or the reduced-motion case, which never
	   tweens at all) before a node's first real hover. Needing this at all,
	   rather than only ever setting it from JS, is the fix for Base UI
	   recreating these nodes on interaction — a freshly swapped-in arrow
	   has never been touched by GSAP and must already look "at rest". */
	/* align-self: flex-start (overriding the item's own align-items: center
	   just for this child) + a top margin sized to centre the 1rem box inside
	   one line of .type-nav-link (--size-micro × --lh-micro = 18px, so
	   (18-16)/2 = 1px, written out from the tokens so it follows them) —
	   aligns the arrow with the label's *first* line specifically.
	   Centring against the item's full height instead (the item's own
	   align-items) puts the arrow in the gap between lines the moment a
	   label wraps, e.g. "Amplitude taxonomy exporter" — floating disconnected
	   from either line rather than reading as this row's icon. */
	:global(.nav-dropdown__item-arrow) {
		width: 1rem;
		height: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		align-self: flex-start;
		margin-block-start: calc((var(--size-micro) * var(--lh-micro) - 1rem) / 2);
		transform: translate(-6rem, 6rem);
	}

	/* scaleX(0) from the left edge is this element's own "at rest" —
	   same reasoning as the arrow's translate above. */
	:global(.nav-dropdown__item-hoverline) {
		position: absolute;
		inset: auto auto 0 0;
		width: 100%;
		height: 1px;
		background: var(--primary-text);
		transform: scaleX(0);
		transform-origin: 0% 50%;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.nav-dropdown__item),
		:global(.nav-dropdown__item-label) {
			transition-duration: 0.01ms;
		}
	}

	/* ---- Side projects on a phone: a bottom sheet -------------------------
	   NavMenu.tsx renders both the dropdown and the sheet's trigger; which one
	   shows is decided here, at the same 40rem the footer stacks at. The
	   trigger wears `.nav-dropdown__trigger` too, so the two read as the
	   same control.

	   The sheet itself is portalled to the end of <body>, outside this
	   component, so everything about it is :global(). Its surface, radius,
	   slide and swipe come from ui/drawer.tsx; what is set here is the
	   project's: the edge colour (the drawer's `border-t` has no colour of its
	   own here — there is no base layer setting one — and would otherwise take
	   the text's), the content, and a bottom inset that clears a phone's home
	   indicator where the browser reports one. */
	:global(.nav-sheet__trigger) {
		display: none;
	}

	@media (max-width: 40rem) {
		:global(.nav-dropdown) {
			display: none;
		}

		:global(.nav-sheet__trigger) {
			display: inline-flex;
		}
	}

	:global(.nav-sheet) {
		border-color: var(--border);
		padding-block-end: calc(var(--spacing-xl) + env(safe-area-inset-bottom, 0px));
	}

	/* No visible header above these rows any more (see NavMenu.tsx) — the
	   list carries its own top inset, where the header used to. */
	:global(.nav-sheet__list) {
		margin: 0;
		padding: var(--spacing-xl) var(--spacing-xl) 0;
		list-style: none;
	}

	/* A full-width row per project, at least 48px tall — a thumb-sized
	   target. The press is an opacity dip on touch-down (100ms, --ease-out),
	   the tap flash is off since that press replaces it, and
	   `touch-action: manipulation` drops the double-tap wait so the link
	   opens on the tap itself. */
	:global(.nav-sheet__item) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md);
		min-block-size: var(--spacing-6xl);
		padding-block: var(--spacing-lg);
		border-block-end: 1px solid var(--border);
		color: var(--text);
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
		touch-action: manipulation;
		transition: opacity 100ms var(--ease-out);
	}

	:global(.nav-sheet__list li:last-child .nav-sheet__item) {
		border-block-end: none;
	}

	:global(.nav-sheet__item:active) {
		opacity: 0.6;
	}

	:global(.nav-sheet__item:focus-visible) {
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
	}

	:global(.nav-sheet__item .icon) {
		flex-shrink: 0;
		color: var(--primary-text);
	}

	/* ---- Homepage: the nav arrives with the scroll ------------------------
	   On the homepage, while the reel is running (the same query as
	   home-reel.ts's REEL_QUERY), the nav is not there on the first screen:
	   the headline is. home-reel.ts fades it in as the headline hands over,
	   through `--reel-nav` on the shell, and shows the brand through
	   `--reel-brand` only once the headline's own T mark has flown up and
	   landed on top of it.

	   Scoped by `:has([data-reel])` on the body, so on any other page none of
	   this matches — the shell is persisted across navigations and keeps
	   whatever the homepage last wrote to it, but nothing here reads it.

	   Registered so the initial value is 0 (hidden, matching the headline's
	   first frame before the script has run) and so a write to the shell
	   restyles the shell alone, not everything that would inherit it.

	   While hidden it keeps its place in the accessibility tree and in the tab
	   order — a reader who tabs into it gets it back at full strength — but
	   drops the pointer (`data-reel-hidden`, set by the script), so nothing
	   invisible sits over the top of the headline. */
	@property --reel-nav {
		syntax: '<number>';
		inherits: false;
		initial-value: 0;
	}

	@property --reel-brand {
		syntax: '<number>';
		inherits: false;
		initial-value: 0;
	}

	@media (min-width: 64rem) and (prefers-reduced-motion: no-preference) and (scripting: enabled) {
		:global(body:has([data-reel])) .nav-shell {
			opacity: var(--reel-nav);
		}

		:global(body:has([data-reel])) .nav__brand {
			opacity: var(--reel-brand);
		}

		:global(body:has([data-reel])) .nav-shell[data-reel-hidden] {
			pointer-events: none;
		}

		:global(body:has([data-reel])) .nav-shell:focus-within,
		:global(body:has([data-reel])) .nav-shell:focus-within .nav__brand {
			opacity: 1;
			pointer-events: auto;
		}
	}

	.nav__brand:focus-visible,
	.nav__link:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-xs);
	}

	:global(.nav-dropdown__trigger:focus-visible) {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-xs);
	}
</style>

<script>
	/* The "Side projects" panel's own hover choreography (nav-dropdown.ts)
	   is wired up from inside NavMenu.tsx itself, via useEffect — not here.
	   That panel lives inside a client:load React island, and a plain
	   Astro <script> has no reliable way to know whether it's running
	   before, during or after that island's hydration; see NavMenu.tsx for
	   why that ordering actually matters (a hydration-mismatch bug, not
	   just tidiness). */

	/* The nav sits directly on the page with no pane of its own, which works
	   for as long as the only thing behind it is the water field and stops
	   working the moment real content scrolls up underneath it. `--nav-scrim`
	   ramps a solid `--bg` band in behind the row over the last stretch of
	   scroll before that happens, so the links are never read against a card.

	   Opt-in per page, via `data-nav-scrim` on the first thing that scrolls up
	   under the nav — each page's own content column, so the ramp starts at the
	   top of the content rather than at the top of the padding above it
	   (about.astro's `.about__frame`; on the homepage, a marker at the end of
	   the reel, since nothing inside the pinned reel ever passes under the
	   nav and the footer is the first thing that does). The nav
	   can't know that on its own, and a page with nothing marked just never
	   paints a band. One target per page is enough: progress clamps at 1, so
	   once that column has passed under the nav the band stays on for
	   everything below it.

	   Scrubbed 1:1 to scroll position rather than transitioned on a class
	   toggle, same reasoning as index.astro's own hero fade: the band should
	   track the scroll gesture and reverse cleanly on the way back up, not
	   play a fixed-length animation that happens to start when a threshold is
	   crossed. The ease-out lives in the curve applied to that progress
	   instead of in a `transition-timing-function`.

	   The ramp's length is the band's own height, measured — so there is no
	   magic number here to keep in sync with the nav's size, and the fade
	   always takes exactly one band-height of scroll. Cubed ease-out
	   front-loads it inside that: the band is ~88% in when the content is
	   still half a band below, so it has visibly arrived *before* the overlap
	   rather than racing it. */
	const shell = document.querySelector<HTMLElement>('.nav-shell');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	let scrimTarget: HTMLElement | null = null;
	let scrimTicking = false;

	const updateScrim = () => {
		scrimTicking = false;
		if (!shell) return;

		if (!scrimTarget) {
			shell.style.setProperty('--nav-scrim', '0');
			return;
		}

		/* The shell is pinned to the top of the viewport, so its height and
		   the y of its bottom edge are the same number. `gap` is the distance
		   from that edge down to the top of the section coming up to meet it:
		   0 is the moment they touch and the fade begins, -band is when it completes. */
		const band = shell.getBoundingClientRect().height;
		const gap = scrimTarget.getBoundingClientRect().top - band;
		const progress = band > 0 ? Math.min(Math.max(-gap / band, 0), 1) : 0;

		/* Under reduced motion the band still appears — it is legibility, not
		   decoration — but it snaps on at the overlap itself instead of
		   tracking the scroll. */
		const scrim = reduceMotion.matches ? (progress >= 1 ? 1 : 0) : 1 - (1 - progress) ** 3;

		shell.style.setProperty('--nav-scrim', String(scrim));
	};

	const onScrimScroll = () => {
		if (scrimTicking) return;
		scrimTicking = true;
		requestAnimationFrame(updateScrim);
	};

	/* Re-resolved rather than captured once: the nav is `transition:persist`ed
	   across Work<->About, so this script body runs on the first load only,
	   while the element it watches is replaced on every swap. */
	const resolveScrimTarget = () => {
		scrimTarget = document.querySelector<HTMLElement>('[data-nav-scrim]');
		updateScrim();
	};

	if (shell) {
		window.addEventListener('scroll', onScrimScroll, { passive: true });
		window.addEventListener('resize', onScrimScroll, { passive: true });
		document.addEventListener('astro:after-swap', resolveScrimTarget);
		resolveScrimTarget();
	}
</script>
