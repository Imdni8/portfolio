---
import { NavMenu } from './NavMenu';
import logoMark from '../../assets/nav/logo.svg?raw';

/* Which link wears the current-page state, read off the URL rather than
   hardcoded — the nav is rendered by every page that has one, so a literal
   here marks the wrong link the moment there is more than one such page.
   `startsWith` on /about so a future /about/… subpage keeps the mark; the
   work index is an exact match, since /work/<slug> pages render no nav. */
const path = Astro.url.pathname;
const onWork = path === '/' || path === '';
const onAbout = path.startsWith('/about');
---

<header class="nav-shell" transition:persist>
	<div class="nav-shell__inner">
		<a class="nav__brand" href="/" aria-label="Tousif Rahaman — home" set:html={logoMark} />

		<div class="nav__group">
			<nav class="nav__links" aria-label="Primary">
				<a class="nav__link text-sm" href="/" aria-current={onWork ? 'page' : undefined}>Work</a>
				<a class="nav__link text-sm" href="/about" aria-current={onAbout ? 'page' : undefined}>About</a>
			</nav>

			<NavMenu client:load />
		</div>
	</div>
</header>

<style>
	/* Floats over both the water-field hero and the plain-background cards
	   section below, so it's fixed rather than scoped to either. No pane, no
	   glass, no card — brand mark on the left, everything else clustered on
	   the right, all sitting directly on the page.

	   Full-bleed, unlike the row it holds: the band that fades in behind it
	   (::before) has to reach both viewport edges, so the shell spans the
	   viewport and `.nav-shell__inner` carries the gutter and the content cap
	   the header used to hold itself. The `--spacing-3xl` inset became
	   `--spacing-lg` of padding, mirrored below the row so the band is even
	   on both sides — 12 + 36 + 12, which puts the band's bottom edge at 60px,
	   exactly where the row's own bottom edge used to sit. That's why
	   `--nav-footprint` (index.astro, about.astro) is untouched: the nav takes
	   up the same room as before, it just fills it now. */
	.nav-shell {
		position: fixed;
		inset-block-start: 0;
		inset-inline: 0;
		z-index: 20;
		padding-block: var(--spacing-sm);
		padding-inline: var(--gutter);
	}

	.nav-shell__inner {
		max-width: var(--measure-content);
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	/* The band. A pseudo-element rather than a background on `.nav-shell`
	   itself, because the ramp is an opacity and painting it on the shell
	   would take the brand and the links down with it. `z-index: -1` puts it
	   behind them without leaving the shell's own stacking context, so the
	   whole nav still sits above the page at 20.

	   `--nav-scrim` is written every scroll frame by the script below. Unset
	   — no JS, or a page with nothing marked `data-nav-scrim` — it falls back
	   to 0 and the nav stays exactly as transparent as it is today. */
	.nav-shell::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
		opacity: var(--nav-scrim, 0);
	}

	.nav__brand {
		display: inline-flex;
		align-items: center;
		/* The mark's fill is currentColor, so the colour is named in the
		   semantic layer now rather than baked into the path. --brand-mark,
		   not --primary-text: this is the logo, and it holds the same orange
		   as the footer mascot's swoosh on both themes. */
		color: var(--brand-mark);
	}

	/* :global() on both of these: the <svg> arrives via set:html, so it has
	   no scope attribute for an unqualified `svg` to match. */
	.nav__brand :global(svg) {
		display: block;
		height: 1.75rem;
		width: auto;
	}

	/* Work/About and the Side-projects trigger cluster together on the right
	   as one visual group, with the same gap between all three items —
	   .nav__links and NavMenu stay two separate elements underneath (Base
	   UI's NavigationMenu owns only the dropdown; Work/About have nowhere to
	   open and stay plain anchors), but this wrapper is what makes them read
	   as one row instead of two. */
	.nav__group {
		display: flex;
		align-items: center;
		gap: var(--spacing-3xl);
	}

	.nav__links {
		display: flex;
		align-items: center;
		gap: var(--spacing-3xl);
	}

	/* text-sm (Tailwind) replaces .type-nav-link's --size-ui (16px) here —
	   font-family/weight still come from tokens.css, since dropping them
	   would silently fall back to Tailwind's system-font stack. .type-nav-link
	   itself is untouched (the chapter rail and Tabs still wear it at 16px);
	   this is the nav opting into the smaller Tailwind scale on its own. */
	.nav__link {
		font-family: var(--font-sans);
		font-weight: var(--weight-medium);
		padding-block: var(--spacing-md);
		padding-inline: var(--spacing-xs);
		color: var(--text-muted);
		text-decoration: none;
	}

	.nav__link:hover {
		color: var(--text);
	}

	/* Active state carries weight and colour together — never colour alone —
	   just without the sliding underline bar this used to pair with. */
	.nav__link[aria-current='page'] {
		color: var(--primary-text);
		font-weight: var(--weight-bold);
	}

	/* .nav-dropdown is NavMenu.tsx's <NavigationMenu> root — a React island,
	   so (unlike everything above) none of the rules from here down get
	   Astro's scope attribute on the elements they need to match; every
	   selector below is :global() for that reason.

	   Base UI's own NavigationMenu.Root ships flex-1 (Tailwind, in
	   navigation-menu.tsx) — meant for a root that spans a full menu bar,
	   wrong for a fixed-content trigger sitting beside `.nav__links`.
	   `flex: 0 0 auto` overrides it outright rather than fighting the
	   individual grow/shrink longhands piecemeal. */
	:global(.nav-dropdown) {
		position: relative;
		display: flex;
		align-items: center;
		flex: 0 0 auto;
	}

	/* Same padding/colour treatment as .nav__link, so "Side projects" reads
	   as the third item in one row rather than a visually distinct control.
	   background-color: transparent overrides shadcn's own default
	   hover/open background (Tailwind, navigation-menu.tsx: hover:bg-muted,
	   focus:bg-muted, data-popup-open:bg-muted/50) — those are layered
	   utilities, so one unlayered declaration here beats all of them
	   regardless of which :hover/[data-popup-open] state is active, the
	   same fix already used on .nav-dropdown__item below. height: auto
	   overrides Base UI's own fixed h-9 so it doesn't clip .nav__group's
	   align-items: center row differently from a plain link's line height. */
	:global(.nav-dropdown__trigger) {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		height: auto;
		font-family: var(--font-sans);
		font-weight: var(--weight-medium);
		padding-block: var(--spacing-md);
		padding-inline: var(--spacing-xs);
		color: var(--text-muted);
		background-color: transparent;
		cursor: pointer;
	}

	/* data-popup-open is Base UI's own attribute on the trigger button
	   itself (see NavigationMenuTrigger in navigation-menu.tsx). */
	:global(.nav-dropdown__trigger:hover),
	:global(.nav-dropdown__trigger[data-popup-open]) {
		color: var(--text);
	}

	/* :global() because the chevron span is rendered by navigation-menu.tsx's
	   own Icon usage, not this component's template. Rotation on open is
	   handled there too, as a Tailwind group-data variant on the icon. */
	:global(.nav-dropdown) :global(.nav-dropdown__chevron) {
		color: var(--primary-text);
	}

	/* The popup surface now wears shadcn's own default look (bg-popover,
	   ring-foreground, shadow, rounded-lg — all sourced from tokens.css via
	   the tailwind.css bridge), not `.glass`. min-width/box-sizing are the
	   only overrides left. */
	:global(.nav-dropdown__popup) {
		/* Pinned explicitly: `min-width` is a content-box measurement, and
		   about.astro (unlike this component's other host, index.astro)
		   applies a page-scoped `box-sizing: border-box` reset. Without this,
		   the same min-width nets 32px less room on the about page
		   (padding-inline counted inward instead of added on) and wraps
		   "Amplitude taxonomy exporter" onto a third line. */
		box-sizing: content-box;
		/* Wide enough that the longest label still fits on one line *while
		   hovered*, not just at rest. Base UI measures `--popup-width` from
		   the content once, when the menu opens, and then holds it — but
		   .nav-dropdown__item's hover state adds `padding-inline-start`,
		   taking var(--spacing-lg) back off the label after that measurement
		   is locked in. At the old 14rem the measured width left under a
		   pixel of slack, so hovering "Amplitude taxonomy exporter" reflowed
		   it onto a second line and the row jumped. This floor keeps roughly
		   the shift's width in reserve on both sides of the hover. */
		min-width: 21rem;
	}

	/* padding (all four sides, not just padding-inline) overrides Base UI's
	   own p-1 on NavigationMenuContent — the panel has no block padding of
	   its own, since each .nav-dropdown__item supplies its own. */
	:global(.nav-dropdown__panel) {
		padding: 0 var(--spacing-xl);
		display: flex;
		flex-direction: column;
	}

	/* Resting state is dim; hover/focus bring text, arrow and border to full
	   opacity together and nudge the label right — never colour alone. The
	   one transition covers both properties so they move in lockstep. GSAP
	   (nav-dropdown.ts) drives the hoverline draw-in and the arrow's
	   diagonal entrance/exit, which a CSS transition can't express. */
	:global(.nav-dropdown__item) {
		position: relative;
		overflow: hidden; /* clips the arrow while it's parked off-frame */
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-xl) var(--spacing-xl) var(--spacing-xl) 0;
		color: var(--text);
		text-decoration: none;
		opacity: 0.6;
		background-color: transparent;
		border-bottom: 1px solid var(--border);
		transition: 0.8s cubic-bezier(0.19, 1, 0.22, 1);
	}

	:global(.nav-dropdown__item:last-child) {
		border-bottom: none;
	}

	/* background-color: transparent again here, not just on the base rule
	   above — NavigationMenuLink's own hover:bg-muted/focus:bg-muted (Tailwind,
	   navigation-menu.tsx) target the same :hover/:focus-visible state, and
	   cascade layers only settle ties at matching specificity+state; this
	   project's opacity/padding-shift hover treatment, not a background
	   swap, is what's meant to read here. */
	:global(.nav-dropdown__item:hover),
	:global(.nav-dropdown__item:focus-visible) {
		background-color: transparent;
		opacity: 1;
		padding-inline-start: var(--spacing-lg);
	}

	:global(.nav-dropdown__item:focus-visible) {
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
	}

	/* The label takes the row's leftover width instead of sitting at its own
	   max-content size. That extra width is never *used* — the text is the
	   same length either way — but a flex item sized to max-content lands a
	   fraction of a pixel short of the line it is supposed to hold (Inter is
	   a variable font; the intrinsic measurement rounds down where the line
	   box rounds up), which is enough to wrap a label that visibly fits.
	   Growing into the free space the popup's min-width above provides puts
	   real slack between the label's box and its text, so the break point no
	   longer sits on a rounding boundary. Nothing moves: the arrow is already
	   pinned right by the item's justify-content, and this only changes where
	   the label's (transparent) box ends. */
	:global(.nav-dropdown__item-label) {
		flex-grow: 1;
	}

	/* translate: a generic "safely outside any real row" default, not the
	   item's own precise offsetHeight — nav-dropdown.ts's enter/leave tweens
	   measure that exactly on every interaction, so this only has to hold
	   up for the brief window (or the reduced-motion case, which never
	   tweens at all) before a node's first real hover. Needing this at all,
	   rather than only ever setting it from JS, is the fix for Base UI
	   recreating these nodes on interaction — a freshly swapped-in arrow
	   has never been touched by GSAP and must already look "at rest". */
	/* align-self: flex-start (overriding the item's own align-items: center
	   just for this child) + a top margin sized to centre a 1rem icon inside
	   one line of .type-ui-label (line-height 1.5 × 16px = 24px, so (24-16)/2
	   = 4px) — aligns the arrow with the label's *first* line specifically.
	   Centring against the item's full height instead (the item's own
	   align-items) puts the arrow in the gap between lines the moment a
	   label wraps, e.g. "Amplitude taxonomy exporter" — floating disconnected
	   from either line rather than reading as this row's icon. */
	:global(.nav-dropdown__item-arrow) {
		width: 1rem;
		height: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		align-self: flex-start;
		margin-block-start: 0.25rem;
		transform: translate(-6rem, 6rem);
	}

	/* scaleX(0) from the left edge is this element's own "at rest" —
	   same reasoning as the arrow's translate above. */
	:global(.nav-dropdown__item-hoverline) {
		position: absolute;
		inset: auto auto 0 0;
		width: 100%;
		height: 1px;
		background: var(--primary-text);
		transform: scaleX(0);
		transform-origin: 0% 50%;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.nav-dropdown__item) {
			transition-duration: 0.01ms;
		}
	}

	.nav__brand:focus-visible,
	.nav__link:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-xs);
	}

	:global(.nav-dropdown__trigger:focus-visible) {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-xs);
	}
</style>

<script>
	/* The "Side projects" panel's own hover choreography (nav-dropdown.ts)
	   is wired up from inside NavMenu.tsx itself, via useEffect — not here.
	   That panel lives inside a client:load React island, and a plain
	   Astro <script> has no reliable way to know whether it's running
	   before, during or after that island's hydration; see NavMenu.tsx for
	   why that ordering actually matters (a hydration-mismatch bug, not
	   just tidiness). */

	/* Keeps `aria-current` (and with it, .nav__link[aria-current='page']'s
	   colour/weight) honest about the URL. The nav is `transition:persist`ed
	   across the Work<->About navigation, so this script body only ever runs
	   once, on the very first load — this has to be event-driven rather than
	   re-run per navigation, which is exactly what `astro:after-swap` is for. */
	const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav__link');

	const syncActiveLink = () => {
		const onWorkNow = location.pathname === '/' || location.pathname === '';
		const onAboutNow = location.pathname.startsWith('/about');

		for (const link of navLinks) {
			const current = link.getAttribute('href') === '/' ? onWorkNow : onAboutNow;
			if (current) {
				link.setAttribute('aria-current', 'page');
			} else {
				link.removeAttribute('aria-current');
			}
		}
	};

	syncActiveLink();
	document.addEventListener('astro:after-swap', syncActiveLink);

	/* The nav sits directly on the page with no pane of its own, which works
	   for as long as the only thing behind it is the water field and stops
	   working the moment real content scrolls up underneath it. `--nav-scrim`
	   ramps a solid `--bg` band in behind the row over the last stretch of
	   scroll before that happens, so the links are never read against a card.

	   Opt-in per page, via `data-nav-scrim` on whatever section does the
	   scrolling-under (index.astro's `.work`) — the nav can't know that on
	   its own, and a page with nothing marked just never paints a band.

	   Scrubbed 1:1 to scroll position rather than transitioned on a class
	   toggle, same reasoning as index.astro's own hero fade: the band should
	   track the scroll gesture and reverse cleanly on the way back up, not
	   play a fixed-length animation that happens to start when a threshold is
	   crossed. The ease-out lives in the curve applied to that progress
	   instead of in a `transition-timing-function`.

	   The ramp's length is the band's own height, measured — so there is no
	   magic number here to keep in sync with the nav's size, and the fade
	   always takes exactly one band-height of scroll. Cubed ease-out
	   front-loads it inside that: the band is ~88% in when the content is
	   still half a band below, so it has visibly arrived *before* the overlap
	   rather than racing it. */
	const shell = document.querySelector<HTMLElement>('.nav-shell');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	let scrimTarget: HTMLElement | null = null;
	let scrimTicking = false;

	const updateScrim = () => {
		scrimTicking = false;
		if (!shell) return;

		if (!scrimTarget) {
			shell.style.setProperty('--nav-scrim', '0');
			return;
		}

		/* The shell is pinned to the top of the viewport, so its height and
		   the y of its bottom edge are the same number. `gap` is the distance
		   from that edge down to the top of the section coming up to meet it:
		   0 is the moment they touch and the fade begins, -band is when it completes. */
		const band = shell.getBoundingClientRect().height;
		const gap = scrimTarget.getBoundingClientRect().top - band;
		const progress = band > 0 ? Math.min(Math.max(-gap / band, 0), 1) : 0;

		/* Under reduced motion the band still appears — it is legibility, not
		   decoration — but it snaps on at the overlap itself instead of
		   tracking the scroll. */
		const scrim = reduceMotion.matches ? (progress >= 1 ? 1 : 0) : 1 - (1 - progress) ** 3;

		shell.style.setProperty('--nav-scrim', String(scrim));
	};

	const onScrimScroll = () => {
		if (scrimTicking) return;
		scrimTicking = true;
		requestAnimationFrame(updateScrim);
	};

	/* Re-resolved rather than captured once: the nav is `transition:persist`ed
	   across Work<->About, so this script body runs on the first load only,
	   while the element it watches is replaced on every swap. */
	const resolveScrimTarget = () => {
		scrimTarget = document.querySelector<HTMLElement>('[data-nav-scrim]');
		updateScrim();
	};

	if (shell) {
		window.addEventListener('scroll', onScrimScroll, { passive: true });
		window.addEventListener('resize', onScrimScroll, { passive: true });
		document.addEventListener('astro:after-swap', resolveScrimTarget);
		resolveScrimTarget();
	}
</script>
