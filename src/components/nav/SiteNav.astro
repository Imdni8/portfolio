---
import Icon from '../ui/Icon.astro';

const sideProjects = [
	{ label: 'Goalaris', href: 'https://goalaris-beta.vercel.app/' },
	{
		label: 'Amplitude taxonomy exporter',
		href: 'https://www.figma.com/community/plugin/1512420394545664823',
	},
];

/* Which link wears the current-page state, read off the URL rather than
   hardcoded — the nav is rendered by every page that has one, so a literal
   here marks the wrong link the moment there is more than one such page.
   `startsWith` on /about so a future /about/… subpage keeps the mark; the
   work index is an exact match, since /work/<slug> pages render no nav. */
const path = Astro.url.pathname;
const onWork = path === '/' || path === '';
const onAbout = path.startsWith('/about');
---

<header class="nav-shell">
	<div class="nav glass" data-nav-tint-pane>
		<a class="nav__brand" href="/" aria-label="Tousif Rahaman — home">
			<svg width="21" height="40" viewBox="0 0 21 40" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path
					d="M2.09494 27.9217L2.09135 27.9327C-0.987036 39.1414 4.65474 40.3816 8.28926 39.1414C14.864 36.8981 19.2941 17.3495 19.8281 10.4076C20.2806 4.52502 20.416 0.957926 17.7114 0.0678851C15.0068 -0.822156 8.21541 7.17745 5.23237 15.9775C8.464 7.42604 15.325 -0.57845 17.7114 0.763919C20.0978 2.10629 18.4859 9.58937 18.0181 13.1226C16.6477 21.6624 13.3006 28.9838 11.4104 32.0091C9.76924 34.5077 7.72161 35.8065 5.23237 34.8427C3.20454 34.0186 3.10782 31.1787 3.89244 28.5031L3.89525 28.4942C5.68927 20.6889 9.22578 17.2859 10.8007 16.574C11.0493 16.4617 11.6956 15.9075 10.2538 16.1266C8.21388 16.4367 3.28015 18.0009 0.0502259 21.5944C-0.0232912 21.6762 -0.0143885 21.8025 0.0683472 21.875C0.634719 22.371 0.927832 22.6513 1.49036 23.1443C1.57759 23.2207 1.71112 23.2068 1.78152 23.1147C3.00813 21.5085 5.92118 18.3601 8.7825 17.3495C5.49376 20.0414 3.42594 23.9795 2.09494 27.9217Z"
					fill="#EF942B"></path>
			</svg>
		</a>

		<!-- Hidden mirror of the side-projects pill (+ the gap in front of it),
		     so the brand/spacer bookend centres Work/About against the midpoint
		     of the whole two-pane row instead of just this pane — same
		     correction the Paper reference makes with a fixed left offset on
		     its link group, done here as a real element so it tracks the pill's
		     actual rendered width instead of a number that goes stale the
		     moment its copy or icon changes. It sits *after* the brand rather
		     than in front of it: only the total width ahead of .nav__links
		     decides where the pair centres, so parking it here leaves the
		     centring untouched while letting the logo sit flush against the
		     pane's own padding edge. -->
		<div class="nav-dropdown-mirror nav-dropdown" aria-hidden="true">
			<span class="nav-dropdown__trigger type-ui-label glass" data-nav-tint-pane>
				Side projects
				<Icon name="chevron-down" class="nav-dropdown__chevron" />
			</span>
		</div>

		<nav class="nav__links" aria-label="Primary">
			<a class="nav__link type-nav-link" href="/" aria-current={onWork ? 'page' : undefined}>Work</a>
			<a class="nav__link type-nav-link" href="/about" aria-current={onAbout ? 'page' : undefined}>About</a>
		</nav>

		<!-- Mirrors the brand mark so the link group centres against two equal
		     bookends instead of skewing toward the visible logo on the left —
		     same trick as the Paper file's own hidden spacer. -->
		<svg
			class="nav__spacer"
			aria-hidden="true"
			width="21"
			height="40"
			viewBox="0 0 21 40"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="M2.09494 27.9217L2.09135 27.9327C-0.987036 39.1414 4.65474 40.3816 8.28926 39.1414C14.864 36.8981 19.2941 17.3495 19.8281 10.4076C20.2806 4.52502 20.416 0.957926 17.7114 0.0678851C15.0068 -0.822156 8.21541 7.17745 5.23237 15.9775C8.464 7.42604 15.325 -0.57845 17.7114 0.763919C20.0978 2.10629 18.4859 9.58937 18.0181 13.1226C16.6477 21.6624 13.3006 28.9838 11.4104 32.0091C9.76924 34.5077 7.72161 35.8065 5.23237 34.8427C3.20454 34.0186 3.10782 31.1787 3.89244 28.5031L3.89525 28.4942C5.68927 20.6889 9.22578 17.2859 10.8007 16.574C11.0493 16.4617 11.6956 15.9075 10.2538 16.1266C8.21388 16.4367 3.28015 18.0009 0.0502259 21.5944C-0.0232912 21.6762 -0.0143885 21.8025 0.0683472 21.875C0.634719 22.371 0.927832 22.6513 1.49036 23.1443C1.57759 23.2207 1.71112 23.2068 1.78152 23.1147C3.00813 21.5085 5.92118 18.3601 8.7825 17.3495C5.49376 20.0414 3.42594 23.9795 2.09494 27.9217Z"
				fill="#EF942B"></path>
		</svg>
	</div>

	<details class="nav-dropdown">
		<summary class="nav-dropdown__trigger type-nav-link glass" data-nav-tint-pane>
			Side projects
			<Icon name="chevron-down" class="nav-dropdown__chevron" />
		</summary>
		<div class="nav-dropdown__panel glass">
			{
				sideProjects.map(({ label, href }) => (
					<a class="nav-dropdown__item" href={href} target="_blank" rel="noopener noreferrer">
						<span class="nav-dropdown__item-label type-ui-label">{label}</span>
						<span class="nav-dropdown__item-arrow">
							<Icon name="arrow-up-right" />
						</span>
						<span class="nav-dropdown__item-hoverline" />
					</a>
				))
			}
		</div>
	</details>
</header>

<style>
	/* Floats over both the water-field hero and the plain-background cards
	   section below, so it's fixed rather than scoped to either. Two separate
	   panes now — the primary links and the side-project trigger — laid out
	   as siblings in one row instead of one bar with a divider. */
	.nav-shell {
		position: fixed;
		inset-block-start: var(--spacing-3xl);
		inset-inline: var(--gutter);
		z-index: 20;
		max-width: var(--measure-content);
		margin-inline: auto;
		display: flex;
		align-items: stretch;
		gap: var(--spacing-3xl);
	}

	/* .nav and .nav-dropdown__trigger wear `.glass` in the markup — identical
	   material, so they read as one surface split into two pieces. The rule
	   lives in components.css now that the work cards (and the dropdown
	   panel) are cut from it too; the filter it references comes from
	   <GlassDefs />, rendered once by the page.

	   `.glass` sits on .nav-dropdown__trigger (the summary), not on
	   .nav-dropdown (the <details> wrapping it and the panel): backdrop-filter
	   establishes a stacking context, and a backdrop-filter element nested
	   inside another one only sees what its ancestor has already painted —
	   not the real page behind it. With .glass on the outer <details>, the
	   panel (its child) blurred against almost nothing and the grid showed
	   through. Keeping <details> unfiltered and giving trigger and panel their
	   own .glass each lets both sample the actual backdrop independently, at
	   the same strength. */

	/* 32px of padding, not 16 — the logo reads as the pane's left edge, and
	   symmetric padding drops out of the centring maths entirely (it shifts
	   the brand and the hidden spacer by the same amount), so widening it
	   moves the logo without moving Work/About. */
	.nav {
		flex: 1;
		display: flex;
		align-items: center;
		padding-inline: var(--spacing-4xl);
	}

	.nav__brand {
		display: inline-flex;
		align-items: center;
		color: inherit;
	}

	.nav__brand svg {
		display: block;
		height: 1.75rem;
		width: auto;
	}

	/* flex: 1 + centering (not justify-content: space-between across the whole
	   bar) is what actually centres the link pair between the brand and the
	   spacer — space-between across three unequal-width groups only balances
	   the two gaps, not the group itself. */
	.nav__links {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-3xl);
	}

	.nav__link {
		padding-block: var(--spacing-md);
		padding-inline: var(--spacing-xs);
		color: var(--text-muted);
		text-decoration: none;
		/* Reserved even when inactive so the active state doesn't shift layout. */
		border-block-end: 1px solid transparent;
	}

	.nav__link:hover {
		color: var(--text);
	}

	/* Active state carries weight, colour and an underline together — never
	   colour alone. */
	.nav__link[aria-current='page'] {
		color: var(--primary-text);
		font-weight: var(--weight-bold);
		border-block-end-color: var(--primary-text);
	}

	.nav__spacer {
		display: block;
		height: 1.75rem;
		width: auto;
		visibility: hidden;
	}

	.nav-dropdown-mirror {
		visibility: hidden;
		pointer-events: none;
		/* The gap nav-shell puts between the real .nav and .nav-dropdown panes —
		   reproduced here since this mirror sits inside .nav, outside that
		   flex row. */
		margin-inline-end: var(--spacing-3xl);
	}

	/* align-items: stretch (not center) — `.nav-dropdown` is itself stretched
	   to match `.nav`'s height by `.nav-shell`'s own align-items: stretch, but
	   that only sets the *wrapper*'s height. Centring the trigger inside it
	   left the visible glass pill shorter than that wrapper, floating with a
	   gap above and below instead of filling the row like `.nav` does.
	   Stretching the trigger too makes its glass pill match the row height;
	   the panel's `inset-block-start: calc(100% + …)` already measures off
	   this wrapper's full height (not the trigger's), so it's unaffected. */
	.nav-dropdown {
		position: relative;
		flex-shrink: 0;
		display: flex;
		align-items: stretch;
	}

	.nav-dropdown__trigger {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		padding-block: var(--spacing-md);
		padding-inline: var(--spacing-lg);
		color: var(--text-muted);
		cursor: pointer;
		list-style: none;
	}

	.nav-dropdown__trigger::-webkit-details-marker {
		display: none;
	}

	/* Keyed off [open] as well as :hover: the panel is a sibling of the
	   summary, not a descendant of it, so :hover on the trigger alone drops
	   the instant the pointer moves off the summary into the panel/links —
	   even though the dropdown (kept open by the hover-toggle JS) still
	   reads as active the whole time the pointer is anywhere inside it. */
	.nav-dropdown__trigger:hover,
	.nav-dropdown[open] .nav-dropdown__trigger {
		color: var(--text);
	}

	/* :global() because the chevron span is rendered by Icon.astro, not this
	   component — Astro scopes each style block to the elements its own
	   template renders, so an unqualified `.nav-dropdown__chevron` here would
	   never match a span another component created, even with the class
	   passed down as a prop. */
	.nav-dropdown :global(.nav-dropdown__chevron) {
		color: var(--primary-text);
		transition: transform 0.15s ease;
	}

	.nav-dropdown[open] :global(.nav-dropdown__chevron) {
		transform: rotate(180deg);
	}

	/* Border, radius and background come from .glass now (components.css) —
	   this only adds the positioning and layout .glass doesn't know about. */
	.nav-dropdown__panel {
		position: absolute;
		inset-block-start: calc(100% + var(--spacing-md));
		inset-inline-end: 0;
		min-width: 14rem;
		padding-inline: var(--spacing-xl);
		display: flex;
		flex-direction: column;
	}

	/* Resting state is dim; hover/focus bring text, arrow and border to full
	   opacity together and nudge the label right — never colour alone. The one
	   transition covers both properties so they move in lockstep. GSAP (see
	   nav-dropdown.ts) drives the hoverline draw-in and the arrow's diagonal
	   entrance/exit, which a CSS transition can't express. */
	.nav-dropdown__item {
		position: relative;
		overflow: hidden; /* clips the arrow while it's parked off-frame */
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-xl) var(--spacing-xl) var(--spacing-xl) 0;
		color: var(--text);
		text-decoration: none;
		opacity: 0.6;
		border-bottom: 1px solid var(--border);
		transition: 0.8s cubic-bezier(0.19, 1, 0.22, 1);
	}

	.nav-dropdown__item:last-child {
		border-bottom: none;
	}

	.nav-dropdown__item:hover,
	.nav-dropdown__item:focus-visible {
		opacity: 1;
		padding-inline-start: var(--spacing-lg);
	}

	.nav-dropdown__item:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
	}

	.nav-dropdown__item-arrow {
		width: 1rem;
		height: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.nav-dropdown__item-hoverline {
		position: absolute;
		inset: auto auto 0 0;
		width: 100%;
		height: 1px;
		background: var(--primary-text);
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-dropdown__item {
			transition-duration: 0.01ms;
		}
	}

	.nav__brand:focus-visible,
	.nav__link:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-xs);
	}

	/* No border-radius override here, unlike the pair above: those have no
	   radius of their own, so this rule was giving the outline one to follow.
	   The trigger now wears `.glass`, which already sets --radius-md — adding
	   --radius-xs here would shrink its corners the moment it's focused. */
	.nav-dropdown__trigger:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}
</style>

<script>
	import { initNavDropdownHoverAnimation, initNavDropdownHoverToggle } from './nav-dropdown';
	import { initNavTint } from './nav-tint';

	for (const details of document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown')) {
		initNavDropdownHoverToggle(details);
	}

	for (const panel of document.querySelectorAll<HTMLElement>('.nav-dropdown__panel')) {
		initNavDropdownHoverAnimation(panel);
	}

	const shell = document.querySelector<HTMLElement>('.nav-shell');
	if (shell) initNavTint(shell);
</script>
