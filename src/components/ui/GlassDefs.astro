---
/**
 * The refraction filter `.glass` reaches for. Render this once per page that
 * uses `.glass` — it was inline in SiteNav while the nav was the only glass
 * surface, but the work cards wear the same material now and a filter can
 * only be defined once per document.
 *
 * Not optional where the browser takes the refraction branch: a `url()` that
 * resolves to nothing invalidates the whole `backdrop-filter` declaration
 * rather than falling back to the plain blur, which paints the pane fully
 * see-through. See the @supports comment in components.css.
 *
 * Inert — zero size, aria-hidden, no pointer surface.
 */
---

<svg class="glass-defs" aria-hidden="true" focusable="false">
	<filter id="glass-refraction" x="-20%" y="-20%" width="140%" height="140%">
		<feTurbulence type="fractalNoise" baseFrequency="0.012 0.018" numOctaves="2" seed="7" result="noise" />
		<feGaussianBlur in="noise" stdDeviation="3" result="softNoise" />
		<feDisplacementMap in="SourceGraphic" in2="softNoise" scale="18" xChannelSelector="R" yChannelSelector="G" />
	</filter>
</svg>

<style>
	.glass-defs {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}
</style>
