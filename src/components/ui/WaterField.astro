---
/**
 * A pool, sitting behind whatever you put in front of it.
 *
 * Absolutely positioned and inert to the pointer, so it fills its nearest
 * positioned ancestor and never intercepts a click. The engine listens on the
 * window and maps the cursor into the canvas itself — see water-field.ts.
 */
interface Props {
	/** Grid pitch in CSS pixels. 0 draws no grid. */
	grid?: number;
	/** Presence of the fluid, 0–1. Lower it behind dense copy. */
	intensity?: number;
	class?: string;
}

const { grid = 72, intensity = 1, class: className } = Astro.props;
---

<canvas
	class:list={['water-field', className]}
	data-water-field
	data-grid={grid}
	data-intensity={intensity}
	aria-hidden="true"></canvas>

<script>
	import { createWaterField, type WaterField } from './water-field';

	/* A bundled module script only ever executes once, but this canvas isn't
	   persisted — Work<->About swaps in a fresh one on every navigation, so
	   without a re-run the field would only ever animate on whichever page
	   happened to load first. `astro:page-load` fires both on that first load
	   and after every subsequent swap, but only on a page carrying
	   `<ClientRouter/>` — CaseStudyLayout deliberately carries none (see its
	   own comment: case studies are a hard navigation), so that event never
	   fires there at all, and a canvas rendered only from that listener would
	   sit uninitialised forever.

	   `[name="astro-view-transitions-enabled"]` is the meta tag `<ClientRouter/>`
	   stamps into the page — the same marker Astro's own router reads
	   internally to decide whether it's active on the current page — so it's
	   used here to pick exactly one path rather than running both and racing
	   them: calling `init()` immediately *and* still binding the listener on
	   a `<ClientRouter/>` page fires two `createWaterField` builds back to
	   back (the direct call, then the listener's own first firing for that
	   same load), and destroying and recreating a WebGL context that fast
	   was observed to leave the second `compileShader` call failing against
	   a not-yet-settled context (silent — `shader failed to compile — null`,
	   no field, on index/about's home canvas as well as this one). Splitting
	   on the marker keeps each page on a single, unraced init path: the
	   listener alone where the event will fire, a direct call where it won't. */
	let fields: WaterField[] = [];

	const init = () => {
		for (const field of fields) field.destroy();
		fields = [];

		for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas[data-water-field]')) {
			fields.push(
				createWaterField(canvas, {
					grid: Number(canvas.dataset.grid ?? 72),
					intensity: Number(canvas.dataset.intensity ?? 1),
				}),
			);
		}
	};

	if (document.querySelector('[name="astro-view-transitions-enabled"]')) {
		document.addEventListener('astro:page-load', init);
	} else {
		init();
	}
</script>
