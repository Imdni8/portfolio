---
/**
 * A pool, sitting behind whatever you put in front of it.
 *
 * Absolutely positioned and inert to the pointer, so it fills its nearest
 * positioned ancestor and never intercepts a click. The engine listens on the
 * window and maps the cursor into the canvas itself — see water-field.ts.
 */
interface Props {
	/** Grid pitch in CSS pixels. 0 draws no grid. */
	grid?: number;
	/** Presence of the fluid, 0–1. Lower it behind dense copy. */
	intensity?: number;
	/** Film grain amplitude, in 8-bit levels. 0 leaves only the dither. */
	grain?: number;
	/** How much of the crests' brightening is spent on warmth, 0–1. */
	bloom?: number;
	/** Corner falloff, 0–1 as a mix weight toward the sunken ground. */
	vignette?: number;
	class?: string;
}

/* Defaults are stated once, in water-field.ts — repeating them here would
   give each one two sources of truth, and the `??` in the script below is
   what keeps an unset prop reaching the engine as `undefined`. */
const { grid = 72, intensity = 1, grain, bloom, vignette, class: className } = Astro.props;
---

<canvas
	class:list={['water-field', className]}
	data-water-field
	data-grid={grid}
	data-intensity={intensity}
	data-grain={grain}
	data-bloom={bloom}
	data-vignette={vignette}
	aria-hidden="true"></canvas>

<script>
	import { createWaterField, type WaterField } from './water-field';

	/* A bundled module script only ever executes once, but this canvas isn't
	   persisted — Work<->About swaps in a fresh one on every navigation, so
	   without this the field would only ever animate on whichever page
	   happened to load first. `astro:page-load` fires both on that first load
	   and after every subsequent swap, so it's the one hook that covers both.

	   The instances from the outgoing page are torn down first — `destroy()`
	   cancels its rAF loop and releases its WebGL context — because the
	   canvas being detached from the DOM doesn't stop either on its own.
	   Recreating on every navigation without this would leak a WebGL context
	   (and a full set of window listeners) per visit, and contexts are a
	   resource the browser caps: a few dozen Work<->About trips would start
	   silently losing older ones. */
	let fields: WaterField[] = [];

	/* An absent attribute has to stay absent all the way to the engine, so its
	   own default applies — `Number(undefined)` is NaN, and a NaN uniform blanks
	   the field. */
	const num = (v: string | undefined) => (v === undefined || v === '' ? undefined : Number(v));

	document.addEventListener('astro:page-load', () => {
		for (const field of fields) field.destroy();
		fields = [];

		for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas[data-water-field]')) {
			fields.push(
				createWaterField(canvas, {
					grid: Number(canvas.dataset.grid ?? 72),
					intensity: Number(canvas.dataset.intensity ?? 1),
					grain: num(canvas.dataset.grain),
					bloom: num(canvas.dataset.bloom),
					vignette: num(canvas.dataset.vignette),
				}),
			);
		}
	});
</script>
