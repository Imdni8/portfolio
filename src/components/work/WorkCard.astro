---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';
import Tag from '../ui/Tag.astro';
import type { IconName } from '../ui/icons';

/** `kind` is the closed set that picks the icon; `label` is free text
 *  supplied per entry in frontmatter, so a new design-type value never
 *  touches this file. */
const ROLE_ICONS = {
	'design-type': 'figma',
	code: 'code-xml',
} as const satisfies Record<string, IconName>;

export interface WorkRole {
	kind: keyof typeof ROLE_ICONS;
	label: string;
}

interface Props {
	title: string;
	industry: string;
	year: number;
	technology: string;
	/** What kind of work this was — icon chips overlapping the cover. */
	roles?: readonly WorkRole[];
	/** Whether this project shipped a notable AI feature — rendered as the
	 *  first (leftmost) chip in the same row as `roles`, when true. */
	aiFeature?: boolean;
	thumbnail: { src: ImageMetadata; alt: string };
	href?: string;
	status?: 'coming-soon' | 'external';
	/** The collection entry's id, surfaced as `data-slug` purely so the click
	 *  can be attributed. The href alone would not do it: an `external` entry
	 *  points at someone else's domain, so there is no slug to parse out. */
	slug?: string;
}

const { title, industry, year, technology, roles = [], aiFeature = false, thumbnail, href, status, slug } = Astro.props;

// A link when there's somewhere to go, otherwise a plain container — no
// dead affordance for a case study that isn't published yet.
const Wrapper = href ? 'a' : 'div';

const isExternal = status === 'external';
---

<Wrapper
	class:list={['card', 'glass', { 'card--external': isExternal }]}
	href={href}
	data-slug={slug}
	target={isExternal ? '_blank' : undefined}
	rel={isExternal ? 'noopener noreferrer' : undefined}
>
	{/* `sizes`: two columns capped at --measure-content, so above 85.5rem the
	    card stops growing and is a flat 600px; between there and the
	    single-column breakpoint it holds ~44vw. */}
	<div class="card__media">
		<Image
			src={thumbnail.src}
			alt={thumbnail.alt}
			widths={[400, 620, 900]}
			sizes="(min-width: 85.5rem) 37.5rem, (min-width: 40rem) 44vw, 92vw"
		/>
		{
			status === 'coming-soon' && (
				<div class="card__overlay">
					<p class="card__overlay-label">Coming soon</p>
				</div>
			)
		}
		{
			isExternal && (
				<span class="card__external-badge">
					<Icon name="external-link" />
				</span>
			)
		}
		{
			(aiFeature || roles.length > 0) && (
				<ul class="card__roles">
					{aiFeature && (
						<li>
							<Tag icon="sparkles">AI</Tag>
						</li>
					)}
					{roles.map((role) => (
						<li>
							<Tag icon={ROLE_ICONS[role.kind]}>{role.label}</Tag>
						</li>
					))}
				</ul>
			)
		}
	</div>
	<div class="card__body">
		<p class="card__title type-card-title">
			{title}
			{isExternal && <span class="sr-only"> (opens in new tab)</span>}
		</p>
		<p class="card__meta type-meta">
			<span class="card__meta-item">
				<Icon name="building-2" />
				{industry}
			</span>
			<span aria-hidden="true">·</span>
			<span class="card__meta-item">
				<Icon name="wrench" />
				{technology}
			</span>
			<span aria-hidden="true">·</span>
			<span class="card__meta-item">
				<Icon name="calendar" />
				{year}
			</span>
		</p>
	</div>
</Wrapper>

<style>
	/* The card is one object: a single glass pane with the cover painted over
	   its top half, not an image with a caption beneath it. `.glass` brings the
	   border and radius; `overflow: clip` is what rounds the cover's top
	   corners against them. */
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: clip;
		color: inherit;
		text-decoration: none;
	}

	a.card {
		transition: transform 0.15s ease;
	}

	a.card:hover {
		transform: translateY(-2px);
	}

	/* `alias` rather than the browser's default pointer — the nearest native
	   cursor semantic to "this is a shortcut to somewhere else," which is what
	   distinguishes this card from every other one on the grid: it doesn't
	   navigate within the site, it leaves it. */
	a.card--external {
		cursor: alias;
	}

	a.card:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		/* Matches .glass's own radius so the ring hugs the corner. */
		border-radius: var(--radius-md);
	}

	/* Deliberately does NOT clip: the role-tag row hangs half of itself past
	   this box's bottom edge, and an `overflow: hidden` here would slice it in
	   two. The cover is cropped by object-fit on the image instead, which
	   needs no clipping ancestor, and the card's own `overflow: clip` still
	   rounds the corners. */
	.card__media {
		position: relative;
		aspect-ratio: 16 / 10;
		background: var(--bg-media);
	}

	.card__media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Unpublished work's whole cover, not a corner of it, so it fills the
	   media rather than straddling its seam. Confined to `.card__media` on
	   purpose: the seam and the body stay legible, only the cover itself
	   reads as not-yet-real. Painted before `.card__roles` in DOM order, so
	   any role tags on a `coming-soon` card sit on top of the scrim rather
	   than under it. */
	.card__overlay {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background: var(--overlay);
	}

	/* --secondary rather than a second raw white: the overlay is theme-invariant
	   like the scrim it sits on, so its label can't reach for --text either. */
	.card__overlay-label {
		font-family: var(--font-display);
		font-weight: var(--weight-medium);
		font-size: var(--size-ui);
		line-height: 1.25;
		color: var(--secondary);
		margin: 0;
	}

	/* Sits in the cover's corner rather than replacing it like the coming-soon
	   scrim does — the work is real and viewable, so nothing should hide the
	   thumbnail. Same theme-invariant scrim colour as .card__overlay, since it
	   rides on the cover image rather than the page ground. */
	.card__external-badge {
		position: absolute;
		inset-block-start: var(--spacing-xl);
		inset-inline-end: var(--spacing-xl);
		display: grid;
		place-items: center;
		width: var(--spacing-6xl);
		height: var(--spacing-6xl);
		border-radius: var(--radius-full);
		background: var(--overlay);
	}

	/* Matches .icon-btn--lg's box-to-icon ratio (48px box / 26px icon) rather
	   than a bare fraction of the box, so it reads at the same visual weight
	   as every other circular icon surface in the system. */
	.card__external-badge .icon {
		color: var(--secondary);
		width: 1.625rem;
		height: 1.625rem;
	}

	/* Straddles the seam between the cover and the body, centred on it by its
	   own half-height rather than by a measured offset, so it stays put
	   whatever the roles are. Left edge shares the body's padding, which is
	   what lines it up with the title below. */
	.card__roles {
		position: absolute;
		inset-block-end: 0;
		inset-inline-start: var(--spacing-3xl);
		transform: translateY(50%);
		display: flex;
		gap: var(--spacing-xl);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card__body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		padding: var(--spacing-3xl);
	}

	.card__title {
		color: var(--text);
	}

	.card__meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		color: var(--text-muted);
	}

	/* Icon and label as one unit, so the pair wraps and truncates together
	   rather than the icon ever separating from the data point it precedes. */
	.card__meta-item {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
	}

	/* The global guard in components.css covers .btn, .tab and .icon-btn; the
	   card's lift is scoped here, so its opt-out has to be too. */
	@media (prefers-reduced-motion: reduce) {
		a.card {
			transition: none;
		}

		a.card:hover {
			transform: none;
		}
	}
</style>
