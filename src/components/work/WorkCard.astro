---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';
import Badge from '../ui/Badge.astro';
import { ROLE_ICONS, type WorkRole } from './roles';

export type { WorkRole };

interface Props {
	title: string;
	industry: string;
	year: number;
	/** What kind of work this was — icon chips at the top of the text panel. */
	roles?: readonly WorkRole[];
	/** Whether this project shipped a notable AI feature — rendered as the
	 *  first (leftmost) chip in the same row as `roles`, when true. */
	aiFeature?: boolean;
	thumbnail: { src: ImageMetadata; alt: string };
	href?: string;
	status?: 'coming-soon' | 'external';
	/** True for the cards that sit in the initial viewport. Astro's image
	 *  service defaults every `<Image>` to `loading="lazy"`, which puts the
	 *  first covers behind an intersection check instead of starting
	 *  them during HTML parse — on the homepage those covers *are* the LCP
	 *  candidate, so the default costs exactly the image it should hurry. */
	priority?: boolean;
}

const { title, industry, year, roles = [], aiFeature = false, thumbnail, href, status, priority = false } = Astro.props;

// A link when there's somewhere to go, otherwise a plain container — no
// dead affordance for a case study that isn't published yet.
const Wrapper = href ? 'a' : 'div';

const isExternal = status === 'external';

// Only an internal case-study link gets a shared view-transition name — its
// pairing lives in CaseStudyHero.astro's `.hero`, matched by the same slug,
// and the opt-in that makes it do anything is in tokens.css.
const workSlug = href?.startsWith('/work/') ? href.slice('/work/'.length) : undefined;
---

{/* data-astro-reload skips <ClientRouter/>'s fetch-probe (it would
    otherwise fetch the destination first, find no router there, and only
    then fall back to a real navigation) — a case study is always a hard
    nav today regardless (CaseStudyLayout.astro), so this just lets it
    happen immediately, in time for the view-transition-name below to be
    caught by the browser's own cross-document transition (tokens.css). */}
<Wrapper
	class:list={['card', { 'card--external': isExternal }]}
	href={href}
	target={isExternal ? '_blank' : undefined}
	rel={isExternal ? 'noopener noreferrer' : undefined}
	style={workSlug ? `view-transition-name: card-${workSlug};` : undefined}
	{...(workSlug ? { 'data-astro-reload': '' } : {})}
>
	<div class="card__inner">
		{/* Text first in the DOM, whatever the layout puts first on screen: the
		    link's accessible name is read in this order, and the title should
		    come before the cover's alt text in it. */}
		<div class="card__body">
			{
				(aiFeature || roles.length > 0) && (
					<ul class="card__roles">
						{aiFeature && (
							<li>
								<Badge variant="ai">
									<Icon name="sparkles" />
									AI
								</Badge>
							</li>
						)}
						{roles.map((role) => (
							<li>
								<Badge variant="light">
									<Icon name={ROLE_ICONS[role.kind]} />
									{role.label}
								</Badge>
							</li>
						))}
					</ul>
				)
			}
			<p class="card__title type-card-title">
				{title}
				{isExternal && <span class="sr-only"> (opens in new tab)</span>}
			</p>
			<p class="card__meta type-label">
				<span class="card__meta-item">
					<Icon name="building-2" />
					{industry}
				</span>
				<span class="card__meta-item">
					<Icon name="calendar" />
					{year}
				</span>
			</p>
		</div>
		{/* `sizes` follows the host, which sets the card's width: the
		    homepage's column (index.astro's `.home__works`), the frame
		    between the gutters, ~92vw, capped at --measure-home (37.5rem —
		    `sizes` cannot read a custom property, so move this with it). The
		    cover runs the card's full width. */}
		<div class="card__media">
			<Image
				src={thumbnail.src}
				alt={thumbnail.alt}
				widths={[480, 720, 1080, 1440, 2000]}
				sizes="(min-width: 44rem) 37.5rem, 92vw"
				loading={priority ? 'eager' : 'lazy'}
				fetchpriority={priority ? 'high' : 'auto'}
			/>
			{
				status === 'coming-soon' && (
					<div class="card__overlay">
						<p class="card__overlay-label">Coming soon</p>
					</div>
				)
			}
			{
				isExternal && (
					<span class="card__external-badge">
						<Icon name="external-link" />
					</span>
				)
			}
		</div>
	</div>
</Wrapper>

<style>
	/* No panel: a rounded cover with the role chips on its top edge, and the
	   card's text straight on the page ground beneath it. The card has no
	   width of its own — whatever hosts it decides that (the homepage's
	   Selected works column) — and takes its height from its content. */
	.card {
		position: relative;
		display: block;
		container-type: inline-size;
		color: inherit;
		text-decoration: none;
	}

	/* A lift on hover, and a press that gives a little under the pointer or
	   finger — the one response every input gets, since touch has no hover.
	   The two use different properties (`transform`, `scale`) so a press on a
	   lifted card composes rather than replacing the lift. 0.98 is the
	   subtlest press the guidance allows; on a card this large, a deeper one
	   reads as the page shrinking.

	   The lift is gated to a precise pointer that can hover: on touch, a tap
	   fakes a hover and leaves it stuck until the next tap elsewhere.

	   No tap highlight: the press is the feedback, and the browser's grey
	   flash would fight it. */
	a.card {
		-webkit-tap-highlight-color: transparent;
		transition:
			transform 160ms var(--ease-out),
			scale 160ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		a.card:hover {
			transform: translateY(-2px);
		}
	}

	a.card:active {
		scale: 0.98;
	}

	/* `alias` rather than the browser's default pointer — the nearest native
	   cursor semantic to "this is a shortcut to somewhere else," which is what
	   distinguishes this card from every other one in the list: it doesn't
	   navigate within the site, it leaves it. */
	a.card--external {
		cursor: alias;
	}

	a.card:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}

	/* The cover, then the title and facts 8px apart under it. The cover is
	   second in the DOM and first on screen — see the markup. */
	.card__inner {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	/* Title, then the facts, flush with the cover's edge. The role chips are
	   first in the DOM (so the link's name reads them with the title) but
	   leave the flow: they sit on the cover's top edge, below. */
	.card__body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	/* Centred on the cover's top edge, 16px in from its left: half the chip
	   rides on the cover, half above it. Out of flow, so it positions against
	   `.card`, whose top is the cover's top. */
	.card__roles {
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: var(--spacing-xl);
		z-index: 1;
		translate: 0 -50%;
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xs);
		max-inline-size: calc(100% - 2 * var(--spacing-xl));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card__title {
		color: var(--text);
	}

	/* Industry and year side by side, 40px apart. */
	.card__meta {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--spacing-5xl);
		margin: 0;
		color: var(--text-body);
	}

	/* Icon and label as one unit, so the pair wraps together rather than the
	   icon ever separating from the data point it precedes. */
	.card__meta-item {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
	}

	.card__meta-item :global(.icon) {
		inline-size: var(--spacing-xl);
		block-size: var(--spacing-xl);
	}

	/* The design's frame for the cover (500×316). Rounded and clipped
	   here, so the image, the coming-soon scrim and the external badge all
	   sit inside the same corners. --bg-media marks the box while the image
	   loads. */
	.card__media {
		position: relative;
		order: -1;
		aspect-ratio: 500 / 316;
		overflow: clip;
		border-radius: var(--radius-md);
		background: var(--bg-media);
	}

	/* Anchored to the top, so a cover that isn't this ratio loses its
	   bottom rather than its top — where the screenshots keep their
	   headers. */
	.card__media :global(img) {
		position: absolute;
		inset: 0;
		display: block;
		inline-size: 100%;
		block-size: 100%;
		max-inline-size: none;
		object-fit: cover;
		object-position: center top;
	}

	/* Unpublished work's whole cover, not a corner of it. Confined to
	   `.card__media` on purpose: the title and meta stay legible, only the
	   cover itself reads as not-yet-real. */
	.card__overlay {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background: var(--overlay);
	}

	/* --secondary rather than a second raw white: the overlay is theme-invariant
	   like the scrim it sits on, so its label can't reach for --text either. */
	.card__overlay-label {
		font-family: var(--font-display);
		font-weight: var(--weight-regular);
		font-size: var(--size-ui);
		line-height: 1.25;
		color: var(--secondary);
		margin: 0;
	}

	/* Sits in the cover's corner rather than replacing it like the coming-soon
	   scrim does — the work is real and viewable, so nothing should hide the
	   thumbnail. Same theme-invariant scrim colour as .card__overlay, since it
	   rides on the cover image rather than the page ground. */
	.card__external-badge {
		position: absolute;
		inset-block-start: var(--spacing-xl);
		inset-inline-end: var(--spacing-xl);
		display: grid;
		place-items: center;
		width: var(--spacing-6xl);
		height: var(--spacing-6xl);
		border-radius: var(--radius-full);
		background: var(--overlay);
	}

	/* Matches the icon-lg button's box-to-icon ratio (48px box / 26px icon) rather
	   than a bare fraction of the box, so it reads at the same visual weight
	   as every other circular icon surface in the system. */
	.card__external-badge .icon {
		color: var(--secondary);
		width: 1.625rem;
		height: 1.625rem;
	}

	/* ui/button.tsx carries its own reduced-motion guard; the card's lift and
	   press are scoped here, so their opt-out has to be too.
	   The dimming stays, and keeps its fade — it is emphasis, not movement,
	   and reduced motion means gentler, not none. */
	@media (prefers-reduced-motion: reduce) {
		.card,
		a.card {
			transition:
				opacity 200ms ease,
				filter 200ms ease;
		}

		a.card:hover {
			transform: none;
		}

		a.card:active {
			scale: none;
		}
	}
</style>
