---
import '../styles/tokens.css';
import '../styles/components.css';
import CaseStudyHero from '../components/case-study/CaseStudyHero.astro';
import { ChapterRail } from '../components/case-study/ChapterRail';
import { Lightbox } from '../components/case-study/Lightbox';
import { Glossary } from '../components/case-study/Glossary';
import { VideoPlayer } from '../components/case-study/VideoPlayer';
import ThemePreview from '../components/ThemePreview.astro';
import DevOutline from '../components/DevOutline.astro';
import Footer from '../components/footer/Footer.astro';
import ViewportGate from '../components/ViewportGate.astro';
import Analytics from '../components/analytics/Analytics.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	subtitle: string;
	facts?: { label: string; value: string }[];
	chapters?: { id: string; label: string }[];
	hero?: {
		before: ImageMetadata;
		after: ImageMetadata;
		beforeAlt: string;
		afterAlt: string;
		beforeLabel?: string;
		afterLabel?: string;
		beforeNotes?: { x: number; y: number; text: string }[];
		afterNotes?: { x: number; y: number; text: string }[];
	};
	actions?: {
		primary?: { label: string; href: string };
		secondary?: { label: string; href: string };
	};
}

const { title, subtitle, facts = [], chapters = [], hero, actions = {} } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<Analytics />
		{import.meta.env.DEV && <ThemePreview />}
		{import.meta.env.DEV && <DevOutline />}
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<title>{title} — Tousif's portfolio</title>
		<meta name="description" content={subtitle} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={subtitle} />
		<meta property="og:type" content="article" />
	</head>
	<body>
		<CaseStudyHero title={title} subtitle={subtitle} facts={facts} actions={actions} hero={hero} />

		{chapters.length > 0 && <ChapterRail chapters={chapters} client:load />}

		{/* `data-case-study` is read by trackCaseStudyViewed(): a bundled Astro
		    `<script>` is static and cannot see frontmatter, so the title has to
		    reach the client through the DOM. */}
		<main id="story" data-case-study={title}>
			<slot />
		</main>

		<Footer measure="page" />
		<ViewportGate />

		{/* One overlay each per page, idle-loaded — nothing here is needed for
		    the first paint, and two of the three may never be opened at all. */}
		<Lightbox client:idle />
		<Glossary client:idle />
		<VideoPlayer client:idle />
	</body>
</html>

{/* Every /work/<slug> page renders through this layout, and none of them carry
    `<ClientRouter />` — so this is a hard navigation and the script runs once
    per case study opened, which is exactly the moment the event names. */}
<script>
	import { trackCaseStudyViewed } from '../components/analytics/analytics';

	trackCaseStudyViewed();
</script>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		/* The chapter rail is sticky, so anchored sections must stop below it
		   rather than under it. */
		scroll-padding-block-start: 5rem;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text-body);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	img {
		max-width: 100%;
	}
</style>
