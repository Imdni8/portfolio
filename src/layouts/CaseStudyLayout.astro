---
import '../styles/tokens.css';
import '../styles/tailwind.css';
import '../styles/components.css';
import CaseStudyHero from '../components/case-study/CaseStudyHero.astro';
import { Lightbox } from '../components/case-study/Lightbox';
import { Glossary } from '../components/case-study/Glossary';
import { VideoPlayer } from '../components/case-study/VideoPlayer';
import { Toast } from '../components/case-study/Toast';
import ThemePreview from '../components/ThemePreview.astro';
import DevOutline from '../components/DevOutline.astro';
import Footer from '../components/footer/Footer.astro';
import Analytics from '../components/analytics/Analytics.astro';
import FontPreload from '../components/FontPreload.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	subtitle: string;
	thumbnail: { src: ImageMetadata; alt: string };
	facts?: { label: string; value: string }[];
	heroShot?: { src: ImageMetadata; alt: string };
	hero?: {
		before: ImageMetadata;
		after: ImageMetadata;
		beforeAlt: string;
		afterAlt: string;
		beforeLabel?: string;
		afterLabel?: string;
		beforeNotes?: { x: number; y: number; text: string }[];
		afterNotes?: { x: number; y: number; text: string }[];
	};
	actions?: {
		primary?: { label: string; href: string };
		secondary?: { label: string; href: string };
	};
	/** Whether this study's body renders a `<Term>` / a video at all — see the
	 *  overlay islands at the bottom of `<body>`, and the comment in
	 *  `pages/work/[...slug].astro` that works these out. */
	usesGlossary?: boolean;
	usesVideo?: boolean;
}

const {
	title,
	subtitle,
	thumbnail,
	facts = [],
	hero,
	heroShot,
	actions = {},
	usesGlossary = true,
	usesVideo = true,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<FontPreload />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<title>{title} — Tousif's portfolio</title>
		<meta name="description" content={subtitle} />

		{/* Open Graph. `thumbnail` is `{ src, alt }` where `src` is an
		    ImageMetadata *object*, so the card image is `thumbnail.src.src` —
		    one `.src` too few stringifies the object and every shared case-study
		    link resolves to `/[object Object]`, which is exactly what shipped
		    while this prop was typed `any`. */}
		<meta property="og:site_name" content="Tousif Rahaman" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={subtitle} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:image" content={new URL(thumbnail.src.src, Astro.site)} />
		<meta property="og:image:width" content={String(thumbnail.src.width)} />
		<meta property="og:image:height" content={String(thumbnail.src.height)} />
		<meta property="og:image:alt" content={thumbnail.alt} />

		{/* Twitter */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={subtitle} />
		<meta name="twitter:image" content={new URL(thumbnail.src.src, Astro.site)} />
		<meta name="twitter:image:alt" content={thumbnail.alt} />

		{/* Last in `<head>`, after everything that decides how the page looks —
		    the analytics module is not needed for first paint, and putting its
		    fetch ahead of the title, the preloads and the social meta only gives
		    it a head start over the things that are. */}
		<Analytics />
		{import.meta.env.DEV && <ThemePreview />}
		{import.meta.env.DEV && <DevOutline />}
	</head>
	<body>
		<CaseStudyHero title={title} subtitle={subtitle} facts={facts} actions={actions} hero={hero} heroShot={heroShot} />

		{/* `data-case-study` is read by trackCaseStudyViewed(): a bundled Astro
		    `<script>` is static and cannot see frontmatter, so the title has to
		    reach the client through the DOM. */}
		<main id="story" data-case-study={title}>
			<slot />
		</main>

		<Footer measure="page" />

		{/* One overlay each per page, idle-loaded — nothing here is needed for
		    the first paint, and none of them may ever be opened at all.

		    Glossary and VideoPlayer are additionally gated on the study having
		    something that can open them: most of these pages render no `<Term>`
		    and no video, and an island with no reachable trigger is JS parsed
		    and hydrated for nothing. The two flags default to `true`, so a
		    caller that forgets them gets the old always-on behaviour rather than
		    a page whose overlays silently stop working. */}
		<Lightbox client:idle />
		{usesGlossary && <Glossary client:idle />}
		{usesVideo && <VideoPlayer client:idle />}
		<Toast client:idle />
	</body>
</html>

{/* Every /work/<slug> page renders through this layout, and none of them carry
    `<ClientRouter />` — so this is a hard navigation and the script runs once
    per case study opened, which is exactly the moment the event names. */}
<script>
	import { trackCaseStudyOpened } from '../components/analytics/analytics';

	trackCaseStudyOpened();
</script>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text-body);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	img {
		max-width: 100%;
	}
</style>
