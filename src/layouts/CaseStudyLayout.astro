---
import '../styles/tokens.css';
import '../styles/components.css';
import CaseStudyHero from '../components/case-study/CaseStudyHero.astro';
import { ChapterRail } from '../components/case-study/ChapterRail';
import { Lightbox } from '../components/case-study/Lightbox';
import { Glossary } from '../components/case-study/Glossary';
import { VideoPlayer } from '../components/case-study/VideoPlayer';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	dek: string;
	facts?: { label: string; value: string }[];
	chapters?: { id: string; label: string }[];
	hero?: { before: ImageMetadata; after: ImageMetadata; beforeAlt: string; afterAlt: string };
	actions?: {
		primary?: { label: string; href: string };
		secondary?: { label: string; href: string };
	};
}

const { title, dek, facts = [], chapters = [], hero, actions = {} } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<title>{title} — Tousif Rahaman</title>
		<meta name="description" content={dek} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={dek} />
		<meta property="og:type" content="article" />
	</head>
	<body>
		<CaseStudyHero title={title} dek={dek} facts={facts} actions={actions} hero={hero} />

		{chapters.length > 0 && <ChapterRail chapters={chapters} client:load />}

		<main id="story">
			<slot />
		</main>

		{/* One overlay each per page, idle-loaded — nothing here is needed for
		    the first paint, and two of the three may never be opened at all. */}
		<Lightbox client:idle />
		<Glossary client:idle />
		<VideoPlayer client:idle />
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		/* The chapter rail is sticky, so anchored sections must stop below it
		   rather than under it. */
		scroll-padding-block-start: 5rem;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text-body);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	img {
		max-width: 100%;
	}
</style>
