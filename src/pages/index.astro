---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/tailwind.css';
import '../styles/components.css';
import ThemePreview from '../components/ThemePreview.astro';
import DevOutline from '../components/DevOutline.astro';
import WaterField from '../components/ui/WaterField.astro';
import GlassDefs from '../components/ui/GlassDefs.astro';
import SiteNav from '../components/nav/SiteNav.astro';
import WorkCard from '../components/work/WorkCard.astro';
import ShinyText from '../components/ui/ShinyText';
import Footer from '../components/footer/Footer.astro';
import Analytics from '../components/analytics/Analytics.astro';
import heroWordmark from '../assets/homepage/Hero_wordmark.svg?raw';
import philipsLogo from '../assets/homepage/philips_logo.svg?raw';
import jjLogo from '../assets/homepage/J&J_logo.svg?raw';
import medableLogo from '../assets/homepage/medable_logo.svg?raw';

const clients = [
	{ name: 'Philips', svg: philipsLogo },
	{ name: 'Johnson & Johnson', svg: jjLogo },
	{ name: 'Medable', svg: medableLogo },
];

// The grid is the collection, not a hand-maintained list — a new case study
// (including a `coming-soon` stub) shows up here purely by existing, ordered
// by its own `order` field. See "Case studies" in CLAUDE.md.
//
// `coming-soon` entries sort after everything else, regardless of their own
// `order` — there's nothing to look at yet, so they shouldn't crowd real work
// out of the grid's early slots. `order` still decides their place within
// that trailing group, and everyone else's place among themselves.
const studies = (await getCollection('work', ({ data }) => data.status !== 'unlisted')).sort((a, b) => {
	const aComingSoon = a.data.status === 'coming-soon';
	const bComingSoon = b.data.status === 'coming-soon';
	if (aComingSoon !== bComingSoon) return aComingSoon ? 1 : -1;
	return a.data.order - b.data.order;
});
---

<!doctype html>
{/* Off: Work<->About is the only soft navigation on the site, and the only
    thing that should animate across it is the nav's active-tab indicator
    (SiteNav.astro, transition:persist). Everything else should cut instantly,
    same as a hard navigation, rather than picking up the router's default
    crossfade. */}
<html lang="en" data-theme="dark" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<ClientRouter />
		<Analytics />
		{import.meta.env.DEV && <ThemePreview />}
		{import.meta.env.DEV && <DevOutline />}
		<title>Tousif's portfolio</title>
		<meta name="description" content="Tousif Rahaman — product designer and design engineer." />
	</head>
	<body>
		{/* Both the nav and the work cards wear `.glass`; the filter it bends
		    the field with is defined once, here. */}
		<GlassDefs />
		<div class="site-field">
			<WaterField grid={72} />
		</div>
		<SiteNav />
		<div class="hero">
			<div class="hero-pin">
				<main class="hero-intro">
					<h1
						class="hero-intro__wordmark"
						aria-label="Tousif — Product Designer, Design Engineer"
						set:html={heroWordmark}
					/>
					<div class="hero-intro__clients">
						<p class="hero-intro__clients-label">Previously<br />worked at</p>
						<div class="hero-intro__logos">
							{
								clients.map((client) => (
									<span class="hero-intro__logo" role="img" aria-label={client.name} set:html={client.svg} />
								))
							}
						</div>
					</div>
				</main>
			</div>
		</div>
		{/* data-nav-scrim: the section the nav watches to know when to fade its
		    background in — this is the one that scrolls up underneath it (the
		    hero never does; it fades out while pinned). See SiteNav.astro. */}
		<section class="work" data-nav-scrim>
			<p class="work__eyebrow">
						<ShinyText
							text="Selected works"
							className="type-overline"
							client:load
							color="var(--primary-text)"
							shineColor="var(--amber-100)"
						/>
					</p>
			<div class="work__inner">
				{
					studies.map((entry) => (
						<WorkCard
							title={entry.data.title}
							industry={entry.data.industry}
							technology={entry.data.technology}
							year={entry.data.year}
							roles={entry.data.roles}
							aiFeature={entry.data.aiFeature}
							thumbnail={entry.data.thumbnail}
							slug={entry.id}
							href={
								entry.data.status === 'coming-soon'
									? undefined
									: entry.data.status === 'external'
										? entry.data.externalUrl
										: `/work/${entry.id}`
							}
							status={entry.data.status === 'coming-soon' || entry.data.status === 'external' ? entry.data.status : undefined}
						/>
					))
				}
			</div>
		</section>
		<Footer />
	</body>
</html>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	let passes: Array<() => void> = [];
	let ticking = false;

	const update = () => {
		ticking = false;
		for (const pass of passes) pass();
	};

	const onScroll = () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(update);
	};

	window.addEventListener('scroll', onScroll, { passive: true });
	window.addEventListener('resize', onScroll, { passive: true });

	document.addEventListener('astro:page-load', () => {
		passes = [];
		const hero = document.querySelector<HTMLElement>('.hero');
		const heroPin = document.querySelector<HTMLElement>('.hero-pin');
		const intro = document.querySelector<HTMLElement>('.hero-intro');
		const eyebrow = document.querySelector<HTMLElement>('.work__eyebrow');
		const cards = document.querySelector<HTMLElement>('.work__inner');

		if (hero && heroPin && intro && !reduceMotion.matches) {
			intro.classList.add('js-fade');

			passes.push(() => {
				const heroBox = hero.getBoundingClientRect();
				const pinBox = heroPin.getBoundingClientRect();
				const runway = heroBox.height - pinBox.height;
				const travel = pinBox.top - heroBox.top;
				const progress = runway > 0 ? Math.min(Math.max(travel / runway, 0), 1) : 0;
				intro.style.setProperty('--fade', String(progress));
			});
		}

		if (eyebrow && cards && !reduceMotion.matches) {
			eyebrow.classList.add('js-fade');

			passes.push(() => {
				const eyebrowBox = eyebrow.getBoundingClientRect();
				const gap = cards.getBoundingClientRect().top - eyebrowBox.bottom;
				const restGap = parseFloat(getComputedStyle(eyebrow).marginBlockEnd) || 0;
				const runway = restGap + eyebrowBox.height;
				const closed = runway > 0 ? Math.min(Math.max((restGap - gap) / runway, 0), 1) : 0;
				eyebrow.style.setProperty('--fade', String(closed));
			});
		}
		update();
	});
</script>

<style>
	body {
		margin: 0;
		background: var(--bg);
		color: var(--text-body);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;

		/* The four numbers that place the intro against the cards. They live
		   here rather than on `.hero` because `.hero`, `.hero-pin`,
		   `.hero-intro` and `.work` are siblings or cousins that all have to
		   agree on them, and custom properties only travel downwards. */

		/* The pinned intro's height. 66.4% comes from the spec: (24px nav
		   inset + 56px nav height + 600px clearance) / a 1024px-tall reference
		   frame. `svh` rather than `dvh` so it doesn't resize as a mobile
		   browser's toolbar shows and hides. */
		--pin-height: 66.4svh;

		/* What the nav occupies at the top of the viewport, plus a little
		   clearance: the band it paints is 60px (12px of padding, a 36px row,
		   12px more), and this leaves 18px under it. Unchanged when the nav
		   halved its top inset to fill that band instead of floating in it —
		   the band's bottom edge landed exactly where the row's used to. */
		--nav-footprint: 4.875rem;

		/* `.work`'s clearance below the pin when the page is at rest.
		   Unchanged from when it was `.work`'s own `padding-block-start`.
		   Also the line the eyebrow is pinned to, since it is `.work`'s first
		   child — see `.work__eyebrow.js-fade`. */
		--rest-gap: calc(var(--spacing-10xl));

		/* Where the top of `.work` has got to by the time the intro has
		   finished fading — one cell of the water field's grid below the nav,
		   which is the 72px pitch passed to `<WaterField>` rounded to the
		   nearest rung of the space scale. */
		--fade-end: calc(var(--nav-footprint) + var(--spacing-8xl));

		/* How far `.work` climbs past the pin's bottom edge to get there, and
		   so also how far it has to be pulled back up over the hero to start
		   from the same place at rest. Everything else falls out of these. */
		--overlap: calc(var(--pin-height) - var(--fade-end));
	}

	/* Fixed behind everything, sized to the viewport rather than to any
	   scrolling ancestor, so the field holds still while the whole page
	   scrolls over it — `.hero-pin` and `.work` are both left without a
	   background so the field shows through behind the intro text and the
	   cards alike; only the card media boxes carry their own opaque surface.
	   Both stay at z-index:auto or above (never negative), which is what
	   keeps the field painting behind them instead of on top. `isolate`
	   keeps the canvas's stacking context local. */
	.site-field {
		position: fixed;
		inset: 0;
		isolation: isolate;
	}

	/* The scroll runway for the pinned intro below: the pin's own height plus
	   everything the intro has to outlast. Sticky releases when its own
	   containing block runs out, so this height — and nothing else, not
	   padding underneath, not a margin on the next section — is what buys the
	   intro time to hold still. Two rungs make up the surplus. `--rest-gap`
	   is the clearance `.work` already has at rest. `--overlap` is the
	   part that keeps going afterwards: without it the cards could never
	   rise past the pin's own bottom edge while the pin was still stuck,
	   because they sit in flow directly beneath the hero and so are measured
	   against the hero's bottom, which puts a floor on the fade far lower
	   down the viewport than it wants to end. `.work`'s negative
	   `margin-block-start` is the other half of that: it cancels `--overlap`
	   out of the resting layout, so this element can be twice the height it
	   looks without moving anything or lengthening the page. Plain,
	   unpositioned spacer otherwise: no background, no content of its own,
	   just height. */
	.hero {
		position: relative;
		height: calc(var(--pin-height) + var(--overlap) + var(--rest-gap));
	}

	/* The box that actually holds still. Sticky rather than fixed so it stays
	   in normal flow — no separate spacer to keep in sync with its size, and
	   it releases on its own once `.hero` (its containing block) runs out of
	   runway, instead of needing a scroll-position threshold in JS to know
	   when to stop being fixed. */
	.hero-pin {
		position: sticky;
		top: 0;
		min-height: var(--pin-height);
	}

	p {
		margin: 0;
	}

	/* Centred not in `.hero-pin`'s own box but in the gap between the nav and
	   the *cards* below, as they sit at rest. `inset-block-start` is the
	   nav's own footprint — insets are relative to
	   `.hero-pin`'s border box, which padding wouldn't shift, so the
	   clearance has to live in the inset itself rather than in `.hero-pin`'s
	   padding. `inset-block-end` reaches past `.hero-pin`'s bottom edge by
	   `--spacing-11xl` — the larger of the two rungs that make up the gap
	   below the pin (see `.hero`) — landing near where the cards start at
	   rest — harmless even while `.hero-pin` is stuck, since
	   `.work` paints above it (see `.work`'s own comment) and the overlapping
	   part of this box is empty space, not content. The box then fills that
	   whole span (both insets set, height left to resolve on its own) and
	   centres its content with flex — not
	   `height: fit-content` + `margin-block: auto`, which asks the engine to
	   shrink an absolutely-positioned box to its content *before* solving
	   the auto margins against two fixed insets. That ordering is
	   underspecified enough that it silently failed in Safari (the box
	   never got a height, so nothing in it painted); flex centring reaches
	   the same result without depending on that resolution order. Sits
	   directly on the water field — no panel of its own. */
	.hero-intro {
		position: absolute;
		inset-block: var(--nav-footprint) calc(-1 * var(--spacing-11xl));
		inset-inline: var(--gutter);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		/* Nothing inside is interactive (the wordmark and client logos are
		   both inert svg) — inert to the pointer always, not just once faded,
		   so this box never shadows a click meant for the work section it
		   overlaps at its lower inset. */
		pointer-events: none;
	}

	/* `--fade` is written every scroll frame by the page script below (0 at
	   the top of the page, 1 at the moment `.hero-pin` releases). No
	   transition: the value already comes in one step per frame, so animating
	   it too would add lag between the scrollbar and what's on screen.
	   Opacity only — no accompanying `translateY`. A lift would be movement,
	   and movement is the one thing the intro must not have here: the point
	   of pinning it is that it holds its position while the cards come up to
	   meet it, so nudging it a rem in the same direction as the scroll reads
	   as the section being tugged along rather than staying put. Without JS
	   (or under reduced motion) this class is never added and the intro stays
	   at its default full opacity — it still leaves the viewport, just by
	   scrolling past the edge as before. */
	.hero-intro.js-fade {
		opacity: calc(1 - var(--fade, 0));
	}

	/* Load-in only — distinct from `.hero-intro.js-fade`'s scroll-driven
	   opacity above, which takes over once this has finished. The wordmark
	   drops into its resting position; `.hero-intro__clients` just fades,
	   on a stagger timed off the wordmark's own delay below. */
	@keyframes hero-wordmark-in {
		from {
			opacity: 0;
			translate: 0 calc(-1 * var(--spacing-lg));
		}
		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	@keyframes hero-intro-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	.hero-intro__wordmark {
		margin: 0;
		width: min(20rem, 100%);
		height: auto;
		/* The 1.5s delay is the number to tune — how long the page holds
		   before the wordmark drops in. */
		animation: hero-wordmark-in 700ms ease-out 0.6s both;
	}

	.hero-intro__wordmark :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	.hero-intro__clients {
		/* The one gap called out explicitly: 32px between the wordmark and
		   this section, independent of the lede-to-wordmark spacing above. */
		margin-block-start: var(--spacing-4xl);
		display: flex;
		align-items: center;
		gap: var(--spacing-3xl);
		/* Follows the wordmark in on a short stagger: wordmark's own 1.5s
		   delay plus 250ms. */
		animation: hero-intro-in 700ms ease-out 1.4s both;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-intro__wordmark,
		.hero-intro__clients {
			animation: none;
		}
	}

	.hero-intro__clients-label {
		margin: 0;
		font-family: var(--font-sans);
		font-weight: var(--weight-regular);
		font-size: var(--size-micro);
		line-height: var(--lh-micro);
		color: var(--text-muted);
		text-align: start;
	}

	.hero-intro__logos {
		display: flex;
		align-items: center;
		gap: var(--spacing-4xl);
	}

	.hero-intro__logo {
		display: block;
		height: 1.25rem;
	}

	.hero-intro__logo :global(svg) {
		display: block;
		height: 100%;
		width: auto;
	}

	/* No background: `position: relative` (so the field shows through behind
	   the cards, same as behind the hero text — see `.site-field`'s comment)
	   plus an explicit `z-index` so the cards reliably paint over `.hero-pin`
	   while it's stuck and fading, rather than relying on DOM order against a
	   sibling that's sticky — sticky positioning always opens its own
	   stacking context, which stacking-by-DOM-order can't be assumed to
	   cross. That `z-index` is load-bearing now rather than precautionary:
	   the two sections genuinely overlap for the second half of the fade,
	   and this is what decides that the cards pass in front of the intro
	   rather than behind it. */
	.work {
		position: relative;
		z-index: 1;
		/* Pulled back up over the hero by exactly the surplus height `.hero`
		   carries for the overlap, so the eyebrow starts at rest where it
		   always did — `--rest-gap` below the pin — and the extra height buys
		   hold time instead of pushing the cards down the page. No
		   `padding-block-start` to go with it: the clearance above the
		   eyebrow is `.hero`'s height now, where it doubles as scroll runway
		   (see `.hero`). Same pixels either way; sticky cares which box owns
		   them. */
		margin-block-start: calc(-1 * var(--overlap));
		/* 64px, not the 128px this used to carry. What has to match across
		   pages is the trailing space above the footer, and the cards bring
		   24px of their own bottom padding to it — so this rung, not the one
		   about and a case study use directly (96px, --spacing-9xl there and
		   the reflection's own padding here). 88px total, 8px under them:
		   72px would be exact and is not a rung on the scale. */
		padding-block: 0 var(--spacing-7xl);
	}

	/* Shares `.work__inner`'s max-width/gutter so it lines up with the card
	   grid's left edge, then adds the 8px clearance above the cards. */
	.work__eyebrow {
		max-width: var(--measure-content);
		margin-inline: auto;
		margin-block-end: var(--spacing-xl);
		padding-inline: var(--gutter);
		text-align: center;
	}

	/* Held exactly where it already sits, so it never travels up the viewport
	   at all — the cards come to it, it does not go to them. `top` is the
	   eyebrow's own resting offset written out: `.work` starts at `.hero`'s
	   full height less the `--overlap` its negative margin cancels, which
	   leaves `--pin-height + --rest-gap`, and the eyebrow is `.work`'s first
	   child with nothing above it. Being its resting offset is the whole point
	   — sticky engages on the first pixel of scroll and the label is stationary
	   from the first frame to the last, rather than rising to some other line
	   and stopping there.
	   Added by the script rather than written here, because the fade below is
	   what keeps a pinned label from sitting over the grid for the rest of the
	   section — the pin can't outlive it. Without JS (or under reduced motion)
	   the eyebrow scrolls away with the cards exactly as before, the same
	   fallback `.hero-intro` takes. */
	.work__eyebrow.js-fade {
		position: sticky;
		top: calc(var(--pin-height) + var(--rest-gap));
		opacity: calc(1 - var(--fade, 0));
	}

	.work__inner {
		max-width: var(--measure-content);
		margin-inline: auto;
		padding-inline: var(--gutter);
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-6xl) var(--spacing-5xl);
	}

	@media (max-width: 40rem) {
		.work__inner {
			grid-template-columns: 1fr;
		}
	}
</style>
