---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/tailwind.css';
import '../styles/components.css';
import ThemePreview from '../components/ThemePreview.astro';
import DevOutline from '../components/DevOutline.astro';
import LiquidMetal from '../components/ui/LiquidMetal.astro';
import SiteNav from '../components/nav/SiteNav.astro';
import HomeHero from '../components/home/HomeHero.astro';
import WorkCard from '../components/work/WorkCard.astro';
import Footer from '../components/footer/Footer.astro';
import Analytics from '../components/analytics/Analytics.astro';
import FontPreload from '../components/FontPreload.astro';
import { reelLength } from '../components/home/home-reel';

// The reel is the collection, not a hand-maintained list — a new case study
// (including a `coming-soon` stub) shows up here purely by existing, ordered
// by its own `order` field. See "Case studies" in CLAUDE.md.
//
// `coming-soon` entries sort after everything else, regardless of their own
// `order` — so they shouldn't crowd real work out of the reel's early slots.
// `order` still decides their place within that trailing group, and everyone
// else's place among themselves.
const studies = (await getCollection('work', ({ data }) => data.status !== 'unlisted')).sort((a, b) => {
	const aComingSoon = a.data.status === 'coming-soon';
	const bComingSoon = b.data.status === 'coming-soon';
	if (aComingSoon !== bComingSoon) return aComingSoon ? 1 : -1;
	return a.data.order - b.data.order;
});
---

<!doctype html>
{/* Off: Work<->About is the only soft navigation on the site, and nothing
    should animate across it. Everything should cut instantly, same as a hard
    navigation, rather than picking up the router's default crossfade. */}
<html lang="en" data-theme="dark" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<FontPreload />
		<title>Tousif's portfolio</title>
		<meta name="description" content="Tousif Rahaman — turning messy workflows and data into usable interfaces." />

		{/* Open Graph. The title here is what a shared link is captioned with;
		    <title> above is the browser tab, and the two are allowed to differ —
		    a tab says which page, a card says who this is. Title is the name,
		    description is the role — kept separate rather than folded into one
		    line, so neither restates the other. */}
		<meta property="og:site_name" content="Tousif Rahaman" />
		<meta property="og:title" content="Tousif Rahaman" />
		<meta property="og:description" content="Product designer & Builder" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={new URL('/', Astro.site)} />
		<meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
		{/* Stated rather than left to be discovered: LinkedIn falls back to its
		    small square card when it has to fetch the file to learn the aspect
		    ratio. These describe public/og-image.png (2400x1260) and have to be
		    re-measured if that file is ever replaced. */}
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="2400" />
		<meta property="og:image:height" content="1260" />
		<meta property="og:image:alt" content="Tousif Rahaman — product designer and builder" />

		{/* Twitter */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Tousif Rahaman" />
		<meta name="twitter:description" content="Product designer & Builder" />
		<meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

		{/* Last in `<head>`, after everything that decides how the page looks.
		    Neither the router nor the analytics module is needed for first
		    paint, and putting their fetches ahead of the title, the preloads and
		    the social meta only gives them a head start over the things that
		    are. */}
		<ClientRouter />
		<Analytics />
		{import.meta.env.DEV && <ThemePreview />}
		{import.meta.env.DEV && <DevOutline />}
	</head>
	<body>
		<div class="home-ground">
			<LiquidMetal />
		</div>
		<SiteNav />
		<main class="home">
			{/* The reel: a tall section whose pinned, viewport-sized child holds
			    the headline and every card, positioned by home-reel.ts as the
			    section scrolls. Its height is the scroll the sequence takes —
			    stated from the same function the script reads, so the two cannot
			    disagree about where the sequence ends. See home-reel.ts, and
			    "Homepage" in CLAUDE.md. */}
			<section class="reel" data-reel style={`--reel-length: ${reelLength(studies.length)}`}>
				<div class="reel__pin">
					<div class="reel__hero">
						<HomeHero />
					</div>
					{/* data-nav-scrim: the reel layout's nav-scrim target — the lit
					    card's top edge. While the pin holds, that line never rises
					    past the nav, and once the reel ends and the pin scrolls away
					    with the last card on it, this is the line that meets the nav
					    first. Below the reel's breakpoint this line carries no
					    position of its own and sits inert at the bottom of the
					    stacked hero; the stacked layout's target is the headline
					    itself (`data-nav-scrim-narrow`, HomeHero.astro) — the nav
					    picks between the two by the same breakpoint. See
					    SiteNav.astro. */}
					<div class="reel__scrim-line" data-nav-scrim></div>
					<h2 id="work-heading" class="sr-only">Selected work</h2>
					<ol class="reel__track" aria-labelledby="work-heading">
						{/* `priority` on the first two only: on the first screen the
						    first card peeks in at the bottom centre and the second at
						    the bottom right, and the rest are off to the side. */}
						{
							studies.map((entry, i) => (
								<li class="reel__slot" style={`--i: ${i}`}>
									<WorkCard
										title={entry.data.title}
										industry={entry.data.industry}
										year={entry.data.year}
										roles={entry.data.roles}
										aiFeature={entry.data.aiFeature}
										thumbnail={entry.data.thumbnail}
										href={
											entry.data.status === 'coming-soon'
												? undefined
												: entry.data.status === 'external'
													? entry.data.externalUrl
													: `/work/${entry.id}`
										}
										status={
											entry.data.status === 'coming-soon' || entry.data.status === 'external'
												? entry.data.status
												: undefined
										}
										priority={i < 2}
									/>
								</li>
							))
						}
					</ol>
				</div>
			</section>
		</main>
		{/* A wrapper, not the footer itself, so the reel can lay it over its
		    own bottom edge (see `.home-footer`) without Footer.astro knowing.
		    Outside <main> either way, so the <footer> keeps its contentinfo
		    role. */}
		<div class="home-footer">
			<Footer />
		</div>
	</body>
</html>

<script>
	import { initHomeReel } from '../components/home/home-reel';

	/* Registered on `astro:page-load` rather than run inline: this is a
	   bundled module script, so its body executes once, while `<ClientRouter />`
	   swaps in a fresh page every time someone navigates back to `/`. The
	   previous page's reel is torn down first — this module outlives the page
	   it was loaded on, so after a soft nav to /about and back, a stale
	   listener would still be positioning the cards that were swapped out, and
	   the persisted nav would keep whatever the last frame wrote to it. */
	let stopHome: (() => void) | undefined;

	document.addEventListener('astro:page-load', () => {
		stopHome?.();
		stopHome = undefined;

		const reel = document.querySelector<HTMLElement>('[data-reel]');
		if (reel) stopHome = initHomeReel(reel);
	});
</script>

<style>
	/* `--nav-band` is the colour the nav's scrim fades in with — the page's
	   ground, which on this page is not --bg. `--home-ground-blend`, not the
	   flatter `--home-ground` the body itself paints below: the scrim sits
	   over content the liquid-metal layer has already darkened by its own
	   blend, and matching the unblended token left a visibly lighter band
	   where the two met. See SiteNav.astro. */
	body {
		--nav-band: var(--home-ground-blend);
		margin: 0;
		background: var(--home-ground);
		color: var(--text-body);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
	}

	/* Fixed behind everything and sized to the viewport, so the glow holds
	   still while the page scrolls over it. It paints the warm ground itself,
	   and isolates, so the liquid-metal layer inside has exactly that ground
	   to soft-light onto and nothing else — see .liquid-metal in
	   components.css for why the ground is what makes the glow amber. */
	.home-ground {
		position: fixed;
		inset: 0;
		isolation: isolate;
		background: var(--home-ground);
	}

	/* The positioning context for `.home-footer` when it is laid over the
	   reel — the page's own height, which the reel's section sets. */
	body {
		position: relative;
	}

	/* `position: relative` plus a `z-index` is load-bearing: `.home-ground` is
	   `position: fixed` at `z-index: auto`, so it paints after static in-flow
	   content regardless of DOM order, and without this the whole page would
	   lay out correctly and be invisible underneath it. `.site-footer`
	   carries the same fix for the same reason. */
	.home {
		position: relative;
		z-index: 1;
	}

	/* ---- Stacked ---------------------------------------------------------------
	   The layout everywhere the reel does not run: below 64rem, under reduced
	   motion, and without JS. The headline has most of the first screen to
	   itself — 78svh leaves the first card's top in view, as the reel's own
	   first frame does — and the cards follow as a plain column. */
	/* The headline's centre lands where the reel puts it: 47.5svh down, just
	   above the centre of the viewport-fixed glow (HomeHero's own 5svh of
	   bottom padding is the lift). The box stays 78svh tall so the first card
	   still starts in view; the top padding is what moves the headline down
	   within it — (22 + 78 − 5) / 2 = 47.5. */
	.reel__hero {
		box-sizing: border-box;
		display: grid;
		min-block-size: 78svh;
		padding-block-start: 22svh;
	}

	.reel__track {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-7xl);
		margin: 0;
		padding-block: 0 var(--spacing-9xl);
		padding-inline: var(--gutter);
		list-style: none;
	}

	.reel__slot {
		inline-size: min(100%, 76.875rem);
	}

	/* The cards settle in just behind the headline — 80ms after its second
	   line, so the first screen assembles in one order rather than all at
	   once. Movement only, no fade: the first card's cover is the page's
	   largest paint, and an element held at opacity 0 does not count as
	   painted until it shows, so a fade here would push the LCP back by the
	   length of the delay. `translate`, because the reel's script owns each
	   slot's `transform` and the track is the one element nothing else
	   moves. */
	@media (prefers-reduced-motion: no-preference) {
		.reel__track {
			animation: reel-settle 800ms var(--ease-out) 360ms backwards;
		}
	}

	@keyframes reel-settle {
		from {
			translate: 0 6svh;
		}

		to {
			translate: 0 0;
		}
	}

	/* ---- Reel ------------------------------------------------------------------
	   Everything below is what home-reel.ts drives, and only applies where it
	   runs. The query is REEL_QUERY's; move them together.

	   The section is one viewport tall plus the scroll the sequence takes, and
	   the pin sticks for all of it. `overflow: clip` crops the cards that sit
	   off to the side without making the pin a scroll container — which
	   matters, because a scroll container would let focus drag the cards
	   sideways (see the script's focus handling). */
	@media (min-width: 64rem) and (prefers-reduced-motion: no-preference) and (scripting: enabled) {
		/* Sideways trackpad swipes step through the reel (home-reel.ts), so
		   they must not also be read as the browser's back/forward swipe. */
		html {
			overscroll-behavior-x: none;
		}

		.reel {
			block-size: calc((1 + var(--reel-length)) * 100svh);
		}

		/* --reel-w is the lit card's width, declared here so the scrim line and
		   the slots below read the same value — see `.reel__slot`. */
		.reel__pin {
			--reel-w: min(71.2vw, 110svh, 76.875rem);
			position: sticky;
			inset-block-start: 0;
			block-size: 100svh;
			overflow: clip;
		}

		.reel__hero {
			position: absolute;
			inset: 0;
			min-block-size: 0;
			padding-block-start: 0;
		}

		/* Its own stacking context, so the cards' z-order stays among
		   themselves, and the headline's flying mark (z-index 1, HomeHero.astro)
		   sits above all of them should the two ever meet — which the reel's
		   timing and its clearance guard keep from happening. */
		.reel__track {
			position: absolute;
			inset: 0;
			z-index: 0;
			display: block;
			padding: 0;

			/* The coverflow's shared vanishing point. perspective only
			   affects the 3D transforms of an element's own children, so it
			   lives here rather than on .reel__pin — scoped to exactly what
			   it affects. Static: it never depends on scroll position or
			   card index, so home-reel.ts never touches it — keep the 2.2
			   multiplier in sync with that file's coverflow comment. The
			   origin sits at the lit card's own vertical centre (51.4%,
			   matching .reel__scrim-line/.reel__slot below), not the pin's
			   plain centre, so every card shares the one vanishing point the
			   lit card sits on. */
			perspective: calc(var(--reel-w) * 2.2);
			perspective-origin: 50% 51.4%;
		}

		/* The page ends on the last card, and where the screen has room under
		   it (home-reel.ts decides, and sets `data-footer-overlay`), the footer
		   is laid over the bottom of the reel rather than after it — so it
		   rises into view as the last card arrives and there is nothing left to
		   scroll. Pinned to the bottom of the body, whose height is the reel's.

		   It sits under the reel (`.home` is at z-index 1), so a card passing
		   through covers it rather than the footer's text crossing the card.
		   That puts the whole viewport-sized pin above the footer, so the reel
		   stops taking the pointer and only the cards and the headline take it
		   back; otherwise the footer's mascot would never see the pointer, and
		   its hover pose would never play. */
		:global(body[data-footer-overlay]) .home-footer {
			position: absolute;
			inset-inline: 0;
			inset-block-end: 0;
		}

		.home {
			pointer-events: none;
		}

		.reel__slot,
		.reel__hero :global(.hero__visual) {
			pointer-events: auto;
		}

		/* The lit card's resting top edge — the slot rule below, solved for
		   its top rather than its centre. */
		.reel__scrim-line {
			position: absolute;
			inset-inline: 0;
			inset-block-start: calc(51.4% - var(--reel-w) * 709 / 1230 / 2);
		}

		/* Every card starts centred on the lit card's spot: 71.2% of the
		   viewport wide (the reference's 1230 of 1728), capped by height on
		   short screens and at 1230px on wide ones, and centred 51.4% of the
		   way down (574.5 of 1117). `translate` does the centring; the script
		   owns `transform`, and the two compose.

		   The `transform` here is the reel's first frame, before the script has
		   run — the same values the script computes at the top of the page —
		   so the page paints in place and nothing jumps when it takes over:
		   each card one step further along than the last (0.6707 of a card
		   width across), tilted 35° around its own vertical axis and receded
		   0.32 card-widths in depth (both plateauing past the first step,
		   `min(var(--i), 1)`, same as the old diagonal's scale term), 94% the
		   size of the lit one at that plateau, sagging 0.15 card-widths per
		   squared step (unplateaued — it keeps growing with `var(--i)²`, so
		   the row curves continuously rather than kinking where the other
		   properties plateau), and all of them 58svh below where they will
		   come to rest. `k = 0` here, so `d = i` is always ≥ 0 — there is no
		   mirrored, left-hand case to render before the script runs, same as
		   before. */
		.reel__slot {
			--reel-step: calc(var(--i) * var(--reel-w) * 0.6707);
			position: absolute;
			inset-block-start: 51.4%;
			inset-inline-start: 50%;
			inline-size: var(--reel-w);
			translate: -50% -50%;
			transform: translate3d(
					var(--reel-step),
					calc(58svh + var(--reel-w) * var(--i) * var(--i) * 0.15),
					calc(var(--reel-w) * min(var(--i), 1) * -0.32)
				)
				rotateY(calc(min(var(--i), 1) * -35deg))
				scale(calc(1 - min(var(--i), 1) * 0.06));
			z-index: calc(100 - var(--i) * 10);
			will-change: transform;
		}
	}
</style>
