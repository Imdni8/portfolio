---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/tailwind.css';
import '../styles/components.css';
import ThemeInit from '../components/ThemeInit.astro';
import DevOutline from '../components/DevOutline.astro';
import SiteNav from '../components/nav/SiteNav.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeBio from '../components/home/HomeBio.astro';
import WorkCard from '../components/work/WorkCard.astro';
import ExternalWorkRow from '../components/work/ExternalWorkRow.astro';
import Footer from '../components/footer/Footer.astro';
import Analytics from '../components/analytics/Analytics.astro';
import FontPreload from '../components/FontPreload.astro';

// The work list is the collection, not a hand-maintained list — a new case study
// (including a `coming-soon` stub) shows up here purely by existing, ordered
// by its own `order` field. See "Case studies" in CLAUDE.md.
//
// `coming-soon` entries sort after everything else, regardless of their own
// `order` — so they shouldn't crowd real work out of the list's early slots.
// `order` still decides their place within that trailing group, and everyone
// else's place among themselves.
const entries = (await getCollection('work', ({ data }) => data.status !== 'unlisted')).sort((a, b) => {
	const aComingSoon = a.data.status === 'coming-soon';
	const bComingSoon = b.data.status === 'coming-soon';
	if (aComingSoon !== bComingSoon) return aComingSoon ? 1 : -1;
	return a.data.order - b.data.order;
});

// Case studies on this site are cards; work that lives off-site (`external`,
// a deck in Drive or Slides) is a compact row under them, so a click on a
// cover always means a page here. Both keep the collection's order.
const studies = entries.filter((entry) => entry.data.status !== 'external');
const earlier = entries.filter((entry) => entry.data.status === 'external');
---

<!doctype html>
{/* Off: Work<->About is the only soft navigation on the site, and nothing
    should animate across it. Everything should cut instantly, same as a hard
    navigation, rather than picking up the router's default crossfade. */}
<html lang="en" data-theme="dark" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<FontPreload />
		<title>Tousif's portfolio</title>
		<meta name="description" content="Tousif Rahaman — turning messy workflows and data into usable interfaces." />

		{/* Open Graph. The title here is what a shared link is captioned with;
		    <title> above is the browser tab, and the two are allowed to differ —
		    a tab says which page, a card says who this is. Title is the name,
		    description is the role — kept separate rather than folded into one
		    line, so neither restates the other. */}
		<meta property="og:site_name" content="Tousif Rahaman" />
		<meta property="og:title" content="Tousif Rahaman" />
		<meta property="og:description" content="Product designer & Builder" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={new URL('/', Astro.site)} />
		<meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
		{/* Stated rather than left to be discovered: LinkedIn falls back to its
		    small square card when it has to fetch the file to learn the aspect
		    ratio. These describe public/og-image.png (2400x1260) and have to be
		    re-measured if that file is ever replaced. */}
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="2400" />
		<meta property="og:image:height" content="1260" />
		<meta property="og:image:alt" content="Tousif Rahaman — product designer and builder" />

		{/* Twitter */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Tousif Rahaman" />
		<meta name="twitter:description" content="Product designer & Builder" />
		<meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

		{/* Last in `<head>`, after everything that decides how the page looks.
		    Neither the router nor the analytics module is needed for first
		    paint, and putting their fetches ahead of the title, the preloads and
		    the social meta only gives them a head start over the things that
		    are. */}
		<ClientRouter />
		<Analytics />
		<ThemeInit />
		{import.meta.env.DEV && <DevOutline />}
	</head>
	<body>
		<SiteNav />
		{/* One column: the name and tagline, the bio, then the work. The
		    column is the nav's row too (`--nav-measure`, below), so the brand
		    mark sits over the name as Figma draws it. See "Homepage" in
		    CLAUDE.md. */}
		<main class="home">
			<HomeHero />
			<HomeBio />
			<section class="home__works" aria-labelledby="work">
				<h2 id="work" class="home__works-heading type-label">Selected work</h2>
				<ol class="work-list">
					{
						studies.map((entry, i) => (
							<li>
								<WorkCard
									title={entry.data.title}
									company={entry.data.company}
									industry={entry.data.industry}
									year={entry.data.year}
									roles={entry.data.roles}
									aiFeature={entry.data.aiFeature}
									thumbnail={entry.data.thumbnail}
									href={entry.data.status === 'coming-soon' ? undefined : `/work/${entry.id}`}
									status={entry.data.status === 'coming-soon' ? 'coming-soon' : undefined}
									priority={i === 0}
								/>
							</li>
						))
					}
				</ol>
			</section>
			{
				earlier.length > 0 && (
					<section class="home__works" aria-labelledby="earlier-work">
						<h2 id="earlier-work" class="home__works-heading type-label">Earlier work</h2>
						<ul class="earlier-list">
							{earlier.map((entry) => (
								<li>
									<ExternalWorkRow
										title={entry.data.title}
										company={entry.data.company}
										industry={entry.data.industry}
										year={entry.data.year}
										href={entry.data.externalUrl!}
										thumbnail={entry.data.thumbnail}
									/>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<script>
	import { initHomeMotion } from '../components/home/home-motion';
	import { initCommitStrip } from '../components/home/commit-strip';
	import { initCodeMark } from '../components/home/code-mark';
	import { initLinkCursor } from '../components/home/link-cursor';

	/* Registered on `astro:page-load` rather than run inline: this is a
	   bundled module script, so its body executes once, while `<ClientRouter />`
	   swaps in a fresh page every time someone navigates back to `/`. The
	   previous page's listeners and in-flight fetch are torn down first. */
	let stop: (() => void)[] = [];

	document.addEventListener('astro:page-load', () => {
		for (const fn of stop) fn();
		stop = [];

		if (!document.querySelector('.home')) return;
		stop.push(initHomeMotion());
		const strip = document.querySelector<HTMLElement>('[data-commit-strip]');
		if (strip) stop.push(initCommitStrip(strip));
		const codeMark = document.querySelector<HTMLElement>('[data-code-mark]');
		if (codeMark) stop.push(initCodeMark(codeMark));
		const home = document.querySelector<HTMLElement>('.home');
		if (home) stop.push(initLinkCursor(home));
	});
</script>

<style>
	/* `--nav-band` is the ground the nav's pill is filled with — the page's
	   ground, which on this page is not --bg. `--nav-measure` narrows the
	   nav's row to this page's column. See SiteNav.astro. */
	body {
		--nav-band: var(--home-ground);
		--nav-measure: var(--measure-home);
		margin: 0;
		background: var(--home-ground);
		color: var(--text-body);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
	}

	/* The page frame: the gutter outside a --measure-home cap (see "The page
	   frame" in CLAUDE.md). The top padding clears the nav's 72px band and
	   leaves the 56px Figma draws between it and the name. */
	.home {
		box-sizing: border-box;
		display: grid;
		gap: var(--spacing-5xl);
		max-inline-size: calc(var(--measure-home) + 2 * var(--gutter));
		margin-inline: auto;
		padding-block: calc(var(--nav-height) + var(--spacing-7xl)) var(--spacing-9xl);
		padding-inline: var(--gutter);
	}

	/* The bio and the work each sit a step further down than the row gap
	   alone: 72px in all, the 40px gap plus --spacing-4xl. The hero carries
	   the extra below itself (its root is HomeHero's .intro); the work
	   carries it above. */
	.home > :global(.intro) {
		margin-block-end: var(--spacing-4xl);
	}

	/* The work: see the step above. */
	.home__works {
		display: grid;
		gap: var(--spacing-6xl);
		margin-block-start: var(--spacing-4xl);
	}

	/* A divider: the label centred on a hairline that runs to the column's
	   edges, 48px above the first card. The rules are pseudo-elements, so
	   the heading's text — and its accessible name — is the label alone. */
	/* The nav's Work link (`/#work`) lands here, so the offset sits on the
	   heading — the element carrying the id — not on the section around it,
	   where it was ignored. The nav's 72px plus --spacing-3xl leaves the
	   line 24px clear under the pill. */
	.home__works-heading {
		scroll-margin-block-start: calc(var(--nav-height) + var(--spacing-3xl));
		display: flex;
		align-items: center;
		gap: var(--spacing-2xl);
		color: var(--text-body);
	}

	.home__works-heading::before,
	.home__works-heading::after {
		content: '';
		flex: 1;
		block-size: 1px;
		background: var(--border);
	}

	/* Off-site work: hairlines between the rows only — the divider above
	   already closes the list off from the cards, so a rule on its outer
	   edges would just double it. The heading's 48px gap is tightened to
	   24px because a row is far lighter than a cover. */
	.earlier-list {
		margin: calc(var(--spacing-3xl) - var(--spacing-6xl)) 0 0;
		padding: 0;
		list-style: none;
	}

	.earlier-list > li + li {
		border-block-start: 1px solid var(--border);
	}

	.work-list {
		display: grid;
		gap: var(--spacing-7xl);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* The page arrives in reading order: the opening row, the bio 80ms
	   behind it, the work 80ms behind that — each rising a little on
	   --ease-out. Only the opening row fades: the bio's copy and the first
	   card's cover are the page's largest paints, and an element held at
	   opacity 0 does not count as painted until it shows. */
	@media (prefers-reduced-motion: no-preference) {
		.home > :global(*) {
			animation: home-settle 600ms var(--ease-out) backwards;
		}

		.home > :global(:nth-child(1)) {
			animation-name: home-arrive;
			animation-delay: 120ms;
		}

		.home > :global(:nth-child(2)) {
			animation-delay: 200ms;
		}

		.home > :global(:nth-child(3)) {
			animation-delay: 280ms;
		}

		.home > :global(:nth-child(4)) {
			animation-delay: 360ms;
		}
	}

	@keyframes home-arrive {
		from {
			opacity: 0;
			translate: 0 var(--spacing-md);
		}

		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	@keyframes home-settle {
		from {
			translate: 0 var(--spacing-md);
		}

		to {
			translate: 0 0;
		}
	}
</style>
