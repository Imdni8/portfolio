---
import '../styles/tokens.css';
import '../styles/components.css';
import ThemePreview from '../components/ThemePreview.astro';
import DevOutline from '../components/DevOutline.astro';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{import.meta.env.DEV && <ThemePreview />}
		{import.meta.env.DEV && <DevOutline />}
		<title>Tousif Rahaman</title>
		<meta name="description" content="Product designer. Portfolio in progress." />
	</head>
	<body>
		<main>
			<p class="type-overline">Portfolio</p>
			<h1 class="type-title">Tousif Rahaman</h1>
			<p class="type-subtitle">
				Being rebuilt on a new design system. The foundations and components live in
				Storybook.
			</p>
		</main>
	</body>
</html>

<style>
	/* Deliberately minimal. This page exists so the site still builds while the
	   pages are rewritten — it is a placeholder, not a layout to extend. */
	body {
		margin: 0;
		background: var(--bg);
		color: var(--text-body);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
	}

	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: var(--spacing-9xl) var(--spacing-4xl);
		display: grid;
		gap: var(--spacing-lg);
	}

	h1 {
		color: var(--text);
	}

	p {
		margin: 0;
	}
</style>
