---
import { getCollection, render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

export async function getStaticPaths() {
	// `coming-soon` and `external` entries have no body to render — they only
	// exist for the homepage card, not a page of their own.
	const studies = await getCollection(
		'work',
		({ data }) => data.status !== 'coming-soon' && data.status !== 'external',
	);
	return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, facts, hero, heroShot, actions } = entry.data;
// The schema's refine guarantees `subtitle` whenever status isn't
// `coming-soon` — which getStaticPaths above has already filtered to.
const subtitle = entry.data.subtitle!;
---

<CaseStudyLayout title={title} subtitle={subtitle} thumbnail={entry.data.thumbnail} facts={facts} hero={hero} heroShot={heroShot} actions={actions}>
	<Content />
</CaseStudyLayout>
